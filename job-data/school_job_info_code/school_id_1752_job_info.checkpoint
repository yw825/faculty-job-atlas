    "https://jobs.unige.ch/www/wd_portal.view_blob?p_web_site_id=1&p_web_page_id=75070&p_type=JOBDOC&p_id=13650": {
      "error": "RuntimeError: FETCH_FAILURE: Page.goto: Download is starting\nCall log:\n  - navigating to \"https://jobs.unige.ch/www/wd_portal.view_blob?p_web_site_id=1&p_web_page_id=75070&p_type=JOBDOC&p_id=13650\", waiting until \"domcontentloaded\"\n"
