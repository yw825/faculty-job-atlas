; behavioral social science", "deadline_of_application": "", "posted_date": "", "position_start_date": ""}, "https://apply.interfolio.com/125593": {"school_id": 970, "posting_url": "https://apply.interfolio.com/125593", "job_title_in_post": "Path 2: Postdoctoral Associate \u2013 Data Analytics (Economics)", "position_type": "Research_Fellow", "job_term": "Full-time", "department_or_school": "", "area_key_words": "social science", "deadline_of_application": "", "posted_date": "", "position_start_date": ""}, "https://apply.interfolio.com/134837": {"school_id": 970, "posting_url": "https://apply.interfolio.com/134837", "job_title_in_post": "Path 1 Kawader: Research Assistant \u2013 Laboratory for Advanced Neuroengineering and Translational Medicine", "position_type": "Research_Fellow", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://apply.interfolio.com/134838": {"school_id": 970, "posting_url": "https://apply.interfolio.com/134838", "job_title_in_post": "Path 2: Postdoctoral Associate \u2013 Laboratory for Advanced Neuroengineering and Translational Medicine", "position_type": "Research_Fellow", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "posted_date": "", "position_start_date": ""}, "https://apply.interfolio.com/140742": {"school_id": 970, "posting_url": "https://apply.interfolio.com/140742", "job_title_in_post": "Path 2: Postdoctoral Associate - Center for Genomics and Systems Biology (CGSB)", "position_type": "Research_Fellow", "job_term": "Full-time", "department_or_school": "Center for Genomics and Systems Biology", "area_key_words": "", "deadline_of_application": "", "posted_date": "", "position_start_date": ""}, "https://apply.interfolio.com/148431": {"school_id": 970, "posting_url": "https://apply.interfolio.com/148431", "job_title_in_post": "Path 1 Kawader: Research Assistant in the Computational Solid M