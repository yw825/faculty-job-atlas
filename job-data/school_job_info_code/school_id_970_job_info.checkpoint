", "department_or_school": "Department of Technology, Operations and Statistics", "area_key_words": "Technology, Operations, and Statistics", "deadline_of_application": "Nov 15, 2026", "posted_date": "Oct 08, 2026", "position_start_date": ""}, "https://apply.interfolio.com/195810": {"school_id": 970, "posting_url": "https://apply.interfolio.com/195810", "job_title_in_post": "2027 - 2028 Assistant Professor in Accounting (tenure-track, full-time)", "position_type": "Assistant_Professor", "job_term": "Full-time", "department_or_school": "Department of Accounting", "area_key_words": "", "deadline_of_application": "November 16, 2026", "posted_date": "", "position_start_date": ""}, "https://apply.interfolio.com/194889": {"school_id": 970, "posting_url": "https://apply.interfolio.com/194889", "job_title_in_post": "Senior Research Scientist (Prof Haidt)", "position_type": "Full_Professor", "job_term": "Full-time", "department_or_school": "", "area_key_words": "technology-use questions; youth mental health", "deadline_of_application": "", "posted_date": "", "position_start_date": ""}, "https://apply.interfolio.com/194632": {"school_id": 970, "posting_url": "https://apply.interfolio.com/194632", "job_title_in_post": "Open Rank Adjunct Professors of Management Communication (2027-2028)", "position_type": "Lecturer", "job_term": "Part-time", "department_or_school": "", "area_key_words": "Management Communication", "deadline_of_application": "October 30, 2026", "posted_date": "", "position_start_date": ""}, "https://apply.interfolio.com/58102": {"school_id": 970, "posting_url": "https://apply.interfolio.com/58102", "job_title_in_post": "Path 1 Kawader: Research Assistant - VLSI Design-For-Trust Researcher", "position_type": "Research_Fellow", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "posted_date": "", "position_start_date": ""}, "https://apply.interfolio.com/61190": {"school_id": 970, "posting_url": "https://apply