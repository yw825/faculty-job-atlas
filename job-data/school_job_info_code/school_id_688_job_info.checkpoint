r; Associate_Professor", "job_term": "Full-time", "department_or_school": "", "area_key_words": "Teacher Development- Elementary Education", "deadline_of_application": "", "position_start_date": "2026-09-21"}, "https://minnstate.wd115.myworkdayjobs.com/Minnesota_State_Careers/job/St-Cloud/Instructor-Assistant-Associate-Professor--Speech-Language--and-Hearing-Sciences--Fixed-Term---State-University-Faculty_JR0000005798": {"school_id": 688, "posting_url": "https://minnstate.wd115.myworkdayjobs.com/Minnesota_State_Careers/job/St-Cloud/Instructor-Assistant-Associate-Professor--Speech-Language--and-Hearing-Sciences--Fixed-Term---State-University-Faculty_JR0000005798", "job_title_in_post": "Instructor/Assistant/Associate Professor, Speech Language, and Hearing Sciences, Fixed Term - State University Faculty", "position_type": "Assistant_Professor; Associate_Professor", "job_term": "Full-time", "department_or_school": "College of Education, Health, and Human Sciences", "area_key_words": "State University Faculty; university committees; participating; Communication Sciences", "deadline_of_application": "", "position_start_date": "2026-09-21"}}, "school_id": 688, "status": "complete", "updated_at": "2026-10-16T18:46:08+00:00", "completed_at": "2026-10-16T18:46:08+00:00", "last_error": ""}