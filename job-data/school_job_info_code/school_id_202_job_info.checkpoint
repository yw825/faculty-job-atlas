    "https://american.wd1.myworkdayjobs.com/AU/job/Main-Campus-Washington-DC/Adjunct-Faculty---CAS-Department-of-Chemistry--Open-Continuous-_R1087": {
      "title": "Adjunct Faculty - CAS Department of Chemistry (Open Continuous)",
