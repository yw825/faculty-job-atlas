r", "job_term": "Full-time", "department_or_school": "Department of Health Professions", "area_key_words": "Radiation Therapy", "deadline_of_application": "November 2, 2026", "posted_date": "2026-09-24", "position_start_date": "1/7/2027"}, "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/La-Crosse-WI/Instructor-Pool--MICROBIOLOGY_JR10007194": {"school_id": 1541, "posting_url": "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/La-Crosse-WI/Instructor-Pool--MICROBIOLOGY_JR10007194", "job_title_in_post": "Instructor Pool- MICROBIOLOGY", "position_type": "Lecturer", "job_term": "Part-time", "department_or_school": "College of Science & Health", "area_key_words": "", "deadline_of_application": "", "posted_date": "2026-09-23", "position_start_date": ""}, "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/La-Crosse-WI/Special-Collections-Librarian--Assistant-Professor----Murphy-Library_JR10015116": {"school_id": 1541, "posting_url": "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/La-Crosse-WI/Special-Collections-Librarian--Assistant-Professor----Murphy-Library_JR10015116", "job_title_in_post": "Special Collections Librarian (Assistant Professor) - Murphy Library", "position_type": "Assistant_Professor", "job_term": "Full-time", "department_or_school": "", "area_key_words": "Murphy Library", "deadline_of_application": "October 22, 2026", "posted_date": "2026-09-22", "position_start_date": "1/7/2027"}, "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/La-Crosse-WI/Assistant-Professor---Public-Health---Community-Health-Education_JR10015061": {"school_id": 1541, "posting_url": "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/La-Crosse-WI/Assistant-Professor---Public-Health---Community-Health-Education_JR10015061", "job_title_in_post": "Assistant Professor - Public Health & Community Health Education", "position_type": "Assistant_Professor", "job_term": "Full-time", "department_or_school": "Departm