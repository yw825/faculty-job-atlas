    "https://mcgill.wd3.myworkdayjobs.com/mcgill_careers/job/Purvis-Hall/CHAIR-OF-THE-MCGILL-UNIVERSITY-DEPARTMENT-OF-EPIDEMIOLOGY--BIOSTATISTICS--AND-OCCUPATIONAL-HEALTH_JR0000081540": {
