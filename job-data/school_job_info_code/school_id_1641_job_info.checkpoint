    "https://mcgill.wd3.myworkdayjobs.com/mcgill_careers/job/McIntyre--Medical/Teaching-Assistant----PHGY-213---Introductory-Physiology-Lab-2---Winter-2027_JR0000081548": {
      "title": "Teaching Assistant -  PHGY 213 - Introductory Physiology Lab 2 - Winter 2027",
