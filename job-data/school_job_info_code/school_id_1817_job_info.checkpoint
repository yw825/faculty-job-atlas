    "https://fa-ercy-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/18655": {
      "title": "Senior Administrative Officer, Student and Resource Management",
      "description": "The Senior Administrative Officer, Student and Resource Management, provides high-level administrative, coordination and data support to the College of Sport, Health and Engineering. The role is responsible for coordinating unit offerings, course sequencing, timetabling and sessional staffing processes, while analysing enrolment data to support informed decision-making and effective resource allocation. Working closely with academic and professional stakeholders, the position proactively identifies scheduling and resource issues, maintains accurate records and contributes to continuous improvement of SRM processes.",
      "department": null
    }
