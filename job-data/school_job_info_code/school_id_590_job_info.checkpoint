cy\": {\"url\": \"https://policies.jhu.edu/d/ggfwjulX\"}}, \"login\": {\"nextUrl\": \"/careerhub\", \"components\": [{\"type\": \"provider\", \"name\": \"google\", \"clientId\": \"529264284313-85h1uo2srlrrs0qgbqjngnkb8hriogmf.apps.googleusercontent.com\"}, {\"type\": \"email\", \"name\": \"email_login\"}], \"navOptions\": [{\"dropdownOptions\": [], \"label\": \"Sign Up\", \"link\": \"/candidate/register\"}], \"formContainer\": {\"title\": \"Sign in\", \"titleOnTrackApplicationStatus\": \"Sign in\", \"background\": {\"type\": \"color\", \"value\": \"#ffffff\"}}, \"systemMessaging\": {\"message\": \"<p><b>Already a JHU employee?</b></p><p>If so, log into <a href=\\\"https://jhu.eightfold.ai/careerhub\\\"</a><u><b>myCareer</b></u></a> to search opportunities and submit applications.</p>\", \"type\": \"warning\", \"enableReadMore\": false}, \"mediaContainer\": {\"background\": {\"type\": \"image\", \"value\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1759755355::aerial\"}}, \"componentsOrdering\": [\"system_messaging\", \"google\", \"linkedin\", \"facebook\"], \"componentsConfig\": {\"systemMessaging\": {\"type\": \"system_messaging\", \"name\": \"system_messaging\"}, \"google\": {\"type\": \"provider\", \"name\": \"google\", \"clientId\": \"529264284313-85h1uo2srlrrs0qgbqjngnkb8hriogmf.apps.googleusercontent.com\"}, \"emailLogin\": {\"type\": \"email\", \"name\": \"email_login\"}}, \"showEmailUnverifiedPage\": true, \"emailUnverifiedTexts\": {\"emailUnverifiedHeaderText\": \"Please take a moment to verify your account\", \"emailUnverifiedSubHeaderText\": \"We had sent you an account verification email to: \", \"showEmail\": true, \"emailUnverifiedbottomHeaderText\": \"Just click the link in the email to complete your sign in. If you don\\u2019t see it, check your spam folder and mark it as safe for future notifications.\"}, \"logo\": {\"imageUrl\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1759437638::JHU.logo_horizontal.blue.png\", \"nextUrl\": \"https://hiring.jhu.edu/careers\"}, \"privacy\": {\"url\": \"https://policies.jhu.edu/d/ggfwjulX\"}}, \"register\": {\"nextUrl\": \"/careerhub\", \"termsAndConditions\": {\"checkboxEnabled\": true, \"customHtml\": \"<p>By clicking the above checkbox and the \\u201cSign Up\\u201d button, you understand that the information you provide may be transferred to the United States and may also be transferred to additional countries, other than your country of residence, for consideration for employment.  In order to use this service via web or mobile application, you understand and consent to your Personal Information being processed in accordance with Acme Privacy Policy and <a href='https://eightfold.ai/privacy-policy/' target='_blank' style='color:blue;text-decoration:underline'>Eightfold Privacy Policy</a> where applicable (referred collectively as \\u201cNotice\\u201d). To the extent your consent is necessary, you also consent to the collection, use and disclosure of such personal information (including any sensitive personal information you choose to provide) in connection with your account as described in the Notice. You may exercise your individual rights at any time as detailed in the Notice. You also acknowledge that your use of the services will be subject to Terms and Conditions set by your employer.</p>\", \"confirmationText\": \"I have read, understood and to the extent requested, consent with the Career Site Privacy Notice\"}, \"components\": [{\"type\": \"email\", \"name\": \"email_signup\"}, {\"type\": \"provider\", \"name\": \"google\", \"clientId\": \"529264284313-85h1uo2srlrrs0qgbqjngnkb8hriogmf.apps.googleusercontent.com\"}, {\"type\": \"terms\", \"name\": \"terms_and_conditions\"}], \"navOptions\": [{\"dropdownOptions\": [], \"label\": \"Sign In\", \"link\": \"/candidate/login\"}], \"formContainer\": {\"title\": \"Sign Up\", \"titleOnTrackApplicationStatus\": \"Sign Up\", \"background\": {\"type\": \"color\", \"value\": \"#ffffff\"}}, \"mediaContai