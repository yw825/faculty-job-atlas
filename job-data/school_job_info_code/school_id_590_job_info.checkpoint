hu.edu\", \"height\": \"40px\", \"company_name\": \"Johns Hopkins University\", \"company_logo_url\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1750785343::JHU.logo_horizontal.white.png\"}], \"nav_right_items\": [{\"type\": \"CANDIDATE_NOTIFICATION_CENTER\", \"id\": \"candidate_notification_center\"}, {\"type\": \"CANDIDATE_ACCOUNT\", \"id\": \"candidate_account\", \"items\": [{\"type\": \"NAVLINK\", \"id\": \"candidate_settings\", \"primary_text\": \"Settings\", \"url\": \"/careers/settings\"}], \"user_image_url\": null, \"user_name\": \"Import jhu.edu\", \"user_email\": \"import@jhu.edu\", \"is_user_logged_in\": \"is_candidate_logged_in\", \"logged_in_candidate_info\": {\"is_logged_in\": false}}, {\"type\": \"NAVLINK\", \"primary_text\": \"Current Employee\", \"id\": \"current employee\", \"url\": \"/careerhub/explore/jobs\", \"external_link\": true, \"target\": \"_blank\"}]}, \"customHtmlNavbarData\": {\"enable\": false, \"html\": \"\", \"css\": \"\", \"stylesheets\": [], \"scripts\": [], \"inject_in_html_template\": false}}, \"isUiRefreshGateEnabled\": 1, \"isEmailWizardV2Enabled\": 1, \"isNavbarImproveSearchResultsEnabled\": 1, \"isTaBulkActionsUseIngestFrameworkGateEnabled\": true, \"isTaPipelineUxRefreshGateEnabled\": 1, \"product\": \"PCS\", \"instanceBannerData\": {\"display_banner\": false, \"display_text\": \"\"}, \"isEnabledForImpersonationWarning\": false, \"delegationBorderColor\": null, \"isEnabledForSuggestedLogins\": false, \"forceRenderNewNavbar\": false, \"aiiStandaloneEnabled\": false} {\"domain\": \"jhu.edu\", \"configs\": {\"pcsxConfig\": {\"enabled\": true, \"searchConfig\": {\"basePositionFq\": \"position.type:ats AND is_externally_posted:1 AND has_job_description:1\", \"smartFilters\": [\"include_remote\", \"distance\", \"work_location_option\", \"seniority\"], \"allFilters\": [\"hiring_title\", \"employment_type\", \"department\", \"personnel_area\", \"personnel_subarea\", \"work_modality\", \"skills\"], \"locationRadiusDistanceDefault\": 160, \"locationSearch\": {\"autoFillLocationConfig\": {\"enabled\": false, \"locationSpecificity\": \"country\"}}, \"includeRemoteDefault\": true, \"includeRelocationAllowedDefault\": false, \"enableMocTranslations\": true, \"currentLocation\": \"\", \"mapConfig\": {\"enabled\": true, \"facetLimit\": 100, \"isMapOpenByDefault\": false, \"markers\": {\"defaultMarker\": {\"color\": \"#B5548E\"}, \"selectedMarker\": {\"color\": \"#B5548E\"}}, \"disableInMobile\": false}, \"savedSearchConfig\": {\"limit\": 5}, \"locationSuggestDict\": \"position_profile_locations\", \"excludePrivatePositions\": true, \"requirePublishedForPrivate\": false, \"sortOptionsConfig\": {\"hideCompanyPrioritySort\": false, \"hideProfileMatchSort\": false}, \"searchFields\": {\"useAtsLocationSource\": false, \"departmentField\": \"job_function\"}, \"strongMatchThreshold\": 4, \"fallbackSiteFq\": \"has_job_description: 1\", \"membershipFq\": \"\", \"searchBoxConfig\": {\"presetOptions\": []}, \"locationEnableGeocodeNormalization\": true}, \"positionDetailsConfig\": {\"tabsDisplayConfig\": [{\"id\": \"jd\", \"sections\": [\"position_fields\", \"jd\", \"position_custom_content\"], \"label\": \"Job description\", \"showInsightsWidget\": false}, {\"id\": \"company\", \"sections\": [\"perks\", \"blogs\", \"videos\"], \"label\": \"Working at JHU \", \"showInsightsWidget\": false}], \"sectionsConfig\": {\"perks\": {\"items\": [{\"title\": \"Health, Life & Well-being\", \"description\": \"We offer various coverage options to support and protect you and your family\\u2019s health and life, along with resources to support physical, mental & emotional, social, and financial well-being.\", \"image\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1758893174::2color_Health.and.Wellbeing-stethoscope.png\", \"imageAlt\": \"health\", \"icon\": \"mdiCardsHeartOutline\", \"isFavicon\": false}, {\"title\": \"Tuition Assistance\", \"description\": \"We provide employees educational opportunities for themselves, their dependent children and spouses and domestic partners to earn degrees and expand their education.\", \"image\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1758893217::2color_Education-gradcap.png\", \"imageAlt\": \"education\", \"icon\": \"mdiLaptop\", \"isFavicon\": false}, {\"title\": \"Career Development\", \"description\": \"We are committed to supporting multiple pathways to professional and personal advancement through ways people can design their work and life and develop their skills with our learning resources.\", \"image\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1758893259::2color_Education-lecture.png\", \"imageAlt\": \"lecture\", \"icon\": \"mdiStar\", \"isFavicon\": false}, {\"title\": \"Worklife Support\", \"description\": \"We recognize everyone needs various support at different stages of their life and our programs support education, home buying, caregiving, retirement, and more.\", \"image\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1758893293::2color_Business-calendar.png\", \"imageAlt\": \"calendar\", \"icon\": \"mdiGlobeModel\", \"isFavicon\": false}]}, \"blogs\": {\"items\": [\"https://hub.jhu.edu/at-work/the-individuals-who-fuel-hopkins/\", \"https://www.jhu.edu/about/history/\", \"https://www.jhu.edu/schools/\", \"https://hub.jhu.edu/\"]}, \"videos\": {\"items\": [\"https://www.youtube.com/embed/KSQF-G32F8g?si=EQKKBezO3jERzoL9\", \"https://www.youtube.com/embed/Szdf6bJZqys?si=WJV4mQYtDaJ2PVlb\", \"https://www.youtube.com/embed/oW1ZzbOEwco?si=6t63NKF80_-PgnUC\"]}, \"positionFields\": {\"fields\": [{\"fieldName\": \"locations\", \"label\": \"Affiliated Office Address\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"display_job_id\", \"label\": \"Requisition ID\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"efcustom_text_creation_ts\", \"label\": \"Date Created\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"department\", \"label\": \"Job Family\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"efcustom_text_job_subfamily\", \"label\": \"Job Subfamily\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"efcustom_text_jhu_job_function\", \"label\": \"Job Function\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"efcustom_text_pcs_flsa_status\", \"label\": \"Exempt Status\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"efcustom_text_position_employment_type\", \"label\": \"Shift Type\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"efcustom_text_employment_type_non_sap\", \"label\": \"Shift Type\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"efcustom_text_position_work_hours\", \"label\": \"Schedule\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"efcustom_text_worksite\", \"label\": \"Worksite\", \"type\": \"text\", \"format\": null}, {\"fieldName\": \"efcustom_text_work_modality_v2\", \"label\": \"Work Modality\", \"type\": \"text\", \"format\": null}], \"fieldsToDisplay\": null}, \"positionInsightsConfig\": {\"enabled\": true, \"insightsFields\": [\"company\", \"experience_years\", \"titles\"], \"insightsFq\": \"({job_title} OR {hired_similar_jobs})\", \"sourceInsightsFromGroupId\": null}, \"pymwwConfig\": {\"isEnabled\": false, \"fq\": \"\"}, \"positionCustomContent\": {\"items\": [{\"body\": \"<hr style=\\\"width:50%;text-align:center\\\">\\n<div style=\\\"font-size:18px;\\\"><span class=\\\"fontcolorb6a533a1\\\"><p><strong><em>Total Rewards</em></strong><br>\\nThe referenced base salary range represents the low and high end of Johns Hopkins University\\u2019s salary range for this position. Not all candidates will be eligible for the upper end of the salary range. Exact salary will ultimately depend on multiple factors, which may include the successful candidate's geographic location, skills, work experience, market conditions, education/training and other qualifications. Johns Hopkins offers a total rewards package that supports our employees' health, life, career and retirement. More information can be found here: <a href=\\\"https://hr.jhu.edu/benefits-worklife/\\\" target=\\\"_blank\\\" title=\\\"https://hr.jhu.edu/benefits-worklife/\\\">https://hr.jhu.edu/benefits-worklife/</a>.</p>\\n\\n<p><strong><em>Education and Experience Equivalency</em></strong><br>\\nPlease refer to the job description above to see which forms of equivalency are permitted for this position. If permitted, equivalencies will follow these guidelines: JHU Equivalency Formula: 30 undergraduate degree credits (semester hours) or 18 graduate degree credits may substitute for one year of experience. Additional related experience may substitute for required education on the same basis. For jobs where equivalency is permitted, up to two years of non-related college course work may be applied towards the total minimum education/experience required for the respective job.</p>\\n\\n<p><strong><em>Applicants Completing Studies</em></strong><br>\\nApplicants who do not meet the posted requirements but are completing their final academic semester/quarter will be considered eligible for employment and may be asked to provide additional information confirming their academic completion date.</p>\\n\\n<p><strong><em>Background Checks</em></strong><br>\\nThe successful candidate(s) for this position will be subject to a pre-employment background check. Johns Hopkins is committed to hiring individuals with a justice-involved background, consistent with applicable policies and current practice. A prior criminal history does not automatically preclude candidates from employment at Johns Hopkins University. In accordance with applicable law, the university will review, on an individual basis, the date of a candidate's conviction, the nature of the conviction and how the conviction relates to an essential job-related qualification or function.</p>\\n\\n<p><strong><em>Diversity and Inclusion</em></strong><br>\\nThe Johns Hopkins University values diversity, equity and inclusion and advances these through our key strategic framework, the <a href=\\\"https://diversity.jhu.edu/roadmap-on-diversity-and-inclusion/\\\" target=\\\"_blank\\\" title=\\\"JHU Roadmap on Diversity and Inclusion\\\">JHU Roadmap on Diversity and Inclusion</a>.</p>\\n\\n<p><strong><em>Equal Opportunity Employer</em></strong><br>\\nAll qualified applicants will receive consideration for employment without regard to race, color, religion, sex, sexual orientation, gender identity, national origin, disability, or status as a protected veteran.</p>\\n\\n<p><strong><em>EEO is the Law</em></strong><br>\\n<a href=\\\"https://www.eeoc.gov/sites/default/files/2023-06/22-088_EEOC_KnowYourRights6.12ScreenRdr.pdf\\\" target=\\\"_blank\\\" title=\\\"EEOC poster\\\">https://www.eeoc.gov/sites/default/files/2023-06/22-088_EEOC_KnowYourRights6.12ScreenRdr.pdf</a></p>\\n\\n<p><strong><em>Accommodation Information</em></strong><br>\\nIf you are interested in applying for employment with The Johns Hopkins University and require special assistance or accommodation during any part of the pre-employment process, please contact the Talent Acquisition Office at <a href=\\\"mailto: jhurecruitment@jhu.edu\\\" target=\\\"_blank\\\" title=\\\"jhurecruitment@jhu.edu\\\">jhurecruitment@jhu.edu</a>. For TTY users, call via Maryland Relay or dial 711. For more information about workplace accommodations or accessibility at Johns Hopkins University, please visit: <a href=\\\"https://accessibility.jhu.edu/\\\" target=\\\"_blank\\\" title=\\\"https://accessibility.jhu.edu/\\\">https://accessibility.jhu.edu/</a>.</p>\\n\\n<p><strong><em>Vaccine Requirements</em></strong><br>\\nJohns Hopkins University requires all faculty, staff, and students to receive the <a href=\\\"https://covidinfo.jhu.edu/health-safety/flu-vaccine-policy/\\\" target=\\\"_blank\\\" title=\\\"link to flu vaccine policy\\\">seasonal flu vaccine</a>. Exceptions to the flu vaccine requirements may be provided to individuals for religious beliefs or medical reasons. Requests for an exception must be submitted to the JHU vaccination registry.</p>\\n\\n<p><strong><em>The following additional provisions may apply, depending upon campus. Your recruiter will advise accordingly.</em></strong><br>\\nThe pre-employment physical for positions in clinical areas, laboratories, working with research subjects, or involving community contact requires documentation of immune status against Rubella (German measles), Rubeola (Measles), Mumps, Varicella (chickenpox), Hepatitis B and documentation of having received the Tdap (Tetanus, diphtheria, pertussis) vaccination. This may include documentation of having two (2) MMR vaccines; two (2) Varicella vaccines; or antibody status to these diseases from laboratory testing. Blood tests for immunities to these diseases are ordinarily included in the pre-employment physical exam except for those employees who provide results of blood tests or immunization documentation from their own health care providers. Any vaccinations required for these diseases will be given at no cost in our Occupational Health office.</p>\\n</span>\\n</div>\", \"title\": \" \"}]}, \"matchDetailsConfig\": {\"enabled\": true, \"showTopApplicantInsights\": false, \"allowMocInsights\": false, \"showRelevantExperience\": true, \"showPreviouslyWorkedAt\": true, \"showWorkCategoryOverlap\": true, \"showSchool\": true, \"showSkills\": true}, \"similarPositionConfig\": {\"showSimilarJobsOrderedByViewedPositionLocation\": false, \"similarJobLookupRadiusKm\": 20}}}, \"branding\": {\"companyName\": \"Johns Hopkins University\", \"companyLogo\": null, \"privacyHtml\": \"<div><p>When you upload your resume, we provide job recommendations to you.</p><p>Please confirm that you agree to the <a href=\\\"https://policies.jhu.edu/d/ggfwjulX\\\" target=\\\"_blank\\\">JHU Website Privacy Statement</a>, <a href=\\\"https://policies.jhu.edu/doc/fetch.cfm/ukMsXgOC\\\" target=\\\"_blank\\\">JHU Personally Identifiable Information Policy</a>, and <a href=\\\"https://eightfold.ai/privacy-policy/\\\" target=\\\"_blank\\\">Eightfold's Privacy Policy</a>.</p></div>\", \"privacy\": {\"defaultLoggedOutContactConsent\": null, \"defaultLoggedOutCampaignConsent\": null}, \"customPageSections\": {\"footer\": \"<style>\\n  .footerText-2w7aW, .footerLink-3GPDT, .footerImage-2UQ_1 {\\n    display: none !important;\\n  }\\n</style> <div class=\\\"jhu_footer\\\" style=\\\"font-size: 18px;margin:60px;\\\">\\n<strong>Our recruitment process:</strong> Artificial intelligence (AI) tools are used for parts of the hiring process, such as reviewing applications, analyzing resumes, or assessing responses. These tools assist our recruitment team, but do not replace human judgment. Final hiring decisions are ultimately made by humans.\\n\\n\\n</div>\", \"customNavbarConfig\": {\"enable\": false, \"html\": null, \"css\": null, \"showInLoggedinView\": false, \"stylesheets\": [], \"scripts\": [], \"injectInHtmlTemplate\": false}, \"customPcsBanner\": {\"default\": {\"enabled\": false, \"message\": null, \"alertType\": \"alert\"}, \"pageWiseSetup\": {}}}, \"favicons\": {\"favicon\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1758892423::university.shield.rgb.blue.png\"}, \"heroImageConfig\": {\"default\": {\"enable\": true, \"image\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1777570843::26-04-08+HR+Recruitment+Platform+Banner-v1.jpg\", \"text\": \"\", \"deviceConfiguration\": [{\"minWidth\": 1, \"maxWidth\": 729, \"enable\": false, \"image\": null, \"text\": null}, {\"minWidth\": 730, \"maxWidth\": 880, \"enable\": true, \"image\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1759349855::banner_togther\", \"text\": null}]}, \"pageWiseSetup\": null}, \"hideResumeUploadBar\": false}, \"seoConfig\": {\"pagesMetadata\": {\"jobs\": {\"pageTitle\": null, \"pageDescription\": \"Careers site\", \"pageImg\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1758892423::university.shield.rgb.blue.png\"}, \"careers\": {\"pageTitle\": null, \"pageDescription\": \"Careers site\", \"pageImg\": \"https://static.vscdn.net/images/careers/demo/jhu.edu/1758892423::university.shield.rgb.blue.png\"}}, \"publishToGoogle\": true, \"publishToGoogleMinIntervalDays\": 0, \"shareLinksMetadataConfig\": {}, \"googleJobPostingLogoUrl\": null}, \"sourceTrackingConfig\": {\"referrerSrcMap\": {\"linkedin\": \"LinkedIn\", \"indeed\": \"Indeed\", \"google\": \"Google\", \"facebook\": \"Facebook\", \"default\": \"Eightfold\", \"others\": \"Others\"}, \"careerDashboardSourceTrackingMode\": null, \"useFreeTextReferrer\": false, \"lowPriorityReferrerSrc\": []}, \"overrides\": [], \"dashboardConfig\": {\"tabs\": [\"applications\", \"interviews\", \"savedPositions\", \"events\"], \"nudges\": {\"precedenceOrder\": [\"profile_completion\", \"offer\"], \"hideOfferNudge\": false}, \"summary\": {\"orderOfTabs\": [\"applications\", \"interviews\", \"events\", \"savedpositions\"], \"tabsConfig\": {\"applications\": {\"displayText\": \"Applications\", \"applicationTypesForCount\": [\"submitted\", \"drafts\", \"referrals\"]}, \"interviews\": {\"displayText\": \"Interviews\"}, \"forms\": {\"displayText\": \"Requested Forms\"}, \"events\": {\"displayText\": \"Events\"}, \"savedpositions\": {\"displayText\": \"Saved Jobs\"}, \"offers\": {\"displayText\": \"Offers\"}, \"preboarding\": {\"displayText\": \"Preboarding\"}}}, \"recommendedJobs\": {\"enabled\": true}}, \"scriptConfig\": {\"renderYoutubeVideos\": true, \"bodyScripts\": [\"<script>console.log('Body Script loaded');</script>\", \"<script>new MutationObserver(() => { const el = document.evaluate('/html/body/div[14]/div/div[2]/form/fieldset/div/div[3]/div/div[1]/div/label', document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue; if (el && !document.getElementById('email-notice-text')) { const p = Object.assign(document.createElement('p'), { id: 'email-notice-text', textContent: 'Hopkins email addresses are for active Johns Hopkins employees only. Non-employees must use a personal email to apply.' }); Object.assign(p.style, { fontSize: '12px', color: '#555', marginTop: '4px', marginBottom: '4px' }); el.parentNode.insertBefore(p, el.nextSibling); } }).observe(document.body, { childList: true, subtree: true });</script>\"], \"headScripts\": [\"<meta name=\\\"google-site-verification\\\" content=\\\"86PJLZrcQ5l7z0aJ16ZR81sR2YjyDKUqTLiovnlPYGs\\\" />\", \"<script>console.log('Head Script loaded');</script>\", \"<style>.strongMatchIcon{ display: none !important; } .goodMatchIcon { display: none !important;} .card-23cLH { display: none !important;} .container-3PApr .subTitle-3QrJ2 {z-index: 1 !important; padding-bottom: 15px !important;} .resumeManagerHeaderContainer-3sEge .heading-3vsBQ::after {content: 'You may redact any information that will identify your age, date of birth, or dates of attendance at or graduation from an educational institution.  \\\\A \\\\AHAVE YOU APPLIED WITH US BEFORE? \\\\AIf you have submitted previous applications with JHU, please do not delete any documents below that you submitted with those applications. For new applications you submit, you will be given the opportunity on the application to pick which documents you would like to associate with that application.';font-family: var(--header-4-font-stack-full);line-height: 20px;display: block; white-space: pre-wrap; word-wrap: break-word;color: #000;font-size: 14px;font-weight: 400;margin-top: 8px;}</style>\"], \"pageLoadHeadScripts\": {}, \"eventsScripts\": {}}, \"fileUploadConfig\": {\"resume\": {\"allowedFileTypes\": [\".txt\", \".pdf\", \".doc\", \".docx\", \".png\", \".ppt\", \".pptx\", \".csv\", \".html\"], \"maxSizeFileBytes\": 5242880, \"fileTypesText\": \".txt, .pdf, .doc, .docx, .png, .ppt, .pptx, .csv, .html\"}, \"others\": {\"allowedFileTypes\": [\".txt\", \".pdf\", \".doc\", \".docx\", \".png\", \".ppt\", \".pptx\", \".csv\", \".html\"], \"maxSizeFileBytes\": 5242880, \"fileTypesText\": \".txt, .pdf, .doc, .docx, .png, .ppt, .pptx, .csv, .html\"}}, \"applyFormConfig\": {\"resume\": {\"enabled\": true, \"required\": true, \"optionalConditions\": \"\", \"resumeQuestionLabel\": \"<div><p style=\\\"background-color:#f7f7f7; border-radius:16px;color: #000000;\\\">Please attach your resume. You may redact any information that will identify your age, date of birth, or dates of attendance at or graduation from an educational institution. <br>Please note resumes cannot exceed 5MB.</p></div>\"}, \"questionsApplyV2\": {\"fields\": [{\"questions\": [{\"required\": false, \"type\": \"instruction\", \"label\": \"<div style=\\\"background-color:#f7f7f7; border-radius:16px;color: #000000;padding:5px\\\"><b>Have you applied before? Please review and update your documents.</b><p>If you\\u2019ve applied for a position with JHU previously, please scroll down to review any new documents already on file. Use the \\\"Upload new\\\" button to upload any new documents specific to this application. You may redact any information that will identify your age, date of birth, or dates of attendance at or graduation from an educational institution.</div>\", \"questionId\": \"q_attachments\"}, {\"required\": false, \"type\": \"file-input\", \"label\": \"Cover Letter\", \"questionId\": \"q_coverLetter\", \"maxFileSizeMb\": 5}, {\"templateApplyType\": [\"883\", \"1003\", \"882\"], \"required\": false, \"type\": \"file-input\", \"label\": \"Transcripts and Supporting Documents\", \"questionId\": \"q_custtranscriptsattach\", \"maxFileSizeMb\": 5, \"maxFiles\": 30}, {\"templateApplyType\": [\"982\"], \"required\": false, \"type\": \"file-input\", \"label\": \"Application Supporting Documents Repository\", \"questionId\": \"q_attachment2\", \"maxFileSizeMb\": 5, \"maxFiles\": 30}], \"title\": \"Supporting Documents\"}], \"questionnaire\": {}, \"questionsRenderCondition\": \"{{ true if position.ats_data.get('workflow_template_id') not in question.template_apply_type else false }}\", \"positionLocation\": {}, \"contactInformationSection\": {\"title\": \"Contact Information\", \"questions\": [{\"label\": \"First Name\", \"questionId\": \"firstname\", \"profileField\": \"firstname\", \"type\": \"text\", \"required\": true}, {\"label\": \"Middle Name\", \"questionId\": \"q_middleName\", \"profileField\": \"custom_info.efcustom_text_app_middle_name\", \"type\": \"text\", \"required\": false}, {\"label\": \"Last Name\", \"questionId\": \"lastname\", \"profileField\": \"lastname\", \"type\": \"text\", \"required\": true}, {\"label\": \"Email\", \"questionId\": \"email\", \"profileField\": \"email\", \"type\": \"text\", \"required\": true}, {\"label\": \"Phone\", \"questionId\": \"q_cellPhone_pcs\", \"profileField\": \"phone\", \"type\": \"phone\", \"required\": true}, {\"questionId\": \"q_preferred_name\", \"label\": \"Chosen First Name\", \"profileField\": \"custom_info.efcustom_text_app_preferred_first_name\", \"type\": \"text-row\", \"required\": false}, {\"questionId\": \"q_preferred_middlename\", \"label\": \"Chosen Middle Name\", \"profileField\": \"custom_info.efcustom_text_app_preferred_middle_name\", \"type\": \"text-row\", \"required\": false}, {\"questionId\": \"q_preferred_lastname\", \"label\": \"Chosen Last Name\", \"profileField\": \"custom_info.efcustom_text_app_preferred_last_name\", \"type\": \"text-row\", \"required\": false}, {\"choices\": [{\"label\": \"He/Him/His\", \"value\": \"463261\"}, {\"label\": \"She/Her/Hers\", \"value\": \"463262\"}, {\"label\": \"They/Them/Theirs\", \"value\": \"463263\"}, {\"label\": \"Per/Per/Pers\", \"value\": \"463264\"}, {\"label\": \"Ze/Hir/Hirs\", \"value\": \"463265\"}, {\"label\": \"Other\", \"value\": \"463266\"}], \"questionId\": \"q_preferred_pronouns\", \"label\": \"Pronouns\", \"profileField\": \"custom_info.efcustom_text_app_preferred_pronouns\", \"type\": \"dropdown\", \"required\": false}, {\"choices\": [{\"label\": \"I\", \"value\": \"18919\"}, {\"label\": \"II\", \"value\": \"18920\"}, {\"label\": \"III\", \"value\": \"18921\"}, {\"label\": \"IV\", \"value\": \"18922\"}, {\"label\": \"Jr.\", \"value\": \"18924\"}, {\"label\": \"Sr.\", \"value\": \"18925\"}, {\"label\": \"V\", \"value\": \"18923\"}], \"questionId\": \"q_suffix\", \"label\": \"Suffix\", \"profileField\": \"custom_info.efcustom_text_app_suffix\", \"type\": \"dropdown\", \"required\": false}]}}, \"questionsApplyV2S3Path\": null, \"recaptchaEnabled\": true, \"emailNotificationOnCandidateApply\": null, \"emailNotificationOnMultistageCandidateSecondaryApply\": null, \"disallowDuplicateActiveApplications\": false, \"maxApplicationsSpam\": 50, \"applicationLimiter\": null, \"disableLoggedOutApply\": true, \"linkOffApplyConfig\": {\"enabled\": false, \"applyRedirectUrl\": null, \"persistUrlParamsOnRedirect\": false, \"applyRedirectUrlCondition\": null, \"disableResumeUploadBeforeApply\": false}, \"draftApplicationSettings\": {\"enabled\": false}, \"prepopulateSettings\": {\"showPrepopulateCheckbox\": true, \"prepopulateCheckboxText\": \"Save my answers for future applications\", \"defaultPrepopulateCheckboxValue\": true, \"showClearForm\": true, \"doNotPrepopulateQuestionIds\": [\"q_cust_SalaryExpectation\"], \"inferEeoQuestions\": false}, \"stageBasedBehavior\": {\"stagesNotEligibleForWithdrawal\": [], \"stagesNotEligibleForEdit\": [], \"stagesEligibleForApply\": [], \"stagesNotEligibleForReapply\": [], \"withdrawApplicationEnabled\": false, \"editApplicationEnabled\": false, \"reapplyAfterWithdrawEnabled\": false, \"applicationStatusDisplayMap\": {\"Forwarded\": \"Your Information is Being Reviewed\", \"Your Application is Being Reviewed\": \"Your Information is Being Reviewed\", \"Invited to Apply\": \"Invited to Apply\", \"New Application\": \"Application Received\", \"Automatic Disqualified\": \"Thank you for applying to Johns Hopkins University\", \"Requisition Closed\": \"No longer accepting applications\", \"Hired on Other Requisition\": \"Hired on Other Requisition\", \"Withdrawn by Candidate\": \"Withdrawn by Candidate\", \"Internal Release\": \"Internal Release Needed\", \"Recruiter Review\": \"We are currently reviewing all applications.\", \"Hiring Manager Review\": \"Application Review\", \"Phone Interview\": \"Your Application is Being Reviewed\", \"In-Person Interview\": \"Your Application is Being Reviewed\", \"Offer\": \"Offer Extended\", \"Pre-Employment Activity\": \"Pre-employment Consent\", \"To Be Hired\": \"Welcome to Johns Hopkins University\", \"Job canceled\": \"Job canceled\", \"Does not meet minimum stated qualifications - Experience\": \"Does not meet minimum stated qualifications - Experience\", \"Not eligible for rehire\": \"Thank you for applying\", \"Not eligible for self initiated transfer\": \"Not eligible for self initiated transfer\", \"Applicant not considered\": \"No longer accepting applications\", \"Other applicants more qualified\": \"Thank you for applying\\u00a0\", \"Accepted external offer\": \"Accepted another offer\", \"Remaining at current position \\u2013 external\": \"Decided to remain at current job\", \"Dissatisfied with compensation/pay rate\": \"Salary/Benefits not aligned\", \"Other (Comments Needed)\": \"Candidate Withdrawn\", \"Applicant disinterested in location\": \"Applicant not interested in location\", \"Failure to pass pre-employment\": \"No longer being considered\", \"This position does not provide visa sponsorship\": \"This position does not provide visa sponsorship\", \"Did not respond to recruiter/HM inquiry (2x)\": \"Thank you for applying to Johns Hopkins University\", \"Disinterested in hours/shift\": \"Not interested in required hours\", \"Poor Interview Experience\": \" \", \"Offer Rescinded\": \"No longer being considered\", \"Falsification of application information\": \"No longer being considered\", \"No longer interested\": \"Candidate Withdrawn\", \"TransferredToSAP\": \" \", \"TransferredToSAPError\": \" \", \"HiredAtSAP\": \" Hired\", \"Offer Approval\": \"Interview Stage\", \"Search Committee Review\": \"Application Review\", \"Selected to Hire\": \"Interview Stage\", \"Considering more qualified candidates\": \"Thank you for applying\", \"New Applicants\": \"Your Information is Being Reviewed\", \"Interview\": \"Your Information is Being Reviewed\", \"Background Check\": \"Update your background application with required background check information.\", \"No further communication from candidate\": \"Application Withdrawn\", \"Former Staff Review\": \"Your Information is Being Reviewed\", \"Interview Completed\": \"Decision Pending\", \"Hire Information\": \"Welcome to Johns Hopkins Center for Talented Youth\", \"Not Selected - send personalized correspondence\": \"Unable to offer you a position at this time.\", \"Interview - Before offer\": \"Application Withdrawn\", \"No interview - No offer\": \"Application Withdrawn\", \"Ready for Next-Level Review\": \"Thank you for Applying\", \"Declined offer\": \"Application Withdrawn\", \"Backup candidate - ready for placement\": \"Thank you for applying.\", \"Final Disposition - Candidate invited to reapply next year\": \"Unable to offer you a position at this time. We encourage you to apply again next year.\", \"Withdrew after accepting offer\": \"Application Withdrawn\", \"Final Disposition - Candidate not selected\": \"Unable to Offer You a Position at this Time\", \"Final Disposition - Applicant not selected\\u2013 Program concluded\": \"All positions filled. We encourage you to apply again next year.\", \"Backup candidate - no positions available\": \"We are unable to offer you a position at this time. We encourage you to apply again next year.\", \"Does not meet minimum stated qualifications \\u2013 Education\": \"Does not meet minimum stated qualifications \\u2013 Education\", \"Does not meet minimum qualifications \\u2013 License/Certification\": \"Does not meet minimum qualifications \\u2013 License/Certification\", \"Remaining at current position