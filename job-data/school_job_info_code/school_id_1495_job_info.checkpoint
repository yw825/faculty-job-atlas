{"raw": {"https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/162": {"title": "Resident in Counseling", "description": "Job Title: Resident in Counseling\nDepartment: Counseling Services (Campus Life)\nReports to: Director of Counseling and Student Health\nFLSA Status: Exempt\nDirect Reports: None", "department": null}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/158": {"title": "Adjunct Faculty-Education", "description": "", "department": null}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/159": {"title": "Adjunct Faculty - Health Sciences", "description": "Adjunct Faculty-Chemistry &amp; Biochemistry\nVirginia Beach, VA, United States", "department": null}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/157": {"title": "Graduate Intern- Enrollment", "description": "Sentara College of Health Sciences of Batten University - Graduate Intern \n\nSentara College of Health Sciences of Batten University is seeking a motivated and customer-focused Graduate Intern to support enrollment and student inquiry management across our BSN, masters programs, Allied Health, and certificate programs. This role is ideal for a graduate student interested in higher education, healthcare administration, student services, and admissions support.\n\nThe Graduate Intern will play an active role in supporting prospective students through timely communication, inquiry management, and exceptional customer service while helping advance the mission of preparing future healthcare professionals.", "department": null}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/163": {"title": "Graduate Intern - Men's Lacrosse", "description": "Graduate Intern Men\u2019s Lacrosse Assistant Coach\n\nBatten University | Virginia Beach, Virginia\n\nBatten University is seeking a motivated and energetic Assistant Men\u2019s Lacrosse Coach to join our coaching staff.\n\nThis is an excellent opportunity for a coach looking to gain valuable NCAA coaching experience while pursuing a graduate degree. The position will work closely with the Head Men\u2019s Lacrosse Coach in all aspects of building and developing a competitive collegiate lacrosse program.", "department": null}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/164": {"title": "University Affairs and Presidential Events Coordinator", "description": "Job Title: University Affairs and Presidential Events Coordinator\nDepartment: Trinder Center for Advancement\nReports to: Chief of Staff/ Vice President for Strategic Initiatives\nFLSA Status: Exempt\nDirect Reports: None", "department": null}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/168": {"title": "Director of Global Engagement", "description": "Director of Global Engagement\nBatten University\n\nBatten University invites applications for the position of Director of Global Engagement. The position is a full-\ntime, 12-month staff position that reports to the Provost and Vice President. The Director of Global\nEngagement\u2019s primary responsibilities are to administer study away experience, both short and long term, and\nto support international students on campus. The director coordinates study away programs and assists faculty\nwith the development and offering of domestic and international study away courses. The Director also serves\nas the Principal Designated School Official (PDSO) and Responsible Officer (RO), administering the\nuniversity\u2019s F-1 and J-1 programs and ensuring institutional compliance with applicable federal immigration\nregulations and reporting requirements.", "department": null}}, "rows": {"https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/162": {"school_id": 1495, "posting_url": "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/162", "job_title_in_post": "Resident in Counseling", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "Counseling", "deadline_of_application": "", "position_start_date": ""}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/158": {"school_id": 1495, "posting_url": "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/158", "job_title_in_post": "Adjunct Faculty-Education", "position_type": "Unclassified", "job_term": "Part-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/159": {"school_id": 1495, "posting_url": "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/159", "job_title_in_post": "Adjunct Faculty - Health Sciences", "position_type": "Unclassified", "job_term": "Part-time", "department_or_school": "", "area_key_words": "Health Sciences", "deadline_of_application": "", "position_start_date": ""}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/157": {"school_id": 1495, "posting_url": "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/157", "job_title_in_post": "Graduate Intern- Enrollment", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "College of Health Sciences of Batten University", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/163": {"school_id": 1495, "posting_url": "https://fa-ewic-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExpe