    },
    "https://fa-eosd-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/4276": {
      "title": "Assistant Professor in Advanced Microscopy, Spectroscopy and Chemical Imaging",
      "description": "The nanotechnology centre NanoSYD at the Mads Clausen Institute, University of Southern Denmark (SDU), invites applications for a 3-year Assistant Professor position in Advanced Microscopy, Spectroscopy and Chemical Imaging.\nThe position starts on January 1, 2027, and will terminate at the end of the appointment period unless otherwise agreed.\nThe application deadline is 15. October 2026 at 11:59 PM/23:59 (CET/CEST)  ",
      "department": null
    },
