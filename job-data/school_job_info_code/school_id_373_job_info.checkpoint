    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/1993": {
      "title": "Assistant Director, Recruitment (Hybrid)",
      "description": "The Assistant Director is a critical member of the Recruiting and Admission team in the Kellstadt Graduate School of Business. Reporting to the Assoc Director of Recruiting and Admission and located at the Loop campus, the Assistant Director has the primary responsibility for managing the admission funnel. Specifically, the Assistant Director manages the process and activities that support driving prospects from inquiry to admission. Based in the Loop, this territory manager will travel for recruitment and will work evenings and weekends as needed. This position will use PeopleSoft, and Slate. The Assistant Director will collaborate with other University departments that support the Kellstadt Graduate School of Business and will proactively engage with prospective students, faculty and Kellstadt colleagues.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2015": {
      "title": "Assistant Director, Career Coaching  Co-op",
      "description": "The Assistant Director of Career Coaching - Co-op delivers comprehensive career development services to business undergraduates participating in DePaul University's innovative co-op program. This hands-on role focuses on preparing students for professional success through individual coaching, skill-building workshops, and ongoing support during co-op placements. \n\nAs a member of the Career Management Center team, the Assistant Director works closely with students to develop professional competencies, navigate the co-op search process, and maximize learning from experiential education opportunities. This position is essential to establishing DePaul's reputation as a premier talent pipeline for businesses seeking to develop emerging professionals and ensuring student success in cooperative education experiences. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2017": {
      "title": "Assistant Director, Employer Partnerships Co-op",
      "description": "The Assistant Director of Employer Relations - Co-op is responsible for cultivating and managing employer partnerships that generate paid cooperative education opportunities for DePaul University business undergraduates. This hands-on, relationship-focused role involves prospecting new employers, managing a portfolio of existing partnerships, coordinating employer engagement activities, and ensuring students have access to high-quality co-op placements. ",
      "department": null
