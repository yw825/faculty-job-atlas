  "raw": {
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2032": {
      "title": "PT Tutoring Center Coordinator (On-site)",
      "description": "The Tutoring Center Coordinator provides leadership and oversight for the Driehaus College of Business Tutoring Center, ensuring that tutoring services effectively support student learning, academic success, and retention. The Coordinator manages program development, assessment, tutor training, and strategic initiatives while serving as the primary liaison between the Tutoring Center, faculty, advisors, and college leadership. Through the supervision of three Graduate Assistants, the Coordinator ensures the efficient delivery of tutoring services while focusing on program quality, continuous improvement, and long-term planning. The position also promotes collaboration across the College and supports student success by expanding access to academic support resources and fostering an inclusive, student-centered learning environment.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2023": {
      "title": "Assistant Director, Prehealth Advising",
      "description": "The assistant director of pre-health advising provides comprehensive pre-health advising to DePaul students interested in pursuing graduate health professions programs. They are one of two pre-health advisors who are part of the College of Science and Health's (CSH) Office of Advising and Student Services and split the pre-health advising caseload 50-50. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2027": {
      "title": "Residence Director (On-site)",
      "description": "The Department of Housing and Residence Life at DePaul University serves about 2,500 students residing in traditional-style and apartment-style residence halls on the Lincoln Park Campus. The Residence Director is a full-time professional position in the Department of Housing and Residence Life and within the Division of Student Affairs. The Residence Director supports living and learning environments that encourage student and community development and healthy and safe living. Residence Directors are expected to incorporate an interactive and intentional approach to student learning, empowerment, and personal growth. The Residence Director position is a maximum of three years and will be evaluated each year for satisfactory work.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2029": {
      "title": "Associate Director, Student Success & Accreditation (Hybrid)",
      "description": "Reporting to the Associate Provost for Student Success and Accreditation (AP-SSA), the ASSOCIATE DIRECTOR serves as a project manager and thought partner to the Associate Provost. In this capacity, the Associate Director develops and maintains accreditation documentation, oversees reporting timelines, and implements projects and communications related to accreditation, assessment, and student success initiatives of Academic Affairs. The Associate Director is instrumental in managing the university’s accreditation compliance by providing managerial and project management expertise to the portfolio of Student Success and Accreditation, with special attention to Academic Program Review (APR), including learning assessment outcomes, and overall accreditation support. The Associate Director also provides financial management to the APR and Student Success segments of the Associate Provost’s financial portfolio. Additionally, this position supervises one administrative team member. ",
      "department": null
    },
