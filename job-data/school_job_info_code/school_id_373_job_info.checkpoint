  "raw": {
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2032": {
      "title": "PT Tutoring Center Coordinator (On-site)",
      "description": "The Tutoring Center Coordinator provides leadership and oversight for the Driehaus College of Business Tutoring Center, ensuring that tutoring services effectively support student learning, academic success, and retention. The Coordinator manages program development, assessment, tutor training, and strategic initiatives while serving as the primary liaison between the Tutoring Center, faculty, advisors, and college leadership. Through the supervision of three Graduate Assistants, the Coordinator ensures the efficient delivery of tutoring services while focusing on program quality, continuous improvement, and long-term planning. The position also promotes collaboration across the College and supports student success by expanding access to academic support resources and fostering an inclusive, student-centered learning environment.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2023": {
      "title": "Assistant Director, Prehealth Advising",
      "description": "The assistant director of pre-health advising provides comprehensive pre-health advising to DePaul students interested in pursuing graduate health professions programs. They are one of two pre-health advisors who are part of the College of Science and Health's (CSH) Office of Advising and Student Services and split the pre-health advising caseload 50-50. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2027": {
      "title": "Residence Director (On-site)",
      "description": "The Department of Housing and Residence Life at DePaul University serves about 2,500 students residing in traditional-style and apartment-style residence halls on the Lincoln Park Campus. The Residence Director is a full-time professional position in the Department of Housing and Residence Life and within the Division of Student Affairs. The Residence Director supports living and learning environments that encourage student and community development and healthy and safe living. Residence Directors are expected to incorporate an interactive and intentional approach to student learning, empowerment, and personal growth. The Residence Director position is a maximum of three years and will be evaluated each year for satisfactory work.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2029": {
      "title": "Associate Director, Student Success & Accreditation (Hybrid)",
      "description": "Reporting to the Associate Provost for Student Success and Accreditation (AP-SSA), the ASSOCIATE DIRECTOR serves as a project manager and thought partner to the Associate Provost. In this capacity, the Associate Director develops and maintains accreditation documentation, oversees reporting timelines, and implements projects and communications related to accreditation, assessment, and student success initiatives of Academic Affairs. The Associate Director is instrumental in managing the university’s accreditation compliance by providing managerial and project management expertise to the portfolio of Student Success and Accreditation, with special attention to Academic Program Review (APR), including learning assessment outcomes, and overall accreditation support. The Associate Director also provides financial management to the APR and Student Success segments of the Associate Provost’s financial portfolio. Additionally, this position supervises one administrative team member. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2008": {
      "title": "Admissions Counselor",
      "description": "The Graduate Admissions Counselor is an entry-level position reporting to the Associate Director of Graduate Recruitment and Admissions. The Graduate Admissions Counselor has primary responsibility for admissions pipeline process and activities (driving inquiries to application) for graduate programs in the College of Education and in the College of Communication.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2025": {
      "title": "Strategic Communications Specialist (Hybrid)",
      "description": "The Strategic Communications Specialist is a member of the strategic communications team who supports reputation management, crisis response and mitigation, and media relations strategies for colleges and schools. The specialist also contributes to executive communications for the Office of the President. The specialist will help conduct research and seek opportunities to promote DePaul’s reputation to a wide range of internal and external audiences. The specialist will leverage social listening tools to track digital reputation and risks. This position requires a strategic thinker with outstanding editorial and writing skills. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2026": {
      "title": "Facility Manager",
      "description": "Reporting to the Associate Director of Facility Operations for the Loop Campus, the Facility Manager oversees the daily operations that keep campus buildings clean, safe, and comfortable. The role schedules and supervises in-house custodial staff, oversees contracted cleaning services, and uses Planon, the University's IWMS, to manage workflows, inspections, preventive maintenance, and operational reporting. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/1993": {
      "title": "Assistant Director, Recruitment (Hybrid)",
      "description": "The Assistant Director is a critical member of the Recruiting and Admission team in the Kellstadt Graduate School of Business. Reporting to the Assoc Director of Recruiting and Admission and located at the Loop campus, the Assistant Director has the primary responsibility for managing the admission funnel. Specifically, the Assistant Director manages the process and activities that support driving prospects from inquiry to admission. Based in the Loop, this territory manager will travel for recruitment and will work evenings and weekends as needed. This position will use PeopleSoft, and Slate. The Assistant Director will collaborate with other University departments that support the Kellstadt Graduate School of Business and will proactively engage with prospective students, faculty and Kellstadt colleagues.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2015": {
      "title": "Assistant Director, Career Coaching  Co-op",
      "description": "The Assistant Director of Career Coaching - Co-op delivers comprehensive career development services to business undergraduates participating in DePaul University's innovative co-op program. This hands-on role focuses on preparing students for professional success through individual coaching, skill-building workshops, and ongoing support during co-op placements. \n\nAs a member of the Career Management Center team, the Assistant Director works closely with students to develop professional competencies, navigate the co-op search process, and maximize learning from experiential education opportunities. This position is essential to establishing DePaul's reputation as a premier talent pipeline for businesses seeking to develop emerging professionals and ensuring student success in cooperative education experiences. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2017": {
      "title": "Assistant Director, Employer Partnerships Co-op",
      "description": "The Assistant Director of Employer Relations - Co-op is responsible for cultivating and managing employer partnerships that generate paid cooperative education opportunities for DePaul University business undergraduates. This hands-on, relationship-focused role involves prospecting new employers, managing a portfolio of existing partnerships, coordinating employer engagement activities, and ensuring students have access to high-quality co-op placements. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2011": {
      "title": "Sr. Chaplain, Catholic Campus Ministry",
      "description": "Reporting to the Sr. Director, Catholic Campus Ministry & Vincentian Service, the Senior Chaplain of Catholic Campus Ministry (CCM) oversees Catholic liturgical ministry and identified CCM programs and collaborations. The Senior Chaplain provides pastoral and spiritual leadership to students, faculty, and staff, maintains a regular, visible institutional pastoral presence and engagement, and primary oversight of the Catholic liturgical life at DePaul University. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2014": {
      "title": "Associate Director, Career Coaching Co-op",
      "description": "The Associate Director of Career Coaching - Co-op provides strategic leadership and operational oversight for student professional development initiatives within DePaul University's pioneering business co-op program—the only program of its kind in the Chicagoland area. This role is instrumental in building a comprehensive career coaching ecosystem that prepares business undergraduates for success in paid cooperative education experiences while providing ongoing support throughout their co-op placements.  \n\n",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2016": {
      "title": "Associate Director, Employer Partnerships Co-op",
      "description": "The Associate Director of Employer Partnership - Co-op provides strategic leadership for cultivating, managing, and expanding partnerships with employers who provide paid cooperative education opportunities for DePaul University business undergraduates. This role is critical to establishing DePaul's co-op program as the premier talent pipeline for businesses seeking to develop emerging professionals while they grow. This position offers a unique opportunity to build transformative employer partnerships from the ground up. The Associate Director leads a team of employer relations professionals, develops strategic account management systems, negotiates Memoranda of Understanding (MOUs), and drives toward ambitious placement goals. This role requires a strategic thinker with strong sales and relationship management skills, deep knowledge of the Chicagoland business community, and the ability to position DePaul as partner in employer talent development strategies.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/1895": {
      "title": "Associate Construction Project Director",
      "description": "The Associate Director of Construction supports the Director of Construction in the management and delivery of a diverse portfolio of capital projects and renovations ranging from minor interior improvements to large-scale institutional construction initiatives typically valued between $50,000 and $100 million.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2009": {
      "title": "Head of Acquisitions & Collections Strategy (Hybrid)",
      "description": "The Head of Acquisitions & Collections Strategy (ACS) provides leadership for acquisitions and collection strategy, to ensure library resources advance DePaul University’s research, teaching, and learning priorities. The Head of ACS oversees the library collection budget, acquisitions workflows, and related operations. The position develops and implements sustainable approaches to collection development, licensing, access, and resource management. The ACS collects and analyzes data to assess collection use and value, inform resource decisions, and identify emerging needs and opportunities. The role collaborates across the library and university to align collections with evolving user needs, academic priorities, and changes in the information landscape. The ACS will work in a highly-supportive and collegial culture that encourages active participation in meaningful and valuable skills training and professional development. ",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2003": {
      "title": "Assistant Director, Housing Operations (on-site)",
      "description": "The Assistant Director of Housing Operations is responsible for creating, updating, and distributing residential agreements and housing assignments for the Lincoln Park and Loop campuses while overseeing the administration of the housing management software system. The Assistant Director of Housing Operations develops and maintains internal reports, occupancy audits, and tracking systems to ensure the accuracy of housing and meal plan assignments and billing. This position also oversees the day-to-day management of residence hall front desk operations, access control processes, and graduate assistant supervision. A key responsibility of the role is maintaining the technological functionality and data integrity of the residential management system. The position supports operational efficiency and accurate occupancy management across both campuses.",
      "department": null
    },
    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/1981": {
      "title": "PT Coordinator, Curriculum Internationalization (on-site)",
      "description": "The Coordinator of Curriculum Internationalization (CCI) is responsible for fully administering the global certificates available to students at DePaul, executing the process of global learning course tagging, and for coordinating and assisting with a number of global learning programs, under the supervision of the Director of Curriculum Internalization (DCI). This position works directly with various internal (students, faculty, staff) and external stakeholders to ensure timely and accurate system records and delivery of programs, while further expanding DePaul’s global reach.",
      "department": null
    },
