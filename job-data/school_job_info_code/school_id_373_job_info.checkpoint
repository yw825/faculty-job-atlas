    "https://ekze.fa.us2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1001/job/2026": {
      "title": "Facility Manager",
      "description": "Reporting to the Associate Director of Facility Operations for the Loop Campus, the Facility Manager oversees the daily operations that keep campus buildings clean, safe, and comfortable. The role schedules and supervises in-house custodial staff, oversees contracted cleaning services, and uses Planon, the University's IWMS, to manage workflows, inspections, preventive maintenance, and operational reporting. ",
      "department": null
