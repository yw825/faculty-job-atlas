    "https://explore.msujobs.msstate.edu/jobs/assistant-associate-or-full-professor-meridian-campus-meridian-ms-mississippi-united-states-riley-campus-meridian-ms-riley-center-meridian-ms-871217c1-d986-4bb3-844a-41d478073696": {
