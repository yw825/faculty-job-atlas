      "description": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<feed xmlns=\"http://www.w3.org/2005/Atom\">\n  <id>https://warwick-careers.tal.net/vx/mobile-0/appcentre-1/brand-4/candidate/jobboard/vacancy/3/feed</id>\n  <link rel=\"self\" href=\"https://warwick-careers.tal.net/vx/mobile-0/appcentre-1/brand-4/candidate/jobboard/vacancy/3/feed\" type=\"application/atom+xml\"/>\n  <title>OPPORTUNITIES</title>\n  <author>\n    <name>University of Warwick</name>\n  </author>\n  <updated>2026-09-03T14:25:09Z</updated>\n  <link rel=\"alternate\" href=\"https://warwick-careers.tal.net/vx/mobile-0/appcentre-1/brand-4/candidate/jobboard/vacancy/3\" type=\"text/html\"/>\n  <entry xml:base=\"https://warwick-careers.tal.net/vx/mobile-0/appcentre-ext/brand-4/candidate/so/pm/1/pl/3/opp/4634-UX-Executive-109512-0826/en-GB\">\n    <id>https://warwick-careers.tal.net/vx/mobile-0/appcentre-ext/brand-4/candidate/so/pm/1/pl/3/opp/4634-UX-Executive-109512-0826/en-GB</id>\n    <link rel=\"alternate\" href=\"https://warwick-careers.tal.net/vx/mobile-0/appcentre-ext/brand-4/candidate/so/pm/1/pl/3/opp/4634-UX-Executive-109512-0826/en-GB?instant=apply\" type=\"text/html\"/>\n    <title>UX Executive ‎(109512-0826)</title>\n    <updated>2026-08-28T12:08:04Z</updated>\n    <published>2026-08-28T12:08:04Z</published>\n    <content type=\"xhtml\">\n      <div xmlns=\"http://www.w3.org/1999/xhtml\">Title:UX Executive ‎(109512-0826)<br/>\nPosition Type:Permanent<br/>\n</div>\n    </content>\n  </entry>\n  <entry xml:base=\"https://warwick-careers.tal.net/vx/mobile-0/appcentre-ext/brand-4/candidate/so/pm/1/pl/3/opp/4735-Teaching-Fellow-103423-0826/en-GB\">\n    <id>https://warwick-careers.tal.net/vx/mobile-0/appcentre-ext/brand-4/candidate/so/pm/1/pl/3/opp/4735-Teaching-Fellow-103423-0826/en-GB</id>\n    <link rel=\"alternate\" href=\"https://warwick-careers.tal.net/vx/mobile-0/appcentre-ext/brand-4/candidate/so/pm/1/pl/3/opp/4735-Teaching-Fellow-103423-0826/en-GB?instant=apply\" type=\"text/html