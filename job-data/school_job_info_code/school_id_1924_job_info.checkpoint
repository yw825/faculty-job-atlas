    "https://careers.lsuhsc.edu/jobs/assistant-professor-associate-professor-professor-clinical-new-orleans-louisiana-united-states-1825e034-2408-443f-8c9f-c3ee065c23e8": {
      "title": "ASSISTANT PROFESSOR/ ASSOCIATE PROFESSOR/ PROFESSOR - CLINICAL",
