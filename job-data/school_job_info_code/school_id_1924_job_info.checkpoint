    "https://careers.lsuhsc.edu/jobs/clinical-assistant-professor-or-clinical-associate-professor-hospital-medicine-new-orleans-louisiana-united-states": {
      "title": "CLINICAL ASSISTANT PROFESSOR OR CLINICAL ASSOCIATE PROFESSOR - HOSPITAL MEDICINE",
