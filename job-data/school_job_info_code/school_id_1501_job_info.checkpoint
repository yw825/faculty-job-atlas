  "raw": {
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/50": {
      "title": "Associate Director of Web Strategy & Experience",
      "description": "Own the web experience that turns curiosity into commitment. As a key member of our performance marketing team, the Associate Director of Web Strategy & Experience translates institutional, enrollment, and brand goals into user-centered web experiences. In this role, you’ll lead strategy, governance, information architecture, and user experience, while ensuring the operational health, technical integrity, and continual improvement of the college's enterprise CMS and its associated digital ecosystem.",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/48": {
      "title": "Social Media Coordinator",
      "description": "Do you know how to turn a campus moment into a scroll-stopping post? Champlain College is looking for a Social Media Coordinator to bring our brand to life. The Social Media Coordinator is responsible for creating engaging, visually compelling content in support of Champlain College's comprehensive social media strategy. With a strong emphasis on high-quality photography and video storytelling, this content will enhance brand awareness, drive engagement, and achieve strategic communication and enrollment goals. This role is also responsible for monitoring the College's social channels and optimizing social media platforms.",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/47": {
      "title": "Military & Veteran Services Coordinator",
      "description": "Are you passionate about helping military-connected students navigate their path to a degree? Champlain College is seeking a Military & Veteran Services Coordinator to lead the institution's support for its veteran and military-connected students, from their first inquiry as a prospective student through graduation. As the College's School Certifying Official (SCO), this position ensures that every eligible service member, veteran, and dependent receives the education benefits they've earned, while keeping the College in full compliance with federal and state requirements.",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/45": {
      "title": "Assistant Director of Admissions",
      "description": "Ready to build Champlain's presence in one of the most competitive college admissions markets in the country? Champlain College is seeking an experienced, results-oriented admissions professional to lead recruitment across two high-priority territories: Massachusetts and the West Coast. ",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/43": {
      "title": "Campus Public Safety Officer",
      "description": "Ready to be the calm, capable presence a campus community counts on? Champlain College has openings for Campus Public Safety (CPS) Officers. Join a high-integrity team providing safety and security services for the campus community. All CPS Officers embrace a team-player and customer service mentality, working collaboratively with College partners to help foster a safe environment in which to live, work, learn, and thrive.",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/44": {
      "title": "Records Systems Coordinator",
      "description": "Champlain College is seeking an organized, analytical, and detail-oriented Records Systems Coordinator to join our Registrar's Team. Reporting to the Registrar, this role ensures the accuracy, integrity, and security of student academic records while supporting the daily operations of the Registrar's Office.",
      "department": null
    },
