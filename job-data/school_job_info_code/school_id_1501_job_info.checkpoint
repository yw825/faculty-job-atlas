    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/53": {
      "title": "Senior HVAC Technician",
      "description": "Keep Champlain College's campus comfortable, safe, and running smoothly! We're seeking an experienced  HVAC Technician to join our Physical Plant team in Burlington, Vermont. In this hands-on role, you'll install, inspect, maintain, and repair the heating, ventilation, and air conditioning systems that serve our residence halls, academic buildings, and administrative spaces.",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/54": {
      "title": "Groundskeeper",
      "description": "Do you take pride in work that people see and enjoy every day? Champlain College is seeking a Groundskeeper to keep our Burlington campus beautiful, safe, and welcoming for students, faculty, staff, and visitors in every season.  The Groundskeeper cares for the College's lawns, flower beds, walkways, and parking areas, and during the winter months plays a key role in snow and ice removal so that campus stays accessible and safe.",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/52": {
      "title": "Access Services Coordinator",
      "description": "The Miller Information Commons is where Champlain students study, build, create, and get help, all under one roof. As an Access Services Coordinator, you’ll keep it running and make it feel welcoming when students need it most: evenings and weekends.\n\nChamplain College is hiring part-time Access Services Coordinators to supervise library circulation services in the Miller Information Commons — a multi-use facility that houses the library, Student Success Center, computer lab, maker space, study rooms, and classrooms. In this role, you'll oversee facility operations, manage circulation systems, lead student employees, and carry out projects that keep the library running smoothly. This position is filled by 6–8 individuals concurrently, and flexibility with scheduling is required.",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/51": {
      "title": "Assistant Director of Admissions",
      "description": "Ready to build Champlain's presence in one of the most competitive college admissions markets in the country? Champlain College is seeking an experienced, results-oriented admissions professional to lead recruitment across two high-priority territories: Massachusetts and the West Coast.",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/48": {
      "title": "Social Media Coordinator",
      "description": "Do you know how to turn a campus moment into a scroll-stopping post? Champlain College is looking for a Social Media Coordinator to bring our brand to life. The Social Media Coordinator is responsible for creating engaging, visually compelling content in support of Champlain College's comprehensive social media strategy. With a strong emphasis on high-quality photography and video storytelling, this content will enhance brand awareness, drive engagement, and achieve strategic communication and enrollment goals. This role is also responsible for monitoring the College's social channels and optimizing social media platforms.",
      "department": null
    },
    "https://champlain-ibumjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/43": {
      "title": "Campus Public Safety Officer",
      "description": "Ready to be the calm, capable presence a campus community counts on? Champlain College has openings for Campus Public Safety (CPS) Officers. Join a high-integrity team providing safety and security services for the campus community. All CPS Officers embrace a team-player and customer service mentality, working collaboratively with College partners to help foster a safe environment in which to live, work, learn, and thrive.",
