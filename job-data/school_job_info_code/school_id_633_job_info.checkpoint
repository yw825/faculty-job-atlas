\n&lt;td style=\"width: 6.27132%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 35px\"&gt;\n&lt;td style=\"width: 27.439%; height: 35px\"&gt;&lt;strong&gt;Number of Positions Available:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 35px\"&gt;3&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 35px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 20px\"&gt;&lt;strong&gt;Documents Needed to Apply:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 20px\"&gt;Resume, Class Schedule&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 20px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 18px\"&gt;\n&lt;td style=\"width: 27.439%; height: 18px\"&gt;&lt;strong&gt;Job Close Date:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 18px\"&gt;September 15, 2026&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;EEO Statement:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Ferris State University, an Affirmative Action/Equal Opportunity employer, is committed to enhancing equity, inclusion, and diversity within its community. Ferris offers employment opportunities to qualified candidates seeking careers in a student-focused environment that values opportunity, collaboration, diversity and educational excellence.&amp;nbsp; Learn more about the Ferris Mission and community at&amp;nbsp;&lt;a href=\"http://ferris.edu/\" target=\"_blank\" rel=\"noopener noreferrer\"&gt;ferris.edu&lt;/a&gt;. The University actively seeks applications from women, minorities, individuals with disabilities, veterans, and other underrepresented groups. For more information on the University’s Policy on Non-Discrimination, visit:&amp;nbsp;&lt;a href=\"https://www.ferris.edu/HTMLS/administration/president/generalcounsel/pdfs-docs/00108985.pdf\" target=\"_blank\" rel=\"noopener noreferrer\"&gt;Ferris Non-Discrimination Statement&lt;/a&gt;.&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;/tbody&gt;\n&lt;/table&gt;</job:description><job:applyLink>https://secure.dc4.pageuppeople.com/apply/1010/gateway/default.aspx?c=apply&amp;lJobID=498076&amp;lJobSourceTypeID=796&amp;sLanguage=en-us</job:applyLink><job:closingDate>Wed, 16 Sep 2026 03:55:00 GMT</job:closingDate><job:location>Big Rapids, MI 49307</job:location><job:workType>Student Employment - General</job:workType><job:category>Student Employment - General</job:category><job:subCategory></job:subCategory><job:businessLayer1>D - Admin and Finance</job:businessLayer1></item><item><guid isPermaLink=\"true\">https://jobs.ferris.edu/cw/en-us/job/498077</guid><link>https://jobs.ferris.edu/cw/en-us/job/498077</link><title>ASC Office Assistant (Student Position)</title><description>The Office Assistant position exists to support students as they enter the Tutoring Center and help create a welcoming, organized, and efficient environment. This role is located at the front desk of the Tutoring Center within the Academic Literacies Center.</description><pubDate>Fri, 07 Aug 2026 04:00:00 Z</pubDate><a10:updated>2026-08-07T04:00:00Z</a10:updated><job:category>Student Employment - General</job:category><job:refNo>498077</job:refNo><job:description>&lt;table style=\"border-collapse: collapse; width: 93.6673%; height: 453px\" border=\"1\"&gt;\n&lt;tbody&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Position Title:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;ASC Office Assistant&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Location:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Big Rapids, MI&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 46px\"&gt;\n&lt;td style=\"width: 27.439%; height: 46px\"&gt;&lt;strong&gt;Department:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"height: 46px; width: 72.561%\"&gt;\n&lt;p&gt;ASC Office Assistant&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 46px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Advertised Salary:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;$13.73-$13.99&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Summary of Position:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;The Office Assistant position exists to support students as they enter the Tutoring Center and help create a welcoming, organized, and efficient environment. This role is located at the front desk of the Tutoring Center within the Academic Literacies Center.&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Position Requirements:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Experience using Microsoft Office applications such as Word or Excel&lt;br&gt;Experience with Navigate is preferred but not required&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 18px\"&gt;\n&lt;td style=\"width: 27.439%; height: 18px\"&gt;&lt;strong&gt;Essential Duties/Responsibilities:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 18px\"&gt;\n&lt;p&gt;Position duties include &lt;br&gt;• Answering phones and updating voicemail as needed&lt;br&gt;• Responding to emails&lt;br&gt;• Scheduling appointments in Navigate&lt;br&gt;• Filing and organizing&lt;br&gt;• Updating webpages&lt;br&gt;• Preparing for events&lt;br&gt;• Maintaining supply inventory&lt;br&gt;• Assisting students who enter the ALC&lt;br&gt;• Photocopying, checking the copy machine for paper and troubleshooting other issues that may occur&lt;br&gt;• Provide support to tutors and faculty by answering questions as needed&lt;br&gt;• Assisting the secretary and direct with various duties&lt;br&gt;• Other duties, as assigned&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 35px\"&gt;\n&lt;td style=\"width: 27.439%; height: 35px\"&gt;&lt;strong&gt;Number of Positions Available:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 35px\"&gt;1&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 35px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Documents Needed to Apply:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Resume, Class Schedule, Cover Letter (optional)&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 18px\"&gt;\n&lt;td style=\"width: 27.439%; height: 18px\"&gt;&lt;strong&gt;Job Close Date:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 18px\"&gt;December 18, 2026&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;EEO Statement:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Ferris State University, an Affirmative Action/Equal Opportunity employer, is committed to enhancing equity, inclusion, and diversity within its community. Ferris offers employment opportunities to qualified candidates seeking careers in a student-focused environment that values opportunity, collaboration, diversity and educational excellence.&amp;nbsp; Learn more about the Ferris Mission and community at&amp;nbsp;&lt;a href=\"http://ferris.edu/\" target=\"_blank\" rel=\"noopener noreferrer\"&gt;ferris.edu&lt;/a&gt;. The University actively seeks applications from women, minorities, individuals with disabilities, veterans, and other underrepresented groups. For more information on the University’s Policy on Non-Discrimination, visit:&amp;nbsp;&lt;a href=\"https://www.ferris.edu/HTMLS/administration/president/generalcounsel/pdfs-docs/00108985.pdf\" target=\"_blank\" rel=\"noopener noreferrer\"&gt;Ferris Non-Discrimination Statement&lt;/a&gt;.&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;/tbody&gt;\n&lt;/table&gt;</job:description><job:applyLink>https://secure.dc4.pageuppeople.com/apply/1010/gateway/default.aspx?c=apply&amp;lJobID=498077&amp;lJobSourceTypeID=796&amp;sLanguage=en-us</job:applyLink><job:closingDate>Sat, 19 Dec 2026 04:55:00 GMT</job:closingDate><job:location>Big Rapids, MI 49307</job:location><job:workType>Student Employment - General</job:workType><job:category>Student Employment - General</job:category><job:subCategory></job:subCategory><job:businessLayer1>C - VPAA</job:businessLayer1></item><item><guid isPermaLink=\"true\">https://jobs.ferris.edu/cw/en-us/job/498078</guid><link>https://jobs.ferris.edu/cw/en-us/job/498078</link><title>Supervisor of Communications</title><description>Oversees external and internal communications, strategically aligning media relations to tell the stories of Ferris State University students, employees, and programs.  Oversees the team creating stories using written, photo, and video resources to be distributed to media, posted on the website, and shared on social media. The selected candidate for this position must be authorized to work in the United States at the time of hire without employer assistance or sponsorship now or in the future. The university will not assist with any F-1 EADs, OPT, H1B, etc.</description><pubDate>Fri, 07 Aug 2026 04:00:00 Z</pubDate><a10:updated>2026-08-07T04:00:00Z</a10:updated><job:category>Administrative,Staff</job:category><job:refNo>498078</job:refNo><job:description>&lt;table style=\"border-collapse: collapse; width: 93.6673%; height: 574px\" border=\"1\"&gt;\n&lt;tbody&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Position Title:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Supervisor of Communications&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Location:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Big Rapids (Main Campus)&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 46px\"&gt;\n&lt;td style=\"width: 27.439%; height: 46px\"&gt;&lt;strong&gt;Department:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"height: 46px\"&gt;\n&lt;p&gt;70600 - Publications&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 46px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 18px\"&gt;&lt;strong&gt;Advertised Salary:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 18px\"&gt;$89,471&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 18px\"&gt;\n&lt;td style=\"width: 27.439%; height: 18px\"&gt;&lt;strong&gt;Benefits:&lt;br&gt;&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 18px\"&gt;\n&lt;p&gt;Comprehensive benefit package (health care, vacation, etc.). Please see the following link for a list of benefits offered with this position.&lt;/p&gt;\n&lt;p&gt;&lt;a href=\"https://www.ferris.edu/administration/adminandfinance/human/Benefits/admin.htm\"&gt;Admin / Admin Temp Benefit Plans&lt;/a&gt;&lt;/p&gt;\n&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 18px\"&gt;&lt;strong&gt;FLSA:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 18px\"&gt;Exempt&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Temporary/Continuing:&amp;nbsp;&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Continuing&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Part-Time/Full-Time:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Full-Time&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 16px\"&gt;\n&lt;td style=\"width: 27.439%; height: 16px\"&gt;&lt;strong&gt;Union Group:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 16px\"&gt;N/A&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 16px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Term of Position:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;12 Month&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;At Will/Just Cause:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Just Cause&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Summary of Position:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Oversees external and internal communications, strategically aligning media relations to tell the stories of Ferris State University students, employees, and programs.&lt;br&gt;&lt;br&gt;Oversees the team creating stories using written, photo, and video resources to be distributed to media, posted on the website, and shared on social media.&lt;br&gt;&lt;br&gt;The selected candidate for this position must be authorized to work in the United States at the time of hire without employer assistance or sponsorship now or in the future. The university will not assist with any F1 EAD’s, OPT, H1B, etc.&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Position Type:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Staff&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Required Education:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Bachelor's degree in journalism, public relations, communications, marketing, or a closely related field. &lt;br&gt;&lt;br&gt;Master's degree preferred.&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Required Work Experience:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Five or more years of progressively responsible professional communications, public relations, journalism, or media relations experience, including experience developing strategic communications plans.&lt;br&gt;&lt;br&gt;Experience in higher education communications, government, nonprofit, or a similarly complex organization.&lt;br&gt;&lt;br&gt;Experience with crisis communications and issues management.&lt;br&gt;&lt;br&gt;Experience managing media inquiries during high-profile or sensitive situations.&lt;br&gt;&lt;br&gt;Familiarity with photography, video production, and digital storytelling.&lt;br&gt;&lt;br&gt;Experience supervising professional staff, student employees, interns, or cross-functional project teams.&lt;br&gt;&lt;br&gt;Experience working with executive leadership and advising organizational leaders on communications strategies.&lt;br&gt;&lt;br&gt;Experience with media monitoring, analytics, and communications measurement.&lt;br&gt;&lt;br&gt;Experience supervising communications professionals.&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Required Licenses and Certifications:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 18px\"&gt;\n&lt;td style=\"width: 27.439%; height: 18px\"&gt;&lt;strong&gt;Physical Demands:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 18px\"&gt;\n&lt;ul&gt;\n&lt;li&gt;Office Environment&lt;/li&gt;\n&lt;li&gt;Bending&lt;/li&gt;\n&lt;li&gt;Reaching&lt;/li&gt;\n&lt;li&gt;Sitting&lt;/li&gt;\n&lt;li&gt;Twisting&lt;/li&gt;\n&lt;li&gt;Driving&lt;/li&gt;\n&lt;/ul&gt;\n&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Additional Education/Experiences to be Considered:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Essential Duties/Responsibilities:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Develop and implement comprehensive communications strategies supporting University priorities. &lt;br&gt;&lt;br&gt;Advance Ferris State University's reputation through proactive storytelling and strategic media engagement. &lt;br&gt;&lt;br&gt;Serve as a trusted communications advisor to university leadership. &lt;br&gt;&lt;br&gt;Identify opportunities to elevate institutional visibility and thought leadership.&lt;br&gt;&lt;br&gt;Develops and maintains strong relationships with local, statewide, regional, and national media to advance positive coverage of Ferris State University.&lt;br&gt;&lt;br&gt;Leads a team responsible for producing compelling written, photographic, video and multimedia content for news media, university websites, publications, social media channels, and other strategic communications.&lt;br&gt;&lt;br&gt;Assists with executive communications, speeches, talking points, messaging, and official statements for university leadership.&lt;br&gt;&lt;br&gt;Plays a leadership role in crisis and emergency communications, developing timely, accurate messaging for internal and external audiences through media relations, digital platforms, social media, and campus alert systems.&lt;br&gt;&lt;br&gt;Develops communications that keep faculty, staff and students informed of significant University initiatives, accomplishments and events.&lt;br&gt;&lt;br&gt;Monitors emerging issues and public sentiment to identify reputational risks and communications opportunities.&lt;br&gt;&lt;br&gt;Evaluates communications effectiveness using media monitoring, digital analytics and engagement metrics to inform strategy and continuous improvement.&lt;br&gt;&lt;br&gt;Collaborates with University Advancement and Marketing, Admissions, colleges, departments, and administrative units to identify and promote strategic stories and initiatives.&lt;br&gt;&lt;br&gt;Collaborates with the Director of Digital Experience and other marketing professionals to ensure communications strategies are integrated across web, social media, and digital platforms.&lt;br&gt;&lt;br&gt;Recruits, mentors, supervises and evaluates assigned staff while fostering professional growth and collaboration.&lt;br&gt;&lt;br&gt;Operates a university or personal vehicle safely while carrying out job responsibilities. Will authorize, pursuant to university policies and procedures, a driving record check, and will meet the driving authorization requirements through the course of employment in a position where you are authorized to drive a vehicle as part of our duties.&lt;br&gt;&lt;br&gt;Carries out responsibilities in accordance with university policies and applicable laws.&lt;br&gt;&lt;br&gt;Cultivates an environment of belonging that values, respects, supports, and celebrates individual similarities and differences, allowing students, faculty, and staff to thrive authentically.&lt;br&gt;&lt;br&gt;Support, promote, and develop university student enrollment and retention initiatives.&lt;br&gt;&lt;br&gt;Any other duties assigned within the position classification area.&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 35px\"&gt;\n&lt;td style=\"width: 27.439%; height: 35px\"&gt;&lt;strong&gt;Marginal Duties/Responsibilities:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 35px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 35px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Skills and Abilities:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Exceptional writing, editing and storytelling skills. &lt;br&gt;&lt;br&gt;Excellent verbal communication and presentation abilities. &lt;br&gt;&lt;br&gt;Ability to translate complex information into engaging, audience-focused communications. &lt;br&gt;&lt;br&gt;Demonstrated leadership and strategic thinking skills. &lt;br&gt;&lt;br&gt;Ability to build collaborative relationships across a complex organization. &lt;br&gt;&lt;br&gt;Excellent interpersonal skills and political awareness.&lt;br&gt;&lt;br&gt;Strong understanding of news media operations and earned media strategy. &lt;br&gt;&lt;br&gt;Experience serving as an organizational spokesperson or media contact. &lt;br&gt;&lt;br&gt;Outstanding organizational and project management abilities. &lt;br&gt;&lt;br&gt;Ability to manage multiple projects simultaneously while meeting deadlines. &lt;br&gt;&lt;br&gt;Ability to prioritize competing demands in a fast-paced environment. &lt;br&gt;&lt;br&gt;Familiarity with content management systems (CMS) &lt;br&gt;&lt;br&gt;Understanding of social media best practices &lt;br&gt;&lt;br&gt;Knowledge of digital communications strategies &lt;br&gt;&lt;br&gt;Experience with media monitoring and analytics platforms is preferred&lt;br&gt;&lt;br&gt;Expert knowledge of Associated Press style and strong editorial judgment.&lt;br&gt;&lt;br&gt;Demonstrated successful experience working directly with people from diverse backgrounds, including cultural, educational, socioeconomic, and life experiences.&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Required Documents:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;\n&lt;ul&gt;\n&lt;li&gt;Cover Letter&lt;/li&gt;\n&lt;li&gt;Resume&lt;/li&gt;\n&lt;li&gt;Unofficial Transcript 1&lt;/li&gt;\n&lt;/ul&gt;\n&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 34px\"&gt;\n&lt;td style=\"width: 27.439%; height: 34px\"&gt;&lt;strong&gt;Optional Documents:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 34px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 34px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 18px\"&gt;\n&lt;td style=\"width: 27.439%; height: 18px\"&gt;&lt;strong&gt;Special Instructions to Applicants:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 18px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 15px\"&gt;\n&lt;td style=\"width: 27.439%; height: 15px\"&gt;&lt;strong&gt;Initial Application Review Date:&lt;br&gt;&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 15px\"&gt;August 24, 2026&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 15px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;Open Until Position is Filled?:&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 17px\"&gt;Yes&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 17px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 15px\"&gt;\n&lt;td style=\"width: 27.439%; height: 15px\"&gt;&lt;strong&gt;Posting Close Date:&lt;br&gt;&lt;/strong&gt;&lt;/td&gt;\n&lt;td style=\"width: 72.561%; height: 15px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;td style=\"width: 6.27132%; height: 15px\"&gt;&amp;nbsp;&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr style=\"height: 17px\"&gt;\n&lt;td style=\"width: 27.439%; height: 17px\"&gt;&lt;strong&gt;EEO Statement:&lt;/strong&gt;&lt;/td&gt;\n&lt;td