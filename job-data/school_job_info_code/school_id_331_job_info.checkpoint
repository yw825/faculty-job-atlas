      "posting_url": "https://recruitingbypaycor.com/career/JobIntroduction.action?clientId=8a7883c66ad3d64e016ad629f40d0321&id=8a78839ea0f4259801a112d1777e3f1f",
      "job_title_in_post": "Assistant Professor of Psychology",
