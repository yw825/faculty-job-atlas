    },
    "https://ewal.fa.us8.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/11995": {
      "title": "Psychology Post-Doctoral Research Associate - Woodcock Institute",
      "description": "The Woodcock Institute for the Advancement of Neurocognitive Research and Applied Practice is committed to the interdisciplinary advancement of contemporary cognitive assessment and applying evidence-based research to clinical practice. The Woodcock Institute supports interdisciplinary research into the cognitive profiles of individuals with diagnosed exceptionalities (e.g., learning disabilities, neuropsychological conditions, behavioral and psychiatric disorders, and giftedness).",
      "department": null
    },
    "https://ewal.fa.us8.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/11963": {
      "title": "Associate Director Healthcare Administration - Dallas",
      "description": "The Healthcare Industry Liaison will serve as a strategic connector between Texas Woman’s University’s Health Care Administration (HCA) Program and the healthcare industry. Based at the Dallas campus, this individual will leverage their deep experience and network in healthcare to enhance the program’s engagement with healthcare organizations, support curriculum innovation, and expand opportunities for student internships, career pathways, and faculty-industry collaboration. This is a non-tenure track administrative leadership role and does not require a doctoral degree or experience with CAHME accreditation processes.",
      "department": null
    },
    "https://ewal.fa.us8.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/11843": {
      "title": "Clinical Teaching Assistant - Nursing Denton",
      "description": "The Clinical Teaching Assistant (CTA) provides direct support to lead clinical faculty in the instruction and supervision of nursing students during lab and clinical rotations. This position exists to enhance the student-to-instructor ratio, support individualized learning, and ensure a safe and high-quality clinical learning environment. CTAs facilitate the development of clinical skills, critical thinking, and professional behavior in alignment with program objectives. Work is performed under general supervision, with duties aligned to established procedures and instructional goals. Performance is evaluated based on the successful support of clinical instruction and student progress, in accordance with University policies.",
