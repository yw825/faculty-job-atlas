    "https://nus.wd1.myworkdayjobs.com/Careers/job/Los-Angeles-Center-Los-Angeles-CA/Part-time-Faculty--Bachelor-of-Science-in-Nursing---Clinical-Site-Assignments---Medical-Surgical---Geriatric-Nursing--Los-Angeles--CA-_R20263501-1": {
