    "https://secure.dc4.pageuppeople.com/apply/726/gateway/default.aspx?c=employeereferral&lJobID=536245&lJobSourceTypeID=831&sLanguage=en-us&sHome=https%3a%2f%2fcareers.uoregon.edu%2fcw%2fen-us%2fjob%2f536245%2ftemporary-employment-pool-2026": {
