  "raw": {
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/9955": {
      "title": "Research Fellow - School of Biosciences - 107914 - Grade 7",
      "description": "The successful candidate will integrate computational structural biology approaches with experimental data, including X-ray crystallography, NMR spectroscopy, cryo-electron microscopy, mass spectrometry and biophysical measurements. There will be opportunities to develop and apply novel computational methods and modelling strategies for studying challenging biological systems and translating structural insights into mechanistic understanding. \n\nPosting closes: 2026-10-19",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/9965": {
      "title": "Research Fellow (Electron Microscopy) - School of Biosciences - 95800 - Grade 7",
      "description": "There is a Research Fellow (Post-doc) position available in the field of integrative structural biology, based in the group of Prof. Teresa Carlomagno at the University of Birmingham. The research group studies the functional mechanisms of proteins, including intrinsically disordered proteins, nucleic acids and their complexes by integrative structural biology. The laboratory uses and develops state-of-the-art Nuclear Magnetic Resonance Spectroscopy (NMR) methods as a major structural biology tool, in combination with several other complementary techniques, in particular cryo-Electron Microscopy (cryo-EM), but also Mass Spectrometry (MS), Small-Angle-Scattering and Fluorescence Microscopy.\n\nPosting closes: 2026-10-18",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/9924": {
      "title": "Research Associate - School of Social Policy and Society - 107838 - Grade 6",
      "description": "This role will involve joining a team that will be exploring decarbonisation strategies within cancer care pathways.   This research supports NHS Net Zero commitments and Integrated Care Systems by identifying strategies that simultaneously reduce emissions, improve outcomes, and reduce inequalities. We will be focusing on cancer care because it is carbon-intensive, spans all settings, and requires public confidence. We will map co-benefits of decarbonisation strategies, explore stakeholder attitudes and acceptability, and co- produce a prioritised research agenda. Our aim is to create an evidence-based framework to identify co-benefits, ensuring decarbonisation efforts strengthen rather than compromise NHS care quality and equity.\n\nYour role will be to assist in the research by carrying out data collection, curation, analysis, and dissemination to create knowledge through providing research support for projects and research groups.\n\n\nPosting closes: 2026-10-01",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/9930": {
      "title": "Biostatistician - Cancer Research (UK) Clinical Trials Unit - 103295 - Grade 7",
      "description": "The post holder will contribute to methodological and clinical research through the design and analysis of CRCTU’s clinical trials. The post holder will work alongside a large number of biostatisticians specialising in specific disease, trial phase and methodological areas in adult and paediatric oncology. \n\nPosting closes: 2026-10-18",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10046": {
      "title": "Research Fellow - Department of Cancer and Genomic Sciences - 106039 - Grade 7",
      "description": "A Bone Cancer Research Trust/GOSH funded Research Fellow post, starting January 2027 within the lab of Prof. Clare Davies (https://www.claredavieslab.org/) and Dr. Susanne Gatz at the Department of Cancer and Genomic Sciences, investigating oncogenic mechanisms of the arginine methylatrasnferase, PRMT5, in Ewing sarcoma focusing on the DNA damage response and splicing.\n\nPosting closes: 2026-10-19",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10061": {
      "title": "Research Fellow - Department of Cardiovascular Sciences - 108034 - Grade 7",
      "description": "The Wragg group is looking for an exceptional candidate to work on a 5-year UKRI Medical Research Council funded project to define the mechanism of vasculogenic mimicry in RMS, identify therapies that modulate VM and understand their mechanisms and Develop VM-targeted therapeutics. The project combines in vitro and in vivo tumour and blood vessel modelling, tissue histology, advanced imaging, single cell transcriptomics and bioinformatics approaches.\n\nPosting closes: 2026-10-20",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10050": {
      "title": "Marie Curie Research Fellow (PhD Funded) - Birmingham Law School - 108013 - Grade 7",
      "description": "This post is focused on Islamic Constitutional Hybridity, entailing coverage of Indonesia, Morocco, and Uzbekistan. It addresses ways in which constitutional systems in societies with large Muslim populations internalise religious norms in state institutions and how this shapes democratic aspirations. The appointee will conduct comparative doctoral-level research to investigate how Islamic values and moral reasoning are integrated in constitutional and administrative governance in Muslim-majority societies.\n\nPosting closes: 2027-01-31",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10051": {
      "title": "Marie Curie Research Fellow (PhD Funded) - Birmingham Law School - 108012 - Grade 7",
      "description": "This post is focused on Constitutional Militarisation, Security and Democratic Reform. The appointee will conduct doctoral-level research that examines military influence on constitutional governance in societies with large Islamic populations, with some coverage of the following states: Egypt, Türkiye, and Sudan. The research will examine how military institutions shape constitutional governance and it will assess how legal reforms can strengthen civilian oversight of the military, reduce military dominance, and promote democratic transitions. \n\nPosting closes: 2027-01-31",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10074": {
      "title": "MOBILITY Research Fellow - College of Medicine and Health - 108056 - Grade 7",
      "description": "The University of Birmingham has received funding from the European Research Council to offer pump-priming postdoctoral fellowship awards to early career researchers to support development of their independent research programme. This new competitive fellowship scheme aims to support high-calibre post-doctoral researchers to develop proposals for submission to prestigious fellowship schemes such as NIHR Postdoctoral Awards, ERC starter grants, Future Leaders Fellowship, Wellcome/MRC Career Development Awards etc. The fellowship aims to boost the competitiveness of the postholder for these externally funded, independent fellowship applications by offering the opportunity to complete key research outputs in progress, develop new skills and/or generation of preliminary data.  The postholder will work in a high-quality research environment and will be sponsored by a senior mentor for development of their independent research within the strategic areas of research in the field of STEM.\n\nPosting closes: 2026-12-18",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10133": {
      "title": "Research Fellow - School of Computer Science  - 106639 - Grade 7",
      "description": "To create and contribute to the creation of knowledge by undertaking a specified range of activities within an established research programme and/or specific research project.\n\nPosting closes: 2026-10-27",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/9990": {
      "title": "Research Fellow - School of Chemical Engineering - 107918 - Grade 7",
      "description": "We want to appoint a motivated Postdoctoral Research Fellow to join a multidisciplinary team in the School of Chemical Engineering at the University of Birmingham. The project will develop a new screening platform using novel soft matter 3D printing methods to create physiologically relevant cardiac tissue models.\n\nPosting closes: 2026-10-20",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10104": {
      "title": "Research Fellow (Battery Recycling) - School of Metallurgy and Materials - 108039 - Grade 7",
      "description": "The post is a fixed-term Research Fellow for the “SHREDDER” (Sustainable High-value Recovery via Engineered Deconstruction of Energy storage for Reuse) project funded by Innovate UK, a collaborative research and development programme led by Ecobat Solutions UK Ltd, in partnership with the University of Birmingham and the Manufacturing Technology Centre (MTC).\n\nPosting closes: 2026-11-02",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10105": {
      "title": "Research Fellow (Battery Materials  Recycling) - College of Engineering and Physical Sciences - 108045 - Grade 7",
      "description": "The post-holder will join the Energy materials Group (EMG) in the School of Metallurgy and Materials to identify and validate optimum passivation, discharge, shredding, and materials-separation methods for reactive LMB chemistries (including lithium-sulphur, lithium-thionyl chloride, and manganese-oxide systems). This work will directly inform Recyclus' shredder redesign and scale-up, and contributing to a first-of-a-kind UK LMB processing capability. This post is a fixed-term research fellow position funded through HERMES (Hazardous Energy Recycling: Methods for Emerging Specialist Chemistries), a 30-month Innovate UK-funded project led by Recyclus Group Ltd, in partnership with the University of Birmingham.\n\n\n\nPosting closes: 2026-11-01",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10106": {
      "title": "Research Fellow  (Life Cycle Assessment of Manufacture and Recycling of New Energy Devices) - School of Metallurgy and Materials - 108037 - Grade 7",
      "description": "This post will be part of a new European project, SuMaCer, on the Sustainable Manufacturing of Functional Ceramics for Europe’s Net-Zero Industry Energy Devices. Your part in this project will be to embed life cycle thinking across the project, by engaging directly with the researchers involved in designing and running new manufacturing processes to gather the data required for Life Cycle Assessment (LCA) calculations and to advise them on how to improve the sustainability of their processes. In addition, you will track the economic and circularity indicators of the prototype devices.\n\nPosting closes: 2026-10-27",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10136": {
      "title": "Research Fellow - Department of Applied Health Sciences - 108095 - Grade 7",
      "description": "The post-holder with experience in, mixed-methods research will join our multidisciplinary team consisting of climate/geography, epidemiology/statistics, qualitative/sociology, clinical sciences, etc., based at the University of Birmingham. The Research Fellow will contribute to the scientific delivery of the NIHR-funded global health research programme, working closely with collaborators in the UK and India.\n\nPosting closes: 2026-11-08",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10149": {
      "title": "NIHR Maternity Disparities Consortium Evaluation & Impact Fellow - Department of Applied Health Sciences - 108093- Grade 8",
      "description": "We are seeking a mixed-methods researcher who thrives in multidisciplinary environments to play a pivotal role in improving health outcomes and reducing maternal inequalities. The Evaluation & Impact Fellow at the University of Birmingham will lead the design, coordination and delivery of the programme-level evaluation of the NIHR-funded Maternity Disparities Consortium (MDC), assessing implementation, research outputs, outcomes, equity, influence, environmental sustainability and wider real-world impact. The fellow will work in close collaboration with the Evaluation & Impact Fellow at Newcastle University.\n\nPosting closes: 2026-11-08",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10191": {
      "title": "Research Fellow - Department of Cancer and Genomic Sciences - 108132 - Grade 7",
      "description": "The post will be based in the research group of Professor Steve Smerdon and will work closely with Professor Tim Knowles, project lead Dr Dominik Kubicki and the wider Hephaisteion team. The Research Fellow will take promising proteins emerging from computational and cell-free screening into cellular expression systems; design and construct expression vectors; optimise expression in appropriate bacterial hosts; recover and purify proteins using standard molecular biology and protein-biochemistry techniques; and establish refolding routes where required.\n\nPosting closes: 2026-10-25",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10192": {
      "title": "Research Fellow - School of Engineering - 108120 - Grade 7",
      "description": "This Research Fellow position is based in the Department of Mechanical Engineering at the University of Birmingham and will support an industry-funded research project focused on engines operating on non-fossil fuels and their integration into hybrid electric vehicle powertrains. The research will involve engine modelling and simulation, intelligent control strategy development, and data-driven calibration, applying AI and optimisation techniques, including machine learning and metaheuristic algorithms, to improve engine performance and efficiency and reduce emissions.\n\nPosting closes: 2026-10-25",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/10174": {
      "title": "Teaching Fellow - School of Engineering - 108122 - Grade 7",
      "description": "We are interested in motivated applicants to provide additional teaching support across our undergraduate engineering programmes in Engineering, particularly with experience of teaching core mechanical engineering topics such as CAD, Mechanics, Fluids, Thermodynamics, and Mathematics.\n\nPosting closes: 2026-10-22",
      "department": null
