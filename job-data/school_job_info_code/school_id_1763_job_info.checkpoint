    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/9913": {
      "title": "Research Fellow (BCC-Superalloys) - School of Metallurgy and Materials - 96647 - Grade 7",
      "description": "The University of Birmingham is seeking a Research Fellow to create and contribute to the creation of knowledge by undertaking a range of activities within the Materials for Extremes research group.\n\nThe Materials for Extremes research group seeks to discover fundamentally new alloys for extreme environments across nuclear fusion/fission reactors, aerospace gas turbines and concentrated solar power. This involves: (1) Alloy Design, supported by computation methods; (2) Production through arc melting, powder metallurgy or additive manufacturing; (3) Characterisation using advanced electron microscopy (SEM, EBSD, TEM), APT and x-ray diffraction methods; (4) Mechanical Testing and failure investigation, including macro-, micro- & in-situ testing, (5) Irradiation damage studies, using University of Birmingham’s proton/neutron facilities.\n\nPosting closes: 2026-09-22",
      "department": null
    },
    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/9919": {
      "title": "Research Fellow I - Department of Applied Health Sciences - 107891 - Grade 7",
      "description": "Applications are invited for an ambitious Mixed Methods Research Fellow to work at the University of Birmingham across a nationally-leading research programme funded by the National Institute for Health and Care Research (NIHR) as part of the NIHR Maternity Disparities Consortium (MDC).\nThe postholder will work within the pregnancy, birth and early postnatal maternal health theme (Theme 2), including research programmes in cardiometabolic risk prevention and management, and specifically, remote blood pressure monitoring in pregnancy and the postnatal period. \nThe researcher will support the MDC in delivering impactful research and knowledge mobilisation activities with partners across the health and care system. You will be expected to support the development and delivery of components of the theme’s research programme initially until the 31st of May 2028.\n\n\nPosting closes: 2026-09-16",
      "department": null
    },
