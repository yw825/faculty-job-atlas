    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/9869": {
      "title": "Research Fellow - College of Arts and Law - 107761 - Grade 7",
      "description": "The Department of Linguistics and Communication seeks to appoint a Research Fellow to work on the British Academy funded project ‘Language evolution and sociolinguistic variation in signing communities’ (or ‘EvoSLang’) led by Dr. Rose Stamp and Prof. Adam Schembri. EvoSLang combines sociolinguistic and language evolution approaches to understand the factors affect lexical competition; why do some variants “win” out in language evolution and others disappear out of usage? In this project, we compare variation across three sign languages of different ages and sociolinguistic profiles: British Sign Language (BSL), Israeli Sign Language (ISL) and Kufr Qassem Sign Language (KQSL). \n\nPosting closes: 2026-09-10",
      "department": null
    },
