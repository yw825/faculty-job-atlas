    "https://edzz.fa.em3.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_6001/job/9938": {
      "title": "Research Fellow - Department of Pharmacy - 107908 - Grade 7",
      "description": "The post-holder will contribute to an ARIA funded research project developing innovative nanomaterial-based technologies for mitochondrial nucleic acid delivery. Working within their area of specialism, the post-holder will contribute to the design, development and evaluation of advanced nanomaterial-based delivery systems and to the wider objectives of the research programme.\n\nPosting closes: 2026-09-23",
      "department": null
