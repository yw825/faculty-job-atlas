    "https://fa-exci-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2/job/940": {
      "title": "Associate Director Employer Relations & Outreach",
      "description": "The Associate Director of Employer Relations and Outreach will work closely with the Chief Career Officer and advising team to develop and lead strategic initiatives to expand employer partnerships, enhance experiential learning opportunities, and align external engagement with institutional goals. This individual will create, coordinate, implement and manage workflows to positively affect employer retention and manage efforts to increase the quality and number of internships and full time job opportunities for Davidson College students. This person plays a critical role in integrating employer engagement into student experience through events, classroom visits, and high-impact practices, while promoting inclusive strategies and data-informed decision-making. ",
      "department": null
    },
    "https://fa-exci-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2/job/925": {
      "title": "Executive Director for Student Health & Well-Being",
      "description": "The Executive Director of Health and Well-Being will advance a comprehensive, integrated approach to student health by strengthening coordination across clinical services, health promotion, and campus-wide well-being initiatives. This role will partner closely with colleagues in Student Life, Academic Affairs, Athletics, Dining, and other key areas to build and sustain a shared, institution-wide vision for holistic student health and thriving.",
      "department": null
    },
    "https://fa-exci-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2/job/613": {
      "title": "Physical Plant Temporary Summer Worker",
      "description": "Perform a variety of facilities maintenance work to include grounds and mechanical general type duties in support of physical plant summer tasks throughout college-owned facilities. ",
      "department": null
    }
  },
