    "https://recruiting2.ultipro.com/HER1009HRZ/JobBoard/267d2e37-abff-4559-8a18-a754503d3749/OpportunityDetail?opportunityId=8a09ef08-b8fb-494e-928e-e3cd024c7a95": {
      "title": "International Student Assistant (Required to be current Herzing U. student)",
