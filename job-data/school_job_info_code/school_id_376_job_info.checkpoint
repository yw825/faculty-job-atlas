    "https://www.careers.luc.edu/postings/35929": {
      "title": "Director of the Adult Gerontology Acute Care Nurse Practitioner Track of the Doctor of Nursing Practice Program (Clinical Assistant Professor, Clinical Associate Professor, or Clinical Professor)",
