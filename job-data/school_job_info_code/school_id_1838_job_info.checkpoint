, "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://www.hksyu.edu/assets/careers/UAO/2026/Jun/uao_ao_marketing_ft_2026-06-30.pdf": {"school_id": 1838, "posting_url": "https://www.hksyu.edu/assets/careers/UAO/2026/Jun/uao_ao_marketing_ft_2026-06-30.pdf", "job_title_in_post": "Admissions O\ufb03cer (Marke\ufffdng and Admissions)", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://www.hksyu.edu/assets/careers/UAO/2026/Jun/uao_ao_media_ft_2026-06-30.pdf": {"school_id": 1838, "posting_url": "https://www.hksyu.edu/assets/careers/UAO/2026/Jun/uao_ao_media_ft_2026-06-30.pdf", "job_title_in_post": "Admissions O\ufb03cer (Mul\ufffdmedia Produc\ufffdon)", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://www.hksyu.edu/assets/careers/CIEBPR/2026/Jul/ciebpr_pm_po_ft_2026-07-14.pdf": {"school_id": 1838, "posting_url": "https://www.hksyu.edu/assets/careers/CIEBPR/2026/Jul/ciebpr_pm_po_ft_2026-07-14.pdf", "job_title_in_post": "Mrs. Dorothy Koo and Dr. Ti-Hua Koo Centre for Interdisciplinary Evidence-based Practice and", "position_type": "Non-academic", "job_term": "Full-time", "department_or_school": "Centre for Interdisciplinary", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://www.hksyu.edu/assets/careers/CIEBPR/2026/Mar/ciepbr_po_eo_ft_2026-03-30.pdf": {"school_id": 1838, "posting_url": "https://www.hksyu.edu/assets/careers/CIEBPR/2026/Mar/ciepbr_po_eo_ft_2026-03-30.pdf", "job_title_in_post": "Mrs Dorothy Koo and Dr Ti-Hua Koo Centre for Interdisciplinary Evidence-based Practice", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://www.hksyu.edu/assets/careers/UAO/2026/Mar/uao_aa_ft_2026-03-03.pdf": {"school_id": 1838, "posting_url": "https://www.hksyu.edu/assets/careers/UAO/2026/Mar/uao_aa_ft_2026-03-03.pdf", "job_title_in_post": "Admissions Assistant / Officer (Admissions Advisory", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://www.hksyu.edu/assets/careers/HMU/2026/Feb/hmu_ssossa_ft_2026-02-02.pdf": {"school_id": 1838, "posting_url": "https://www.hksyu.edu/assets/careers/HMU/2026/Feb/hmu_ssossa_ft_2026-02-02.pdf", "job_title_in_post": "Position: Student Services Officer / Student Services Assistant(Hall Management Unit)", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://www.hksyu.edu/assets/careers/ESG/2026/Apr/esg_tomo_ft_2026-04-17.pdf": {"school_id": 1838, "posting_url": "https://www.hksyu.edu/assets/careers/ESG/2026/Apr/esg_tomo_ft_2026-04-17.pdf", "job_title_in_post": "Hong Kong Shue Yan University (HKSYU) invites applications for the position of Technical", "position_type": "Non-academic", "job_term": "Full-time", "department_or_school": "Institute of Facility Management", "area_key_words": "Technical", "deadline_of_application": "", "position_start_date": ""}, "https://www.hksyu.edu/assets/careers/RCDTBI/2025/Oct/rcdtbi_po_ft_2025-10-30.pdf": {"school_id": 1838, "posting_url": "https://www.hksyu.edu/assets/careers/RCDTBI/2025/Oct/rcdtbi_po_ft_2025-10-30.pdf", "job_title_in_post": "Full Time Project Officers (Full-time)", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "Center for Digital Education and", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://www.hksyu.edu/assets