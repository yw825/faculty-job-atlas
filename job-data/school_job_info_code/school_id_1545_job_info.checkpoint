 "area_key_words": "Industrial/Organizational Psychology; online formats", "deadline_of_application": "November 8, 2026", "position_start_date": "2026-10-07"}, "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/Menomonie-WI/Teaching-Assistant-Associate-Professor---Master-s-in-Social-Work_JR10015087": {"school_id": 1545, "posting_url": "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/Menomonie-WI/Teaching-Assistant-Associate-Professor---Master-s-in-Social-Work_JR10015087", "job_title_in_post": "Teaching Assistant/Associate Professor \u2013 Master's in Social Work", "position_type": "Assistant_Professor; Associate_Professor", "job_term": "Full-time", "department_or_school": "Department of Health Services", "area_key_words": "Master's in Social Work; Associate Professor positions", "deadline_of_application": "November 8, 2026", "position_start_date": "2026-10-06"}, "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/Menomonie-WI/Lecturer-of-Early-Childhood-Education_JR10009647": {"school_id": 1545, "posting_url": "https://wisconsin.wd1.myworkdayjobs.com/UW_Comprehensives/job/Menomonie-WI/Lecturer-of-Early-Childhood-Education_JR10009647", "job_title_in_post": "Lecturer of Early Childhood Education", "position_type": "Lecturer", "job_term": "Full-time", "department_or_school": "", "area_key_words": "Early Childhood Education; Early Childhood Special Educ", "deadline_of_application": "September 28, 2026", "position_start_date": "2026-08-27"}}, "school_id": 1545, "status": "complete", "updated_at": "2026-10-21T18:59:24+00:00", "completed_at": "2026-10-21T18:59:24+00:00", "last_error": ""}