    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/1832": {
      "title": "Head of Collection Services and Strategies, Butler Libraries",
      "description": "Butler University Libraries invites applications for the Head of Collection Services & Strategies. As part of the Library Leadership team, this role provides vision for a six‑person department responsible for acquisitions, resource sharing, electronic and print collections, and scholarly communication. As library faculty, it also includes liaison work such as instruction, collection development, and research support. Butler Libraries encourages innovative approaches and seeks a communicative, collaborative leader who values expertise and builds strong relationships across the library and campus. This is a 12‑month, continuing (non‑tenured) faculty appointment reporting to the Dean of Libraries.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/1689": {
      "title": "PT Group Fitness Instructor, Fitness",
      "description": "Group Fitness Instructors strive to live out the vision, mission and core values of the Office of  Recreation & Wellness through fun and interactive and encouraging group experience that can  improve over all health, fitness and well-being.  This is a position in which the Group Fitness  Instructor is expected to lead a group of participants through group fitness classes. The GFI  creatively designs classes that are safe for participants including proper use of equipment and  movement. Administrative duties include timely communication with the supervisor and participants, keeping participant counts and maintaining knowledge of current industry  standards. ",
      "department": null
    }
