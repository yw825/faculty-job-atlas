  "raw": {
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2164": {
      "title": "Assistant Director of the Office of Sponsored Programs",
      "description": "The Assistant Director of the Office of Sponsored Programs will oversee research compliance and sponsored programs administration for Butler University. This includes IRB, IACUC, IBC, and FCOI as well as assisting the OSP director, faculty, and staff in the preparation, review, and submission of proposals for contracts or grants to external partners. The role requires in-depth knowledge about research in higher education as well as maintaining knowledge of federal and state laws. This position contributes to Butler's objectives by ensuring research policy and laws are followed by all individuals taking part in externally funded research at Butler. Oversees responsible conduct of research training and other activities that promote integrity in research and ensure compliance with relevant policies and regulations. Assists in developing and implementing OSP strategic plans and goals.      ",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/1691": {
      "title": "Fan Game-Day Ambassador (Part-Time), Butler Athletics",
      "description": "Join the team that brings Butler Basketball to life inside historic Hinkle Fieldhouse and Butler Football to the Bud and Jackie Sellick Bowl. Fan Engagement Ambassadors are the welcoming faces of Butler Athletics—creating a safe, enjoyable, and memorable experience for every guest. With a focus on service, enthusiasm, and school pride, Ambassadors represent The Butler Way at every event.\n\nThis part-time role is perfect for individuals who enjoy connecting with people, contributing to a team, and being part of the excitement on game day.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2160": {
      "title": "Assistant Professor",
      "description": "The Butler University College of Health Professions invites applications for the position of Assistant Professor (tenure track, 10-month appointment) in the Department of Health Sciences. We are in search of an individual to join a growing team of faculty to teach undergraduate courses in Human Anatomy & Physiology. Additional opportunities for teaching exist in the areas of Nutrition and Medical Terminology. Qualified applicants must have earned a PhD in an anatomy and physiology related discipline.  ",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2155": {
      "title": "Assistant/Associate Professor, Counselor Education",
      "description": "The College of Education and Human Development (CEHD) at Butler University invites applications for a full-time, tenure-track faculty member in Counselor Education with an expected start date of August 2027. The successful candidate will teach online courses in the CACREP core areas and either the Clinical Mental Health Counseling or School Counseling specialization on a 9-month contract with annual summer teaching expectations for additional compensation. Specific responsibilities are listed below, but our new colleague would enhance our rapidly growing online degree programs through collaboration as an educator-scholar who both trains excellent counselors and engages with colleagues, clients, families, and communities to transform existing approaches to teaching, counseling, and scholarship. This is an on-campus position located at Butler University in Indianapolis, Indiana.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2156": {
      "title": "Lecturer, Counselor Education",
      "description": "The College of Education and Human Development (CEHD) at Butler University invites applications for a full-time, non-tenure-track faculty member in Counselor Education with an expected start date of August 2027. The successful candidate will teach online courses in the CACREP core areas and either the Clinical Mental Health Counseling or School Counseling specialization on a 9-month contract with annual summer teaching expectations for additional compensation. We are specifically seeking a motivated colleague to enhance our rapidly growing online degree programs. This is an on-campus position located at Butler University in Indianapolis, Indiana.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2157": {
      "title": "Assistant Professor, Mathematical Sciences",
      "description": "The Department of Mathematical Sciences at Butler University invites applications for a tenure-track Assistant Professor position starting in August 2027.  We welcome applicants in Statistics or closely related fields, but we will consider applicants from all mathematical fields willing to teach courses in our Statistics Major. Other teaching responsibilities may include courses in our Actuarial Science and Data Science Majors, introductory courses in our Mathematics Major, and courses for non-majors. The typical teaching load is three courses (9 credit hours) per semester. Questions about this position may be directed to Dr. Scott Kaschner (skaschne@butler.edu).",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2159": {
      "title": "Assistant Athletic Director, Development",
      "description": "The Assistant Athletic Director/Development position will serve as a gift officer on behalf of the Athletic Department. This position will develop and manage a portfolio consisting of mid-major donors, major gift donors, and prospects. The primary focus will be on identifying new prospects, cultivating current/prospective donors, soliciting major gifts, and stewarding existing/new donors. This position will manage the Athletics Endowment Program and assist with management of the Butler Way Society.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2153": {
      "title": "Brand Content Director",
      "description": "The Brand Content Director is a strategic storyteller responsible for bringing Butler University’s brand to life through compelling narratives, consistent voice, and high-impact social and multimedia content. This leader shapes how Butler shows up across University-owned channels to strengthen national awareness, advance enrollment goals, and showcase the transformational impact of a Butler education. The Director oversees the University’s brand content ecosystem— including long-form storytelling platforms such as the Butler Magazine and stories.butler.edu, as well as digital content, social media, and video—while leading the brand content team. The ideal candidate blends creative vision, strategic leadership, and strong campus partnerships to deliver content that advances Butler’s institutional priorities.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2154": {
      "title": "Executive Director of Strategic Communications",
      "description": "The Executive Director of Strategic Communications is responsible for providing leadership, oversight, and direction for a University-wide strategic communications strategy for the primary purpose of elevating the University’s national reputation and awareness. \n\nReporting directly to the Vice President for University Advancement and Marketing, the Executive Director will lead a cross-functional team from across the University charged with elevating Butler’s national reputation and awareness by aligning external and internal communications, executive positioning, public relations and media relations, and University partnerships. \n\nApplicants must submit a cover letter to be considered for this position.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2134": {
      "title": "Assistant Professor, Engineering",
      "description": "The newly formed Department of Engineering in the College of Liberal Arts and Sciences at Butler University invites applications for a tenure-track Assistant Professor in Chemical Engineering, Bioengineering, or a closely related field to start in August 2027. Candidates should demonstrate a commitment to excellent undergraduate teaching that promotes inclusive and equity-minded learning environments for an increasingly diverse student population. Engineering faculty members foster student learning through student-centered pedagogy, inclusive practices, entrepreneurially minded projects, hands-on laboratory experiences, and design-based learning.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2120": {
      "title": "Visiting Assistant Professor, Psychology",
      "description": "The Department of Psychology at Butler University (Indianapolis, IN) invites applications for a one-semester, non-tenure track visiting assistant professor position beginning January 2027. We seek a colleague who demonstrates active dedication to inclusive undergraduate teaching. The Butler Psychology Department values candidates who share our commitment to engagement and inclusion of students, faculty, and staff with diverse backgrounds, perspectives, and experiences. Butler cannot provide visa sponsorship for this position.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2122": {
      "title": "Assistant Professor, Psychology",
      "description": "The Department of Psychology at Butler University (Indianapolis, IN) invites applications for a tenure-track Assistant Professor in Developmental Psychology or Child Clinical Psychology to start in August 2027. We seek a colleague who is committed to inclusive undergraduate teaching and collaborative research with undergraduate students. The Butler Psychology Department values candidates who share our commitment to engagement and inclusion of students, faculty, and staff with diverse backgrounds, perspectives, and experiences.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2113": {
      "title": "Assistant Professor, Neuroscience",
      "description": "The interdisciplinary Neuroscience Program in the College of Liberal Arts and Sciences at Butler University (Indianapolis, IN) invites applications for a tenure track assistant professor position beginning August 2027. We seek a colleague who values interdisciplinary approaches to neuroscience, has a demonstrated commitment to inclusive teaching practices, and is prepared to engage in collaborative research with undergraduate students. Standard teaching load is three courses (nine credit hours) of in-person instruction per semester plus an active program of research involving undergraduate collaborators.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2114": {
      "title": "Assistant Professor, Biology",
      "description": "The Department of Biological Sciences at Butler University invites applications for a tenure-track Assistant Professor position starting in August 2027.  We are searching for a broadly trained vertebrate ecologist. Experience in the areas of form and function, and quantitative or computational methods would be viewed favorably.  Teaching responsibilities will include major courses in organismal biology including those in the applicant’s specialty (e.g., ornithology, ichthyology, mammalogy, functional morphology, comparative vertebrate anatomy, etc.), as well as introductory classes in ecology and evolution, biostatistics, an occasional senior Capstone, and Core Curriculum courses for non-majors. Questions about this position may be directed to Dr. Kyryll Savchenko (ksavchen@butler.edu).",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2097": {
      "title": "Associate Director of Career Success, Founder's College",
      "description": "The Associate Director for Career Success advances Founder's College's commitment to student success by preparing students to confidently pursue meaningful careers and continued educational opportunities. Through intentional career development, experiential learning, employer and community partnerships, and individualized coaching, this position empowers students to discover their strengths, develop professional competencies, and successfully navigate their academic and professional journey.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2099": {
      "title": "Muslim Life Advisor",
      "description": "The Muslim Life Advisor supports Muslim students and advances Muslim life at Butler University by fostering belonging, providing religious and spiritual guidance, and connecting students with campus and community resources. The Advisor develops experiential opportunities that deepen the campus community’s understanding of Islamic beliefs, practices, cultures, and communities; supports outreach to prospective Muslim students and families; and contributes expertise and support to The Compass Center’s interfaith programs. The Advisor brings knowledge, experience, and vision grounded in the diversity of Islamic traditions and communities and, under the direction of the Director, carries a defined portfolio aligned with Compass Center priorities and broader Culture & Inclusion and DEISA initiatives.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2091": {
      "title": "Adjunct - Nursing",
      "description": "The Bachelor of Science in Nursing (BSN) Program within the College of Health Professions (CHP) at Butler University invites applications for Adjunct Clinical Faculty positions beginning in Spring 2027 (January 2027).\n\nWe seek experienced registered nurses who are passionate about mentoring future nurses and facilitating high-quality clinical learning experiences in adult and gerontological healthcare settings. Adjunct Clinical Faculty play a critical role in helping students develop clinical judgment, professional identity, communication skills, and safe, evidence-based nursing practice.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2062": {
      "title": "Ecosystem Navigator, CISBDC",
      "description": "The Ecosystem Navigator at the Indiana Small Business Development Center (ISBDC) is a strategic role bridging the interests of the Indiana Economic Development Corporation's (IEDC) Entrepreneurship Team, ConnectIND portal, stakeholders, peer groups, and the SBDC team. The Navigator will work in tandem with Business Advisors and other key stakeholders to foster a thriving entrepreneurial ecosystem. While reporting to the Center's Regional Director, the Ecosystem Navigator will also receive direction from the IEDC team, aligning efforts for maximum impact.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2050": {
      "title": "Associate Director International Admission",
      "description": "Butler University seeks a degreed and experienced professional to promote the university to prospective students and assist students and families in the admission process with the goal of increasing international student enrollment.  The title is commensurate with experience. ",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2041": {
      "title": "Associate Director Admission - Founder's College",
      "description": "The Associate Director of Admission will lead the recruitment efforts for Founder’s College at Butler University and play a key role in attracting and enrolling students who are seeking alternative pathways to higher education. This role will collaborate closely with the Executive Director of Admission at Butler University to develop and implement recruitment strategies, manage admission processes, and ensure an exceptional experience for prospective students from inquiry to enrollment. \n\nThe Associate Director will create and coordinate outreach initiatives to develop and cultivate relationships with community-based organizations, high schools, and other organizations in the Indianapolis area that align with Founder’s commitment to increasing education access to high-potential students who have historically been underserved by higher education.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2042": {
      "title": "Admission Assistant, Founder's College",
      "description": "The Founder’s College Admission Assistant reports to the Associate Director for Admission for Founder’s College at Butler University.  Serves as the primary point of contact for current Founder’s College students with in-person services and for Founder’s College prospective students and their families with respect to campus visits and events and admission process support.  Role serves as the primary contact role for front desk operations. \nThis individual works collaboratively with the Admission Assistant for the Visit Experience based in the Undergraduate Admission Office as they both coordinate and plan daily admission visits and group visits with respect to audience. As the administrative visit support for Founder’s College, this individual responds to inbox requests, phone calls for visits, inquiries from campus constituents regarding visit schedules and execution, runs regular SLATE CRM queries for daily visit itineraries, and manages daily check-ins. This person works with the As",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2027": {
      "title": "Facilities Maintenance Technician (2nd-shift)",
      "description": "The Facilities Maintenance Technician supports Butler University's campus by performing a variety of semi-skilled and skilled maintenance duties across multiple building systems and trade areas. Working under the direction of the T.E.M.P. Shop Supervisor, this position helps ensure campus facilities remain safe, functional, and well-maintained through preventive maintenance, repairs, troubleshooting, and installations.\n\nResponsibilities may include plumbing, electrical, HVAC, data communications, fire alarm systems, campus utilities, building automation systems, swimming pool operations, preventive maintenance, event support, and minor construction projects. Assignments are based on the employee's knowledge, skills, certifications, and operational needs.\n\nThis is a second shift opportunity from 2:30pm-11:00pm.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2026": {
      "title": "Facilities Maintenance Technician",
      "description": "The Facilities Maintenance Technician supports Butler University's campus by performing a variety of semi-skilled and skilled maintenance duties across multiple building systems and trade areas. Working under the direction of the T.E.M.P. Shop Supervisor, this position helps ensure campus facilities remain safe, functional, and well-maintained through preventive maintenance, repairs, troubleshooting, and installations.\n\nResponsibilities may include plumbing, electrical, HVAC, data communications, fire alarm systems, campus utilities, building automation systems, swimming pool operations, preventive maintenance, event support, and minor construction projects. Assignments are based on the employee's knowledge, skills, certifications, and operational needs.",
      "department": null
