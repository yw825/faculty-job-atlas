  "raw": {
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2253": {
      "title": "Director of Experiential Learning",
      "description": "The Director of Experiential Learning serves as the strategic and operational leader responsible for implementing, scaling, and overseeing the university-wide Experiential Learning for All initiative. This position collaborates across academic and administrative units to develop centralized infrastructure, establish systems and processes, implement quality measures, and coordinate university-wide tracking to ensure equitable student access while supporting college ownership of learning. The Director also partners with internal and external stakeholders to integrate high-impact experiential opportunities into degree requirements, academic advising, career mentoring, and the broader Boldly Butler strategic vision.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2250": {
      "title": "Assistant Costumer - Department of Dance",
      "description": "The Assistant Costumer for the Department of Dance within Jordan College of the Arts will assist the Costume Director in the construction and maintenance of all Butler Ballet costumes and wardrobe.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2246": {
      "title": "Police Dispatcher",
      "description": "The Police Dispatcher supports campus safety and operations at Butler University by receiving calls for assistance, dispatching Public Safety officers, and monitoring alarms and video surveillance systems. This position also coordinates emergency and after-hours service requests, manages electronic building access, and provides responsive, professional customer service to the campus community.\n\nWork Schedule: This is a full-time position working 80 hours over a two-week pay period on a rotating shift schedule. The primary shift is 7:00 p.m. to 7:00 a.m.; however, employees will also be required to work 3:00 p.m. to 11:00 p.m. and 11:00 p.m. to 7:00 a.m. shifts within the same two-week period. Flexibility to accommodate all three shifts is required.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2237": {
      "title": "Disability Specialist",
      "description": "Disability Specialists work one-on-one to provide support to students with disabilities as they navigate the transition to college and the independence of being a college student. In this role, Disability Specialists review documentation and make individualized determinations of reasonable accommodation for students with disabilities. Butler University’s SDS Office is unique in that Disability Specialists are also available to provide support to students regarding the myriads of ways their disability may impact them throughout their time as a Butler student. Several primary functions of this position include individualized student support, development and presentation of disability-awareness programming across campus, and close collaboration with faculty and other campus partners.\n\nNote: Please submit a cover letter with your application that highlights how your skills and experiences have prepared you to work with students with disabilities on the college level, what draws you to this",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2235": {
      "title": "Director Undergraduate Enrollment Marketing",
      "description": "The Undergraduate Enrollment Marketing Director provides strategic leadership for Butler’s undergraduate enrollment marketing efforts, developing and executing integrated marketing and communication strategies that support institutional recruitment goals. This role leads enrollment marketing efforts for all undergraduate audiences, including traditional residential first-year, transfer, and international students, as well as emerging education models such as Founder’s College and Butler Overseas. The Director supervises undergraduate enrollment marketing staff and works in close partnership with Enrollment Management while leading cross-functional collaboration across University Marketing to translate enrollment priorities into coordinated, high-quality execution.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2229": {
      "title": "Associate/Assistant Director of Enrollment Marketing",
      "description": "The Assistant Director of Enrollment Marketing supports the development and execution of enrollment marketing strategies and content for Butler’s undergraduate audiences. This position provides coordination and strategy for marketing initiatives related to new undergraduate models, undergraduate academic programs, and pre-college experiences, while supporting marketing efforts for the traditional residential undergraduate population.\n\nPosition Level: This position may be filled at either the Assistant Director or Associate Director level, depending on the qualifications and relevant experience of the selected candidate. Generally, 3–5 years of relevant experience will align with the Assistant Director level, while 5–7 years of relevant experience will align with the Associate Director level.\n",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2217": {
      "title": "Admission Counselor",
      "description": "The admission counselor role promotes and represents the university to prospective students and families and assists them throughout their college search and enrollment process. This position reports to an Associate Director of Admission and is responsible for all aspects of recruiting prospective first year (and transfer) students. This position will support multiple recruitment projects and programs and use a strategic approach to territory management with the guidance and support of the senior admission team. This role serves in a primarily on-campus capacity during the regular work week with flexibility based on required travel and approved work from home options that may include one to two days a week depending on season/workload.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2203": {
      "title": "Associate Director of Career Mentoring",
      "description": "The Associate Director of Career Mentoring leads the university-wide implementation of Career Mentoring for All, advancing Butler’s commitment to ensure every student benefits from meaningful career mentoring throughout their undergraduate experience. The positions builds and sustains a scalable mentoring model that helps students develop career readiness, build professional networks, connect academic and experiential learning to their goals and prepare for life after Butler.\n\nWorking across colleges and divisions, the Associate Director leads the network of Career Mentors and College-Based Career Mentor Leads. The position ensures a consistent, high-quality student experience while supporting appropriate college-level adaption and building the capacity of those delivering career mentoring across the University.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2194": {
      "title": "Associate Director of Student Activities",
      "description": "This Associate Director contributes to our vibrant campus environment through the support and development of student organizations. This position will be the primary point of contact for tools and services that support our 200+ student organization community. This Associate Director will specifically focus on facilitating organizational training, assisting in the development of leadership curriculum, and planning co-curricular programs that enhance student wellbeing and engagement. The Associate Director of Student Activities- Student Organizations/Leadership Development will collaborate with organization leaders and campus stakeholders to enhance the holistic development of the Butler University student body.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2191": {
      "title": "Assistant Professor, History",
      "description": "The Department of History, Anthropology, and Classics at Butler University invites applications for a full-time, tenure-track Assistant Professor in Latin American history starting in August 2027. We seek a Latin American historian with an innovative and potentially interdisciplinary approach to the discipline. We are particularly interested in candidates whose teaching and research complement and expand the department’s existing areas of expertise and course offerings. \n",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2181": {
      "title": "Assistant Professor of Music Education",
      "description": "FACULTY POSITION IN GENERAL MUSIC EDUCATION BEGINNING AUGUST 2027\n\nPOSITION: Assistant Professor of Music Education, tenure-track\n\nRANK AND SALARY: Competitive and commensurate with experience and qualifications.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2184": {
      "title": "Area Coordinator",
      "description": "The Area Coordinator serves as a member of the Residence Life team that provides vision and direction for their residential community for an undergraduate on-campus population of 2700 with a 3-year campus live on requirement. The Area Coordinator is responsible for the management and supervision of one of four residential areas, each housing approximately 500-700 residents and direct supervision and evaluation of the Resident Assistant student staff of 12-19.\n\nLive-In Benefits:\n- Furnished Apartment\n- Utilities \n- Assigned Parking Space\n- Meal Plan (Academic Year)\n- Laundry\n- Gym Membership (on campus)\n- Pets Welcome\n",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/1691": {
      "title": "Fan Game-Day Ambassador (Part-Time), Butler Athletics",
      "description": "Join the team that brings Butler Basketball to life inside historic Hinkle Fieldhouse and Butler Football to the Bud and Jackie Sellick Bowl. Fan Engagement Ambassadors are the welcoming faces of Butler Athletics—creating a safe, enjoyable, and memorable experience for every guest. With a focus on service, enthusiasm, and school pride, Ambassadors represent The Butler Way at every event.\n\nThis part-time role is perfect for individuals who enjoy connecting with people, contributing to a team, and being part of the excitement on game day.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2160": {
      "title": "Assistant Professor",
      "description": "The Butler University College of Health Professions invites applications for the position of Assistant Professor (tenure track, 10-month appointment) in the Department of Health Sciences. We are in search of an individual to join a growing team of faculty to teach undergraduate courses in Human Anatomy & Physiology. Additional opportunities for teaching exist in the areas of Nutrition and Medical Terminology. Qualified applicants must have earned a PhD in an anatomy and physiology related discipline.  ",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2155": {
      "title": "Assistant/Associate Professor, Counselor Education",
      "description": "The College of Education and Human Development (CEHD) at Butler University invites applications for a full-time, tenure-track faculty member in Counselor Education with an expected start date of August 2027. The successful candidate will teach online courses in the CACREP core areas and either the Clinical Mental Health Counseling or School Counseling specialization on a 9-month contract with annual summer teaching expectations for additional compensation. Specific responsibilities are listed below, but our new colleague would enhance our rapidly growing online degree programs through collaboration as an educator-scholar who both trains excellent counselors and engages with colleagues, clients, families, and communities to transform existing approaches to teaching, counseling, and scholarship. This is an on-campus position located at Butler University in Indianapolis, Indiana.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2156": {
      "title": "Lecturer, Counselor Education",
      "description": "The College of Education and Human Development (CEHD) at Butler University invites applications for a full-time, non-tenure-track faculty member in Counselor Education with an expected start date of August 2027. The successful candidate will teach online courses in the CACREP core areas and either the Clinical Mental Health Counseling or School Counseling specialization on a 9-month contract with annual summer teaching expectations for additional compensation. We are specifically seeking a motivated colleague to enhance our rapidly growing online degree programs. This is an on-campus position located at Butler University in Indianapolis, Indiana.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2091": {
      "title": "Adjunct - Nursing",
      "description": "The Bachelor of Science in Nursing (BSN) Program within the College of Health Professions (CHP) at Butler University invites applications for Adjunct Clinical Faculty positions beginning in Spring 2027 (January 2027).\n\nWe seek experienced registered nurses who are passionate about mentoring future nurses and facilitating high-quality clinical learning experiences in adult and gerontological healthcare settings. Adjunct Clinical Faculty play a critical role in helping students develop clinical judgment, professional identity, communication skills, and safe, evidence-based nursing practice.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/1832": {
      "title": "Head of Collection Services and Strategies, Butler Libraries",
      "description": "Butler University Libraries invites applications for the Head of Collection Services & Strategies. As part of the Library Leadership team, this role provides vision for a six‑person department responsible for acquisitions, resource sharing, electronic and print collections, and scholarly communication. As library faculty, it also includes liaison work such as instruction, collection development, and research support. Butler Libraries encourages innovative approaches and seeks a communicative, collaborative leader who values expertise and builds strong relationships across the library and campus. This is a 12‑month, continuing (non‑tenured) faculty appointment reporting to the Dean of Libraries.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2265": {
      "title": "Graduate Assistant, Operations - Recreation and Wellness",
      "description": "The Graduate Assistant for Operations supports the day-to-day management of the Health & Recreation Complex (HRC), ensuring the facility operates efficiently, safely, and in alignment with the mission of Recreation & Wellness. This position involves oversight of staffing, scheduling, facility maintenance, and coordination of special events. The Graduate Assistant will collaborate with professional staff and student employees to maintain a welcoming and inclusive environment while delivering high-quality service to all users. This role offers valuable experience in facility management, staff supervision, and operational logistics in a collegiate recreation setting.",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2252": {
      "title": "Assistant Professor - MSN Nursing",
      "description": "The Butler University Master of Science in Nursing Entry-to-Practice (MSN-ETP) program within the College of Health Professions (CHP) invites applications for a full-time, 12-month, assistant/associate professor position. This position is a non-tenure-track faculty appointment. The highly qualified candidate will have experience teaching nursing in classroom, clinical, laboratory, and simulation environments. \n",
      "department": null
    },
    "https://fa-exer-saasfaprod1.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/2260": {
      "title": "Assistant Professor - Kinesiology",
      "description": "The College of Education and Human Development (CEHD) at Butler University invites applications for a full-time, nine-month tenure-track faculty position with a start date of August 2027. The successful candidate will be a dynamic, motivated, and collaborative faculty member who will recruit and teach undergraduate students in the Kinesiology program, support and contribute to our Human Performance Lab, collaborate with the Butler Institute for Sports & Entertainment, and liaise with Athletics. Students in the Kinesiology major may choose to add concentrations in Pre-Professional Studies, Applied Human Performance, and/or a minor in Sport Coaching.",
      "department": null
    }
  },
