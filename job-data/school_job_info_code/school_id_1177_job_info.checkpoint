    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/239": {
      "title": "Public Safety Officer",
      "description": "The Public Safety Patrol Officer is responsible for ensuring the safety and security of all college property and community members, both on campus and on other College property.  Duties include patrolling the campus on foot and in college-owned vehicles; responding to emergencies and determining the appropriate course of action; responding to calls for service, conducting investigations, and writing reports; monitoring campus buildings, including fire alarm, system trouble alarm, and security video systems; providing security escort and unlock services for students and employees as requested; providing emergency first aid and/or requesting other medical services as needed; attending special events and sporting events; and enforcing parking regulations.  Officers must be willing to work a flexible schedule including weekdays, weekends, and holidays over three (3) shifts per day.\n",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/332": {
      "title": "Assistant Professor of Computer and Information Science",
      "description": "This is a tenure-track faculty position at the academic rank of Assistant Professor in the Computer and Information Science department. Primary responsibilities include teaching, scholarship, and service. This position reports to the Chair of Computer and Information Science. Primary responsibilities are teaching in computer and information science with a full-time course load which, given load calculations, equates to four courses, including labs, each year.  Ideal candidates will have experience and success teaching computational courses at the undergraduate college level and an active research agenda in computer and information science. Preference will be given to candidates whose research is in Systems or a related field. Candidates are expected to have a terminal degree at the time of appointment. ",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/333": {
      "title": "Assistant Professor of Computer and Information Science",
      "description": "This is a tenure-track faculty position at the academic rank of Assistant Professor in the Computer and Information Science department. Primary responsibilities include teaching, scholarship, and service. This position reports to the Chair of Computer and Information Science. Primary responsibilities are teaching in computer and information science with a full-time course load which, given load calculations, equates to four courses, including labs, each year.  Ideal candidates will have experience and success teaching computational courses at the undergraduate college level and an active research agenda in computer and information science. Preference will be given to candidates whose research is in Artificial Intelligence, Computer Security, or a related field. Candidates are expected to have a terminal degree at the time of appointment. ",
      "department": null
    },
