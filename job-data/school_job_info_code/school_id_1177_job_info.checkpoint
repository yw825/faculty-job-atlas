    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/338": {
      "title": "Grant Accountant or Sr. Grant Accountant",
      "description": "The grant accountant oversees the financial administration of federal, state, local, and private grants. This role ensures that all expenditures strictly align with grant agreements, prepares required financial reports, and coordinates fund draws or invoicing. Serve as the link between Foundation and Corporate Relations (FCR), programmatic staff, financial services, and funding age. Apply Generally Accepted Accounting Principles (GAAP) to maintain and analyze financial records and reports. Prepare comprehensive financial statements and reports, supporting informed decision-making and strategic planning.",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/351": {
      "title": "Executive Assistant to the CFO",
      "description": "Provides highly organized, proactive, and confidential executive-level administrative support to the Chief Financial Officer/Vice President of Finance and Administration (CFO) and coordinated support (if needed) to the  Finance and Operations division directors, including Finance, Human Resources, Physical Plant/Facilities, Information Technology, Campus Store, and Sustainability. Anticipates the CFO’s needs, exercises independent judgment, identifies issues before they become urgent, and ensures effective follow-through on priorities, commitments, and deadlines. Supports budget monitoring, expense reimbursements, purchase requisitions, board governance activities, and divisional operations while fostering teamwork, communication, and a service-oriented culture across campus.",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/350": {
      "title": "Adjunct Instructor of Communication, Media, and Performance",
      "description": "This is a part-time instructor position in the Dance and Movement Studies program. Primary responsibilities include teaching, scholarship, and service. This position reports to the Chair of the Department of Communication, Media and Performance. Primary responsibilities include teaching one two-credit course in jazz dance in the Dance and Movement Studies program for the spring 2027 semester.  Candidates should be able to teach all levels of jazz dance. Ideal candidates will have professional experience and/or success teaching jazz dance at the undergraduate college level. Candidates are expected to have at least a four-year degree at the time of appointment. \n\nInstructors will maintain professional effectiveness, including intellectual integrity, professional currency, and cooperation in all phases of the academic program.",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/347": {
      "title": "Adjunct Instructor of Communication, Media, and Performance",
      "description": "This is a part-time instructor position in the Dance and Movement Studies program. Primary responsibilities include teaching, scholarship, and service. This position reports to the Chair of the Department of Communication, Media and Performance. Primary responsibilities are teaching one two-credit course in ballet in the Dance and Movement Studies program for the spring 2027 semester.  Candidates should be able to teach all levels of ballet. Ideal candidates will have professional experience and/or success teaching ballet at the undergraduate college level. Candidates are expected to have at least a four-year degree at the time of appointment. \n\nInstructors will maintain professional effectiveness, including intellectual integrity, professional currency, and cooperation in all phases of the academic program.",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/342": {
      "title": "Adjunct Instructor of Biology",
      "description": "Allegheny College is seeking qualified adjunct faculty to teach Biology courses in support of an RN program. This is a part-time position that reports to the Chair of Biology. Primary teaching responsibilities include Anatomy and Physiology, Medical Microbiology, or Medical Terminology.  Ideal candidates will have experience and success teaching undergraduates or nursing students. Qualified candidates must have a master's degree or Ph.D. in a relevant discipline.  \n\nThe faculty member will maintain professional effectiveness, intellectual integrity, professional currency, and cooperation in all phases of the academic program.",
      "department": null
