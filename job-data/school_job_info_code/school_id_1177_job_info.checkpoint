  "raw": {
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/315": {
      "title": "Graphic Designer",
      "description": "The Graphic Designer will create a variety of design materials for campus partners, including Admissions, Institutional Advancement, Athletics and Recreation, and Student Life. They will manage project timelines, provide proofs, communicate with clients, and meet independently with clients to help coordinate projects at the discretion of the Director of Design and Publications. The Designer will keep the Director informed of project updates, deadlines, and overall progress while managing multiple projects and meeting deadlines. The ideal candidate is organized, collaborative, and comfortable balancing multiple projects and priorities.\n\n",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/302": {
      "title": "Associate Provost, Institutional Effectiveness",
      "description": "Reporting to the Provost and Dean of the Faculty, the Associate Provost of Institutional Effectiveness will provide leadership over Allegheny College’s planning, data collection, and assessment efforts. This highly visible position will partner with institutional leadership, staff and faculty to promote and support the mission and strategic planning of the college through the use of data and research to inform decisions and improve the institution. \nThe Associate Provost is responsible for developing and executing targeted research and analyses on a wide range of institutional and academic issues and synthesizing diverse data points into a coherent set of actionable findings and recommendations. The Associate Provost is also responsible for internal and external reporting to support compliance and accreditation. \n",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/294": {
      "title": "Assistant Professor of Communication, Media, and Performance",
      "description": "This is a tenure/tenure track faculty position at the academic rank of Assistant Professor in the Theatre Program. Primary responsibilities include teaching, scholarship, and service. This position reports to the Chair of the Communication, Media and Performance Department. Primary responsibilities are teaching in the Theatre program with a full-time course load which, given load calculations, equates to six courses per year. Additional responsibilities include directing an annual production in the Gladys Mullenix Black Theatre, which counts as one course per year. Ideal candidates will have experience and success teaching acting and directing at the undergraduate college level. Other desired areas may include acting for the camera, script analysis, introduction to theatre, community-based performance, and devised performance. Candidates are expected to have an MFA or PhD with significant performance background at the time of appointment. ",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/280": {
      "title": "Assistant Coach, Men's Lacrosse",
      "description": "The assistant coach is responsible for assisting the Head Coach in the administration of all aspects of the sport program including but not limited to coaching and teaching of students, recruiting, game and practice preparation and execution, fund-raising/friend raising, budget management, compliance with NCAA and conference rules/regulations, participation as a member of the College community and with all collaborative departmental functions as needed",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/256": {
      "title": "Assistant Professor of Biology",
      "description": "This is a tenure-track faculty position at the academic rank of Assistant Professor in the Biology Department. Primary responsibilities include teaching, scholarship, and service. This position reports to the Chair of Biology. Primary responsibilities are teaching in the Biology program with a full-time course load which, given load calculations, equates to 6 courses per year.  Ideal candidates will have experience and success teaching genetics at the undergraduate college level, and the ability to develop an active molecular-based research program in genetics with undergraduates.  Candidates are expected to have a PhD at the time of appointment. ",
      "department": null
    },
    "https://alleghenycollege-ibwwjb.fa.ocs.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_1/job/244": {
      "title": "ALIC Instructor",
      "description": "ALIC instructors will deliver engaging, hands-on instruction that prepares students with the technical knowledge, practical skills, and industry standards needed for success in their chosen career field. Instructors develop lesson plans, evaluate student performance, maintain a safe and inclusive learning environment, and integrate real-world applications into classroom and laboratory instruction. The instructor collaborates with colleagues and industry partners to ensure curriculum remains relevant, supports student achievement, and prepares learners for certifications, employment, and continued education. Instructors prepare clear syllabi, develop course learning outcomes and follow FERPA guidelines to protect student privacy.\n",
      "department": null
    },
