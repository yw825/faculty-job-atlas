/c/HRS_HRAM_FL.HRS_CG_SEARCH_FL.GBL?Page=HRS_APP_JBPST_FL&Action=U&FOCUS=Applicant&SiteId=1&JobOpeningId=63696&PostingSeq=1", "job_title_in_post": "Carpenter (Open Rank-Multiple Hires)", "position_type": "Assistant_Professor; Associate_Professor; Full_Professor", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://jobs.omni.fsu.edu/psc/sprdhr_er/EMPLOYEE/HRMS/c/HRS_HRAM_FL.HRS_CG_SEARCH_FL.GBL?Page=HRS_APP_JBPST_FL&Action=U&FOCUS=Applicant&SiteId=1&JobOpeningId=63630&PostingSeq=1": {"school_id": 261, "posting_url": "https://jobs.omni.fsu.edu/psc/sprdhr_er/EMPLOYEE/HRMS/c/HRS_HRAM_FL.HRS_CG_SEARCH_FL.GBL?Page=HRS_APP_JBPST_FL&Action=U&FOCUS=Applicant&SiteId=1&JobOpeningId=63630&PostingSeq=1", "job_title_in_post": "FAMU-FSU College of Engineering, Senior Grants Specialist", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "College of Engineering, Senior Grants Specialist", "area_key_words": "Engineering, Senior Grants Specialist", "deadline_of_application": "", "posted_date": "", "position_start_date": ""}, "https://jobs.omni.fsu.edu/psc/sprdhr_er/EMPLOYEE/HRMS/c/HRS_HRAM_FL.HRS_CG_SEARCH_FL.GBL?Page=HRS_APP_JBPST_FL&Action=U&FOCUS=Applicant&SiteId=1&JobOpeningId=63629&PostingSeq=1": {"school_id": 261, "posting_url": "https://jobs.omni.fsu.edu/psc/sprdhr_er/EMPLOYEE/HRMS/c/HRS_HRAM_FL.HRS_CG_SEARCH_FL.GBL?Page=HRS_APP_JBPST_FL&Action=U&FOCUS=Applicant&SiteId=1&JobOpeningId=63629&PostingSeq=1", "job_title_in_post": "FAMU-FSU College of Engineering, Senior Grants Specialist", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "College of Engineering, Senior Grants Specialist", "area_key_words": "Engineering, Senior Grants Specialist", "deadline_of_application": "", "posted_date": "", "position_start_date": ""}, "https://jobs.omni.fsu.edu/psc/sprdhr_er/EMPLOYEE/HRMS/c/HRS_HRAM_FL.HRS_CG_SEARCH_FL.GBL?Page=HRS_APP_JBPST