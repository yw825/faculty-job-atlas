isor", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://recruitingbypaycor.com/career/JobIntroduction.action?clientId=8a7883d061f94ddb0162022ae9e952fc&id=8a7887aca0abfca001a0ca82471f7b31": {"school_id": 1196, "posting_url": "https://recruitingbypaycor.com/career/JobIntroduction.action?clientId=8a7883d061f94ddb0162022ae9e952fc&id=8a7887aca0abfca001a0ca82471f7b31", "job_title_in_post": "Maintenance Mechanic 2", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://recruitingbypaycor.com/career/JobIntroduction.action?clientId=8a7883d061f94ddb0162022ae9e952fc&id=8a7885a8a03fc26101a05f6f0f6e3adf": {"school_id": 1196, "posting_url": "https://recruitingbypaycor.com/career/JobIntroduction.action?clientId=8a7883d061f94ddb0162022ae9e952fc&id=8a7885a8a03fc26101a05f6f0f6e3adf", "job_title_in_post": "Shared Administrative Assistant - Human Resources & Finance", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://recruitingbypaycor.com/career/JobIntroduction.action?clientId=8a7883d061f94ddb0162022ae9e952fc&id=8a7887aca0abfca001a0f3fc090871e7": {"school_id": 1196, "posting_url": "https://recruitingbypaycor.com/career/JobIntroduction.action?clientId=8a7883d061f94ddb0162022ae9e952fc&id=8a7887aca0abfca001a0f3fc090871e7", "job_title_in_post": "Digital Creator", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "", "deadline_of_application": "", "position_start_date": ""}, "https://recruitingbypaycor.com/career/JobIntroduction.action?clientId=8a7883d061f94ddb0162022ae9e952fc&id=8a78859fa064222601a08d174c28636b": {"school_id": 1196, "posting_url": "https://recruitingb