    "https://oregonstate.wd501.myworkdayjobs.com/job/Corvallis-Main-Campus/Instructor-Pool---2026-2027--Marketing--Analytics-and-Design_JR0000390": {
      "title": "Instructor Pool - 2026/2027: Marketing, Analytics and Design",
