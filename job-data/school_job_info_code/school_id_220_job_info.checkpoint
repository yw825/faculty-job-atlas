    "https://fau.wd1.myworkdayjobs.com/FAU/job/Clinical---Off-Campus-Location-COM-use-only/Gastroenterologist---Assistant-Associate-Full-Professor_REQ21638": {
      "title": "Gastroenterologist - Assistant/Associate/Full Professor",
