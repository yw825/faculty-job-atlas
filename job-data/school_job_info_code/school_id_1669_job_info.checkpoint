{"raw": {"https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8078": {"title": "Postdoc in Probabilistic Methods Sequential Decision-Making - DTU Compute", "description": "Post-doc position on probabilistic machine learning for decision-making under uncertainty. The project will investigate active inference as a framework for developing robust methods for sequential decision-making using data from several real-world use cases.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8024": {"title": "PhD in gas photonics - DTU Electro", "description": "As a PhD student at DTU Electro, you will conduct cutting-edge research in ultrafast nonlinear optics using gas-filled hollow-core fiber platforms. This 3-year position offers the opportunity to contribute to innovative research in a collaborative academic environment.\n\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7995": {"title": "Postdoc in gas photonics - DTU Electro", "description": "As a Postdoctoral Researcher at DTU Electro, you will conduct cutting-edge research in ultrafast nonlinear optics using gas-filled hollow-core fiber platforms. This 2-year position offers the opportunity to contribute to innovative research in a collaborative academic environment.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7991": {"title": "Postdoc in software systems integration, modeling, and simulation for sustainable datacenter fleets - DTU Compute", "description": "Postdoc at DTU Compute in the AEGIS Doctoral Network: build the shared interface schema, co-simulation framework, and benchmarks that integrate 15 PhD projects across 10 European partners, and publish the cross-cutting papers.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7941": {"title": "PhD Scholarship in Sustainable Supply Chain Management and Organization - DTU Management", "description": "Join an international PhD project at DTU, in collaboration with the University of Nairobi, exploring how global agricultural supply chains can be organized using regenerative approaches. Conducting research in Denmark and Kenya, you will help shape sustainable, community-based agri-food systems.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7895": {"title": "PhD Student in Computational Molecular Design - DTU Chemical Engineering", "description": "If you are interested about establishing your career in an interdisciplinary area related to chemical engineering, novel materials design and advanced computational methods and you are looking for the best possible foundation for fulfilling your dreams and ambitions, then you should consider this opportunity.\nWe invite you to apply for a PhD position on a newly established project at the Center of Energy Resources Engineering, DTU Chemical Engineering.\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7868": {"title": "PhD Scholarships in \u201clive\u201d electron microscopy in catalysis at the atomic-scale - DTU Physics", "description": "Join VISION to explore catalysts atom by atom in real time using cutting edge operando TEM. Be part of a world class, interdisciplinary environment pushing the frontier of \u201clive\u201d electron microscopy and shaping next generation catalytic science.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7870": {"title": "Postdoc in \u201clive\u201d electron microscopy in catalysis at the atomic-scale - DTU Physics", "description": "Drive the future of \u201clive\u201d electron microscopy at VISION. Work atom by atom, in real time, with cutting edge operando TEM and shape breakthrough catalytic science in a world class, interdisciplinary environment pushing the limits of discovery.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7807": {"title": "PhD scholarship in Self-Adaptive AI Systems and Embedded Intelligence - DTU Compute", "description": "We offer a PhD scholarship to contribute to the REGAIN-AI project, a newly established research initiative investigating reliability, sustainability, and self-adaptation in next-generation AI-enabled systems.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7791": {"title": "PhD position in Digital Payments and Critical Infrastructure - DTU Management", "description": "PhD position exploring how transactional vulnerability is conceptualized and operationalized by the organisations governing digital payments infrastructure. \nQualitative research focus.\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8189": {"title": "PhD scholarship in AI-Augmented Sense-Making in Digital Phenotyping - DTU Health Tech", "description": "PhD project developing LLM-powered, interactive AI tools for exploring large-scale digital health data from smartphones and wearables. You will combine AI, data science and human-computer interaction to help researchers explore complex data, discover patterns and generate new health insights.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8188": {"title": "Postdoc in Public Administration; AI & Citizen Engagement - DTU Management", "description": "Join DTU as a Postdoc exploring how AI can strengthen democratic governance and citizen engagement. Work with Aarhus Municipality to develop and evaluate AI models representing diverse public perspectives in sustainability transitions through ethnographic fieldwork and collaboration.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8172": {"title": "Associate Professor or DTU Tenure Track Assistant Professor in High-Performance Computing - DTU Compute", "description": "DTU Compute seeks a tenure-track assistant professor or associate professor in HPC, including programming models, compilers, operating systems or computer architecture. We encourage applicants with interests in energy efficiency and quantum computing.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8162": {"title": "PhD scholarship in Sustainable Finance with Focus on Climate Banking - DTU Management", "description": "The Climate and Energy Policy Division at DTU Management invites applications for a three-year PhD scholarship in climate banking. The scholarship is linked to a project focusing on how banks and financial markets can help accelerate the transition to a low-carbon energy system while managing climate-related risks.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8134": {"title": "PhD Scholarship in Natural Product Chemistry - DTU Bioengineering", "description": "We are looking for a highly motivated natural product chemist to characterize bioactive secondary metabolites and their biosynthesis through different omics techniques.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8137": {"title": "Postdoc position in Galaxy Formation - DTU Space", "description": "This position is offered within the field of Galaxy Formation as part of the ERC-funded `PRIMORDIAL\u2019 project led by Assoc. Prof. Kasper E. Heintz. One Postdoc position will be available, focusing on star and galaxy formation in the early Universe with cutting-edge data from JWST and ALMA.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8138": {"title": "PhD scholarship in Galaxy Formation - DTU Space", "description": "Two PhD positions are offered within the field of Galaxy Formation as part of the ERC-funded `PRIMORDIAL\u2019 project led by Assoc. Prof. Kasper E. Heintz. The projects focus on star and galaxy formation in the early Universe with cutting-edge data from JWST and ALMA.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8145": {"title": "Lektor i klinisk innovation ved DTU og Region \u00d8st (Teknisk Universitetshospital - TUH)", "description": "Hvis du er forsker ansat i Region Hovedstaden eller Region Sj\u00e6lland (kommende Region \u00d8stdanmark) med interesse for innovation og tv\u00e6rfagligt samarbejde, tilbyder denne stilling en unik mulighed for at pr\u00e6ge og styrke innovation i den kliniske hverdag. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8141": {"title": "Postdoc in Engineering Leadership in a Changing World - DTU Management", "description": "If you would like to contribute to knowledge creation within the emerging research and educational field of Engineering Leadership in a rapidly changing world, this position offers a unique opportunity.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8088": {"title": "Marie Sk\u0142odowska-Curie PhD fellowship in Learning and Optimization Algorithms for Carbon-Aware Datacenter Fleets - DTU Compute", "description": "MSCA PhD fellowship in the AEGIS Doctoral Network: learning and optimization algorithms that orchestrate fleets of grid-interactive datacenters. A software and algorithms project; strong algorithms and data structures required, prior datacenter knowledge is not.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8087": {"title": "PhD Scholarship in Development of Cement-Free Living Building Materials for Sustainable Construction - DTU Construct", "description": "Do you want to launch your scientific career by developing the next generation of living building materials for sustainable construction?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8100": {"title": "PhD scholarship in AI-Driven Optimization of Optical Links based on Nano-Lasers - DTU Electro", "description": "As a PhD student at DTU Electro, you will develop an AI-driven optimization framework \u2014 spanning gradient-based learning, reinforcement learning, and physics-informed neural networks. And apply it to realize power-efficient transmitter and receiver architectures through both algorithm development and experimental testing.\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8192": {"title": "Want to help rethink the foundation of the internet? Become a PhD student at DTU Electro", "description": "You will join an international research environment developing new ways of transmitting data - more energy-efficiently, more scalably, and with fewer active components.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8194": {"title": "Process Specialist for E-beam and UV Lithography - DTU Nanolab", "description": "DTU Nanolab seeks an experienced process specialist in e-beam and UV lithography. The role includes process development, equipment maintenance, QC, and user training on advanced lithography systems. Ideal candidates have an MSc/PhD and strong cleanroom, e-beam, and UV lithography expertise. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8208": {"title": "PhD scholarship in Mathematical Modeling for Health Policy - DTU Management", "description": "The DTU Department of Management seeks a PhD candidate in operations management to complete a funded health policy modeling research project. The ideal candidate will have a desire to improve health policy through mathematical modeling and have a background in management science, computer science, quantitative health policy, or a related field.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8209": {"title": "PhD scholarship in CO2 valorization by integrated electrochemistry and chemical catalysis - DTU Chemistry", "description": "PhD position at DTU Chemistry on integrated electrocatalytic CO2 valorization. Join an international, interdisciplinary project with KTH to develop sustainable catalytic processes for decarbonized chemical manufacturing.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8215": {"title": "Associate Professor or DTU Tenure Track Assistant Professor in Sustainable Travel Behaviour - DTU Management", "description": "Are your interests within sustainable travel behaviour? DTU Management is looking for an Associate Professor or Tenure Track Assistant Professor in Sustainable Travel Behaviour to join our Transportation Science Division. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8220": {"title": "Administrationschef - DTU Kemiteknik", "description": "Vil du st\u00e5 i spidsen for en st\u00e6rk administration og v\u00e6re en central del af ledelsen p\u00e5 et internationalt f\u00f8rende institut i udvikling, hvor vi hver dag arbejder m\u00e5lrettet p\u00e5 at l\u00f8se nogle af samfundets vigtigste industrielle udfordringer?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8218": {"title": "PhD Scholarships in Engineering of Quantum Light Sources and System Architecture for Photonic Quantum Computing - DTU Electro", "description": "The Quantum Light Sources Group at DTU Electro is seeking candidates for PhD Scholarships in the field of design, simulation and optical characterization of highly efficient solid-state sources of single indistinguishable photons as well as in the engineering of system architecture for photonic quantum information technology. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8232": {"title": "Postdoc in Entrepreneurship and Innovation for Regenerative Food Systems - DTU Entrepreneurship", "description": "Would you like to contribute to research shaping the transition towards regenerative food systems? Do you want to explore how research, technology, entrepreneurship, policy, and diverse ecosystem actors can come together to enable more resilient and regenerative food systems? Are you interested in understanding how scientific knowledge and emerging technologies can be translated into new ventures, scalable solutions, and meaningful societal impact?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8227": {"title": "Postdoc in nanoscale quantum imaging with scanning NV magnetometry - DTU Energy", "description": "Nanoscale quantum imaging unlocks new insight into functional processes in materials and devices. This position will use a unique cryogenic setup with scanning NV magnetometers to study solid-state materials and batteries.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8231": {"title": "Postdoc in Integrating in-line Vision Technology and AI for Improved Concrete Production - DTU Construct", "description": "We are seeking a full-time Postdoc on concrete process monitoring to join us in DTU Construct. This position is a part of the granted Innovation Fund Denmark project; VISTACON, Integrating in-line vision technology and AI for improved concrete production.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8236": {"title": "Business Controller - budget og \u00f8konomistyring - Afd. for \u00d8konomi og Regnskab", "description": "Vil du have sp\u00e6ndende ansvar, worklife balance og bidrage til at skabe en bedre verden? V\u00e6rsgo \u2013 s\u00e5 er jobbet her!", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8239": {"title": "Postdoc in the molecular mechanisms and evolution of fungal antimicrobial resistance - DTU Bioengineering", "description": "Postdoc in the molecular mechanisms and evolution of fungal antimicrobial resistance (fAMR). Do you want to improve our understanding of fAMR and help potentially reduce the use of fungicides in agriculture? Consider joining our team as our new postdoctoral researcher.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8255": {"title": "Research Assistant in sustainable food fermentation and ingredient prototyping - BRIGHT", "description": "Work hands-on with fermentation and food prototyping to valorize side streams into delicious ingredients, combining culinary practice, microbiology, enzymatic work, and product analysis.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8261": {"title": "\u00d8konomielever - Afd. for \u00d8konomi og Regnskab", "description": "Kunne du t\u00e6nke dig en sp\u00e6ndende og alsidig uddannelse inden for \u00f8konomi p\u00e5 Danmarks f\u00f8rende tekniske universitet? DTU er de seneste to \u00e5r blevet rangeret som Europas bedste tekniske universitet, og nu har du mulighed for at blive en del af vores \u00f8konomiteam.  Opstart i februar/marts og september 2027.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8249": {"title": "PhD scholarship in Technology-Enabled Urban Logistics, Curbside Management and Sustainable Urban Planning - DTU Engineering Technology", "description": "PhD opportunity at DTU! Explore how cargo bikes, drones, micro-hubs, robots and EVs can transform urban logistics and help create cleaner, smarter and more liveable cities. Join an international research collaboration connecting Copenhagen and Munich.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8254": {"title": "PhD scholarship in small-scale coastal fishing methods - DTU Aqua", "description": "If you have a keen interest in small scale coastal fisheries and fishing methods, this may be the perfect position for you.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8256": {"title": "Postdoc in Microbial Food Engineering - BRIGHT", "description": "Do you want to design the microbial foods of the future? You will use metabolic engineering, advanced analytics, machine learning, and fermentation technologies to create novel, well-tasting sustainable meat alternatives based on edible yeasts. The project is a part of the Microbial Foods mission at BRIGHT.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8260": {"title": "PhD scholarship in Microbial Food Engineering - BRIGHT", "description": "Do you want to design the microbial foods of the future? You will use metabolic engineering, advanced analytics, machine learning, and fermentation technologies to create novel, well-tasting sustainable meat alternatives based on edible yeasts. The project is a part of the Microbial Foods mission at BRIGHT.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8265": {"title": "Erfarne p\u00e6dagogiske konsulenter til kompetenceudvikling og undervisning - Afd. for Uddannelse og Studerende", "description": "Har du lyst til at bidrage til udviklingen af fremtidens ingeni\u00f8rundervisning? Er Student Centered Learning, Constructive Alignment og Conceptual Understanding DNA\u2019en i din praksis, og br\u00e6nder du for at facilitere kompetenceudvikling hos nye og erfarne universitetsundervisere i en tid, hvor digitale teknologier og AI \u00e6ndrer l\u00e6ringsprocesser, undervisning og eksamen?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8267": {"title": "Evalueringsmedarbejdere til uddannelsesudvikling - Afd. for Uddannelse og Studerende", "description": "Vil du have en n\u00f8glerolle i at skabe kvalitetsuddannelser for fremtidens ingeni\u00f8rer? Interesserer du dig for uddannelsesudvikling? Og kan du skabe dialog, bygge relationer og holde snor i sidel\u00f8bende processer og opgaver? \n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8273": {"title": "Laborantpraktikant til DNA-analyser - DTU Aqua (Silkeborg)", "description": "Er du i gang med laborantuddannelsen og interesseret i DNA-analyse, genetik og molekyl\u00e6rbiologi? S\u00e5 har du nu mulighed for at f\u00e5 et sp\u00e6ndende praktikophold i et f\u00f8rende forskningsmilj\u00f8!\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8281": {"title": "PhD scholarship in Sustainable Indoor Solar Cells for Ambient Light Energy Harvesting in IoT Applications - DTU Electro", "description": "Are you interested in developing thin-film solar cells designed to operate efficiently under indoor lighting and thereby contributing to the green transition? At DTU Electro, you will have the opportunity to break new ground by harvesting energy from ambient light and help pave the way towards sustainable technologies.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8280": {"title": "Laborantpraktikant p\u00e5 DTU Energi", "description": "Er du i gang med at uddanne dig til laborant og p\u00e5 udkig efter en sp\u00e6ndende praktikmulighed?\nDTU Energi, Team Chemistry s\u00f8ger en motiveret og samarbejdsorienteret laborantpraktikant til en 1-\u00e5rig praktikstilling med start den 1. februar 2027.\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8285": {"title": "Postdoc in Decision Modeling for Health Policy - DTU Management", "description": "The DTU Department of Management seeks a Postdoctoral Research Fellow in operations management to complete a funded health policy modeling research project. The ideal candidate will have a desire to improve health policy through mathematical modeling and have a background in management science, computer science, quantitative health policy, or a related field.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8270": {"title": "Eventkoordinatorelev - DTU Skylab", "description": "DTU Skylab s\u00f8ger en eventkoordinatorelev, der br\u00e6nder for eventplanl\u00e6gning og trives i et tempofyldt milj\u00f8. Opgaverne inkluderer planl\u00e6gning, markedsf\u00f8ring og afvikling af events. Ideelle kandidater er selvst\u00e6ndige, strukturerede, kreative og flydende i dansk og engelsk. Kvalifikationer inkluderer relevant uddannelsesbaggrund.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8303": {"title": "PhD scholarship in Silicon Optomechanics and Light-Matter Interaction at the Deep Nanoscale - DTU Electro", "description": "Join the next generation of European quantum technology researchers. DTU Electro invites applications for a fully funded Marie Sk\u0142odowska-Curie Doctoral Candidate position, within the Horizon Europe Doctoral Network QUEST \u2013 Quantum Electrodynamics with Silicon Nanotechnology.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8304": {"title": "PhD scholarship in Quantum Optical Measurements of Extreme Light-Matter Interaction - DTU Electro", "description": "Join the next generation of European quantum technology researchers. DTU Electro invites applications for a fully funded Marie Sk\u0142odowska-Curie Doctoral Candidate position, within the Horizon Europe Doctoral Network QUEST \u2013 Quantum Electrodynamics with Silicon Nanotechnology. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8305": {"title": "PhD scholarship in Silicon Quantum Electrodynamics at the Deep Nanoscale - DTU Electro", "description": "Join the next generation of European quantum technology researchers. DTU Electro invites applications for a fully funded Marie Sk\u0142odowska-Curie Doctoral Candidate position, within the Horizon Europe Doctoral Network QUEST \u2013 Quantum Electrodynamics with Silicon Nanotechnology. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8302": {"title": "Marketing- og kommunikationsansvarlig (barselsvikariat) (Space Ventures Denmark) - DTU Space", "description": "Tag ejerskab over Space Ventures Denmarks marketing og kommunikation \u2013 kanaler, indhold, brand og events \u2013 led to studentermedhj\u00e6lpere og fort\u00e6l historien om 50+ danske startups p\u00e5 vej ind i rumindustrien.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8308": {"title": "PhD scholarship in Quantum Photovoltaics in Twisted 2D Materials - DTU Electro", "description": "Are you interested in atomically thin materials and curious about how twisting and stacking them can create unconventional photovoltaic effects that emerge without conventional p\u2013n junctions? Do you want to develop expertise at the intersection of 2D materials, nonlinear optics, nanofabrication, and photovoltaic device physics?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8309": {"title": "PhD scholarship in High-Speed Hyperspectral and Super-Resolution Terahertz Imaging - DTU Electro", "description": "Are you interested in pushing terahertz (THz) imaging beyond today\u2019s limits in speed, bandwidth, and spatial resolution? At DTU Electro, you will work at the interface of ultrafast THz photonics, nonlinear optical detection, coherent imaging, and machine learning to develop a new generation of high-speed hyperspectral THz imaging technology.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8312": {"title": "PhD scholarship in Synthetic Biology of Actinobacteria, producers of agriculturally relevant metabolites - BRIGHT", "description": "A PhD position for a student interested in developing novel methods for genetic engineering and molecular biology of natural product producing microorganisms. This PhD position is in collaboration with KAIST (South Korea), where PhD student will have an opportunity for research stay.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8287": {"title": "Postdoc in High-Speed Nonlinear Terahertz Imaging - DTU Electro", "description": "Are you interested in developing new technologies for high-speed terahertz (THz) imaging? At DTU Electro, you will work at the interface of ultrafast THz photonics, nonlinear optics, and coherent imaging to develop a new generation of broadband THz imaging technology.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8290": {"title": "Two DTU Tenure Track Assistant Professors in Theory and Freestanding Oxide Membranes for Energy Applications - DTU Energy", "description": "The Department seeks applicants for two tenure track assistant professor positions focused on freestanding oxide membranes, i.e., ultrathin oxide films released from their growth substrate, which can be stacked and twisted to create innovative interfaces acting as ionic and/or electronic (super)conductors. The positions will be hosted jointly by the Section for Atomic Scale Materials Modelling (ASM) and the Section for Functional Oxides (FOX): one position is devoted to the theoretical and computational design of these materials (based in ASM), and the other to their fabrication and characterization of these oxide membranes (based in FOX).", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8296": {"title": "PhD scholarship in Nanostructured 2D Materials and van der Waals Heterostructures for Advanced Optoelectronics - DTU Electro", "description": "Are you interested in engineering materials at the atomic scale and exploring how nanoscale structures can enable new optoelectronic functionalities? At DTU Electro, you will have the opportunity to break new ground in 2D materials and create artificial material architectures with properties that go beyond those of naturally occurring materials.\n\nWe are seeking a candidate for a PhD Scholarship in Nanostructured 2D Materials and van der Waals Heterostructures for Advanced Optoelectronics. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8298": {"title": "Laborantpraktikant til molekyl\u00e6rbiologi, fysiologi og histologi hos DTU Aqua (Lyngby)", "description": "Vi s\u00f8ger en laborantpraktikant til vores forskningsgruppe Fiskebiologi, der forsker i fisks fysiologiske processer og morfologiske strukturer. Du bliver uddannet i molekyl\u00e6re og histologiske laboratoriemetoder samt fysiologiske m\u00e5leteknikker.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8316": {"title": "Postdoc position for Investigating the Non-Scalable Quantum Size Regime in Catalysis - DTU Physics", "description": "The position is at the SurfCat section at the Department of Physics at the Technical University of Denmark. Here we enjoy a social, open and transparent scientific environment.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8324": {"title": "Postdoc in Direct Air Capture (DAC) - DTU Chemical Engineering", "description": "We are looking for two skilled postdocs to join our Direct Air Capture (DAC) research group. Direct Air Capture and Power-to-X technologies are expected to play key roles in achieving net-zero emissions and supporting the green energy transition.\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8318": {"title": "Postdoc in Large Language Models and Agentic AI for Pathogen Analysis - DTU Food", "description": "Join the AI Research Team at DTU\u2019s Global Pathogen Analysis Platform (GPAP) as a postdoc developing LLMs and agentic AI for metadata processing and pathogen analysis. Advance LLM post-training, lead research projects and turn your methods into tools for researchers and public health professionals.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8319": {"title": "Administrations- og \u00f8konomikoordinator - Danish Data Science Academy", "description": "Vi s\u00f8ger en administrations- og \u00f8konomikoordinator der skaber overblik, f\u00e5r processerne til at h\u00e6nge sammen og sikrer, at b\u00e5de \u00f8konomi og administration fungerer i hverdagen. Du motiveres af, at regnskabet stemmer, har teknisk flair, og \u00f8jner muligheder i AI. Med engagement og overblik forbinder du kollegaer og vores faglige netv\u00e6rk.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8322": {"title": "Kommunikationsmedarbejder til gymnasietilbud og information om DTU's ingeni\u00f8ruddannelser \u2013 Afd. for Kommunikation og Medier (vikariat)", "description": "Vil du v\u00e6re med til at bringe DTU t\u00e6ttere p\u00e5 kommende studerende? Vi s\u00f8ger en kommunikationsmedarbejder, der kan udvikle og koordinere tilbud til gymnasieelever og bidrage til kommunikation og arrangementer om DTU\u2019s ingeni\u00f8ruddannelser.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8176": {"title": "Research Assistant in Fungal Immunology - DTU Health Tech", "description": "One fully funded research assistant position starting early 2027. The project will investigate the cellular and molecular mechanisms underpinning fungal meningitis using in vivo mouse models", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8323": {"title": "Postdoc in Satellite Glaciology - DTU Space", "description": "DTU Space is looking for a postdoc repurposing the SWOT (Surface Water and Ocean Topography) satellite mission to detect subtle ice sheet elevation changes caused by meltwater moving through the ice sheet\u2019s subglacial drainage system.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8326": {"title": "Institutdirekt\u00f8r til DTU Electro", "description": "Vil du st\u00e5 i spidsen for et af Europas st\u00e6rkeste forskningsmilj\u00f8er inden for elektroteknologi og fotonik?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8327": {"title": "PhD scholarship on Data-driven Design and Analysis of Architected Materials - DTU Engineering Technology", "description": "DTU Engineering Technology offers a 3-year PhD position that integrates generative design, mechanics, and interpretable machine learning techniques to develop a rigorous, data-centric framework towards novel architected materials with superior mechanical properties.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8328": {"title": "Specialist laboratory technician - DTU Food", "description": "Specialist lab technician responsible for molecular and histological assessments. High expertise with techniques such as RNA-scope, IHC, histology staining, alongside active involvement in projects on reproductive toxicology.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8329": {"title": "Institutdirekt\u00f8r til DTU Sustain", "description": "Vil du v\u00e6re med til at forme samfundets b\u00e6redygtige omstilling?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8332": {"title": "Student Assistant with an interest in science and international collaboration - DTU Physics", "description": "Help us run SPARKLE, a Marie Sk\u0142odowska-Curie Doctoral Network coordinated by DTU Physics. As student assistant you will handle communication and social media, collect the scientific output of the network and help organise events with partners across Europe.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8338": {"title": "PhD scholarship in Antifungal Resistance at the Food\u2013Environment Interface - DTU Food", "description": "Antimicrobial resistance is not just a bacterial problem. Join DTU National Food Institute for a PhD on antifungal resistance at the food\u2013environment interface, combining microbiology, genomics, data science and risk assessment. Ideal for someone who enjoys both the bench and the command line.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8336": {"title": "Postdoc in Cyber-Security and Cyber-Deception - DTU Compute", "description": "We are seeking a postdoctoral researcher in cybersecurity to join the PSYFIND project. You will conduct research in cyber-deception, empirical security, and adaptive defense, working with an interdisciplinary team at DTU and the University of Copenhagen.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8339": {"title": "Parttime Tech Entrepreneur in Residence - DTU Space", "description": "The European Space Agency Business Incubation Center Denmark is looking for a hands-on business developer with a strong technical foundation to join our team part time.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8143": {"title": "Studentermedhj\u00e6lper til Team Management Support - DTU Wind", "description": "Vi s\u00f8ger en studentermedhj\u00e6lp til vores administrationsteam p\u00e5 DTU Vind og Energisystemer. F\u00e5 adgang til teknologisk udvikling p\u00e5 f\u00f8rste r\u00e6kke til den gr\u00f8nne omstilling og hj\u00e6lp os med at st\u00f8tte den.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8397": {"title": "Postdoc (Project Manager) for the European Doctoral Network in Multimaterial Additive Manufacturing (MultiMAM) - DTU Construct", "description": "Join us as Postdoc (Project Manager) for the Horizon Europe Doctoral Network MultiMAM. Coordinate an international consortium of leading universities and industry partners and help shape the future of multi-material additive manufacturing across Europe.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8432": {"title": "Projektleder med teknisk og tv\u00e6rfaglig baggrund - DTU Campus Service", "description": "DTU tilstr\u00e6ber at skabe et levende campusmilj\u00f8 til gl\u00e6de for forskere, undervisere og studerende, og i sidste ende til gavn for samfundet. Vil du v\u00e6re med til at bidrage til denne fortsatte udvikling og tilpasning af DTU\u2019s campusser - bygninger og infrastruktur?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8427": {"title": "Postdoc in Technology-Supported Home-Based Treatment - DTU Health Tech", "description": "We are looking for a postdoctoral researcher to join the Technical University Hospital (TUH) Signature Program on Technology-Supported Home-Based Treatment. The program brings together DTU and hospitals across Eastern Denmark to develop, evaluate, and implement technologies that support safe and effective treatment outside hospitals. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8420": {"title": "PhD scholarship in Situational Awareness for Resilient Operation of Distribution Grids - DTU Wind", "description": "PhD project on resilient distribution grids: develop situational awareness and control methods enabling microgrids to operate autonomously as islands during outages. Combining grid, DER, and surveillance data, the project aims to secure critical loads, improve recovery, and strengthen electricity supply resilience.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8424": {"title": "Research Assistant for Product Development - DTU Food", "description": "DTU National Food Institute seeks a research assistant to support product development, workshops, surveys and field activities in an international development project.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8423": {"title": "Postdoc in Soil Microbiome Assembly - DTU Bioengineering", "description": "We seek a highly motivated Postdoc to study the assembly of soil microbiomes with field and lab experiments using molecular and microbiological methods.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8421": {"title": "Postdoc in Generative AI for Multisensory Experience - DTU Engineering Technology", "description": "Develop and evaluate generative AI models that learn how individuals integrate sound, vision, and touch under uncertainty. The postdoc combines multisensory perception, machine learning, experimental XR, and human-centered interaction to test whether personal models can predict experience and generate more accessible XR interactions.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8425": {"title": "Struktureret eventkoordinator med sans for planl\u00e6gning, samarbejde og gode oplevelser - Afd. for Policy & Relationer", "description": "Vil du skabe professionelle events og gode oplevelser p\u00e5 DTU? Bliv en del af eventteamet i Stakeholder Management og v\u00e6r med til at skabe nogle af DTU\u2019s st\u00f8rste arrangementer. Vi s\u00f8ger dig, der skaber overblik, har sans for detaljer og trives med samarbejde.\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8409": {"title": "Postdoc in Systematic Characterization and Improvement of Bacterial Cell Factories for the Utilization of Power-to-X Feedstocks - BRIGHT", "description": "Characterize and engineer microbial cell factories for growth on sustainable P2X feedstocks. You will combine phenotypic assays and multi-omics to understand and improve microbial fitness on C1 and C2 carbon sources \u2014 driving the transition to a circular bioeconomy at DTU.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8412": {"title": "\u00d8konomimedarbejder med flair for tal - Afd. for \u00d8konomi og Regnskab (Hirtshals)", "description": "\u00d8konomimedarbejder med flair for tal \u2013 bliv en del af projekt\u00f8konomien p\u00e5 DTU i Hirtshals. Kan du lide at have styr p\u00e5 tallene, have en mening med dit job, udvikling, fleksibilitet og gode kolleger? S\u00e5 har vi m\u00e5ske jobbet til dig.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8411": {"title": "Konsulent med fokus p\u00e5 administration, digitalisering og forskningsst\u00f8tte - DTU Energy", "description": "Vil du bruge dine kompetencer som administrativ ankerperson i et internationalt forskningsmilj\u00f8, og hj\u00e6lpe os med at hj\u00e6lpe forskerne? Hos os f\u00e5r du ansvar, indflydelse og mulighed for at udvikle dig i et st\u00e6rkt fagligt f\u00e6llesskab.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8410": {"title": "Postdoc in Biomass Valorisation for Application in Textiles - DTU Bioengineering", "description": "We are looking for a Postdoc with experience in the areas of Biomass Fractionation and Fermentation to start the activities from the 1st of February 2027. The candidate will work on a project focused on the production of biobased molecules from lignocellulosic biomass for application in textiles.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8416": {"title": "PhD Position in Entrepreneurship, AI, and Labor Market Disruption - DTU Entrepreneurship ", "description": "Join DTU Entrepreneurship as a PhD researcher to investigate how AI and automation reshape entrepreneurial transitions and outcomes. Collaborate with international scholars at DTU, EPFL, and Northeastern University, using survey, registry, and qualitative data.\n\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8417": {"title": "PhD Scholarship in Machine Learning for Non-Stationary and Non-Static Nano-Tomography - DTU Compute", "description": "Join DTU Compute as a PhD student and help develop neural representation methods for dynamic X-ray nano-tomography. Work at the intersection of machine learning, computer vision, and computational imaging in collaboration with leading researchers at PSI and EPFL.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8418": {"title": "Special Consultant for HealthTech Innovation and Venture Development \u2013 DTU Entrepreneurship", "description": "Help build a coherent pathway from unmet clinical needs to investable HealthTech ventures. You will coordinate the TUH innovation pipeline, connect M.Sc.-education and clinical innovation, mature selected opportunities, and strengthen links to industry, investors and funding.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8419": {"title": "Postdoc in Academic Entrepreneurship and Innovation Ecosystems - DTU Entrepreneurship", "description": "Join DTU Entrepreneurship to study how universities, industry and investors can strengthen academic spin-offs. You will also evaluate challenge-driven innovation across European ecosystems and develop research and policy insights with international partners.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8396": {"title": "Electronics Engineer - DTU Electro", "description": "We are looking for a skilled and curious electronics engineer with an interest in developing electronics and software solutions for various interesting research and development projects in the intersection between optics and electronics. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8403": {"title": "PhD scholarship in Dynamic Food System Modelling - BRIGHT", "description": "The PhD student in dynamic food system modelling will build on the Absolute Environmental Sustainability Assessment (AESA) framework to develop dynamic modelling approaches for sustainability assessments of microbial foods and food system transformations.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8404": {"title": "Postdoc in Metabolic Engineering of Thermofiles - BRIGHT", "description": "Are you passionate about sustainability and reducing environmental impact through biomanufacturing? Then come join us in advancing technologies for developing robust microbial cell factories and scalable bioprocesses that convert CO\u2082-derived feedstocks into high-volume chemicals. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8405": {"title": "Postdoc in Anaerobic Metabolic Engineering - BRIGHT", "description": "Are you passionate about sustainability and reducing environmental impact through biomanufacturing? Then come join us in advancing technologies for developing robust microbial cell factories and scalable bioprocesses that convert CO\u2082-derived feedstocks into high-volume chemicals. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8398": {"title": "PhD in Light-Activated Micromotors for Biomedical Applications - DTU Health Tech", "description": "A PhD position at DTU Health Tech developing light-activated micromotors for biomedical applications. Explore micromotor design, biomimetic models, and active transport in complex and confined biological environments.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8408": {"title": "Postdoc in the Development of Micromotor Technologies to Overcome Biofilm Barriers in Hidradenitis Suppurativa - DTU Health Tech", "description": "A postdoctoral position at DTU Health Tech focusing on near-infrared light-activated micromotors to overcome biofilm barriers in Hidradenitis Suppurativa. Join an interdisciplinary team to explore active propulsion for biofilm disruption and advance therapies for diffusion-limited infections.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8407": {"title": "Postdoc in Biomass Fractionation and Valorization - DTU Bioengineering", "description": "We are looking for a Postdoc with experience in the areas of Biomass Fractionation and Valorisation to start the activities from the 1st of March 2027. The candidate will work on a project focused on the extraction of pectin from lignocellulosic biomass including process optimization and scale-up.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8384": {"title": "Proaktiv og serviceminded IT-supporter elev s\u00f8ges til DTU Bioengineering", "description": "Vi er et internationalt f\u00f8rende universitetsinstitut med cirka 400 ansatte, hvoraf hovedparten er videnskabeligt personale. Du kan forvente en grundig opl\u00e6ring.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8386": {"title": "Head of Dosimetry - DTU Health Tech", "description": "Lead a unique scientific and application-driven facility delivering internationally recognised industrial and medical dosimetry expertise. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8389": {"title": "Projektleder: F\u00e5 AI-forskning til at virke i danske virksomheder - DTU Compute", "description": "Bliv projektleder for DTU Computes samarbejde med erhvervslivet om AI og digitalisering. Du leder programmer som AI Denmark og AI Boost, styrker vores efteruddannelse og bringer virksomheder og forskere sammen \u2013 til gavn for samfundet.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8395": {"title": "Senior Downstream Engineer for a World-Class Pilot Plant - BRIGHT", "description": "As a Senior Downstream Engineer and Project Lead, you will lead projects involving fermentation and downstream process development. You will work closely with fermentation engineers, researchers, start-ups, technology providers, and industrial partners.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8394": {"title": "Postdoc in Coupled Processes for Underground Storage Applications - DTU Offshore", "description": "Are you interested in contributing to research that supports the energy transition through innovative subsurface technologies? At DTU Offshore, you will have the opportunity to work on scientific and engineering challenges related to underground energy and fluid storage systems. We are seeking a motivated postdoctoral researcher to contribute to research on coupled processes in geological formations and their implications for the performance of subsurface storage technologies. You will join an international research environment and collaborate with academic and industrial partners on projects related to carbon storage, geothermal energy, hydrogen storage, and other subsurface applications.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8390": {"title": "Student Assistants for X-ray CT Data and DANFIX Activities at 3DIM - DTU Physics", "description": "Join 3DIM at DTU Physics as a Student Assistant. Work with CT data acquisition, analysis and visualization, contribute to DANFIX operations and projects, and explore how CT is used to investigate many different materials.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8393": {"title": "Postdoc in Bayesian Networks for Environmental Health Research - DTU Food", "description": "The DTU National Food institute is seeking a Postdoc in Bayesian Networks for Environmental Health Research.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8391": {"title": "DTU s\u00f8ger nyt bestyrelsesmedlem", "description": "Bestyrelsen for Danmarks Tekniske Universitet (DTU) s\u00f8ger et nyt bestyrelsesmedlem pr. 1. januar 2027. DTU\u2019s Udpegningsudvalg opfordrer derfor potentielle kandidater til at indstille sig til den ledige post.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8358": {"title": "Academic employee for the project ArcFresh \u2013 Freshwater flux in and out of the Arctic Ocean - DTU Space", "description": "We are looking for a skilled and committed academic employee (part-time) to process primary datasets from ESA's CryoTEMPO Polar Ocean data (TEMPO).\nSatellite data must be converted into freshwater transport estimates through the individual gates in the Arctic. Comparisons and validation with observational and model datasets must be made to assess the quality of these data and the calculated transports.\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8375": {"title": "Projektleder - DTU Campus Service", "description": "Har du lyst til at arbejde i en af landets st\u00e6rkeste bygherreorganisationer og v\u00e6re med til at udvikle bygninger og fysiske rammer af h\u00f8j kvalitet til forskning og uddannelse? Hos CAS Bygherre f\u00e5r du mulighed for at lede sp\u00e6ndende og komplekse byggeprojekter p\u00e5 DTU's campusser og blive en del af en organisation, hvor faglighed, samarbejde, kvalitet og b\u00e6redygtige l\u00f8sninger g\u00e5r h\u00e5nd i h\u00e5nd.\n\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8374": {"title": "Postdocs in Experimental Quantum Optical Information - DTU Physics", "description": "Join DTU Physics as one of four experimental postdocs in quantum opto-acoustics, CV quantum communication or CV quantum computing. Build new experiments that create and exploit quantum states of light and matter for next-generation quantum technologies.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8377": {"title": "Laborantpraktikant - DTU Nanolab", "description": "Som laborantpraktikant p\u00e5 DTU Nanolab f\u00e5r du en enest\u00e5ende mulighed for at arbejde i vores renrum og andre h\u00f8jtspecialiserede laboratorier. Du vil stifte bekendtskab med avanceret udstyr og processer der underst\u00f8tter chip fabrikation og den forskning der er forbundet med dette.  ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8378": {"title": "Postdoc in Computational Controversy Mapping and STS - DTU Management", "description": "Join DTU as a Postdoc in Computational Controversy Mapping and STS! Contribute to the development of our Observatory for Technological Questions in Society and help advance DTU\u2019s strategic focus on democratic responsibility.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8380": {"title": "PhD scholarship in Arctic fjord food webs under glacial retreat - DTU Aqua", "description": "Uncover how retreating glaciers reshape Arctic fjord food webs in Greenland. This joint PhD with GINR and DTU Aqua combines Arctic fieldwork, stable isotopes, diet studies and ecosystem modelling\u2014with the opportunity to live and work in both Nuuk and Lyngby.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8381": {"title": "Institutdirekt\u00f8r til DTU Bioengineering", "description": "Vil du st\u00e5 i spidsen for et af Europas st\u00e6rkeste forskningsmilj\u00f8er inden for bioteknologi og biomedicin?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8382": {"title": "Junior projekt- og partnerskabskoordinator indenfor den gr\u00f8nne omstilling - Afd. for Forskning, R\u00e5dgivning og Innovation", "description": "Vil du arbejde t\u00e6t p\u00e5 forskere, virksomheder og offentlige akt\u00f8rer om konkrete projekter inden for den gr\u00f8nne omstilling? Og har du lyst til at v\u00e6re med til at skabe struktur og fremdrift i samarbejder p\u00e5 tv\u00e6rs af DTU og eksterne partnere? DTU s\u00f8ger en junior projekt- og partnerskabskoordinator. Stillingen er en tidsbegr\u00e6nset ans\u00e6ttelse frem til den 31. december 2028.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8346": {"title": "Laboratory technician at DTU Metabolomics Core - DTU Bioengineering", "description": "The DTU Metabolomics Core seeks a Laboratory Technician to operate LC-MS systems and analyse microbial metabolites. Requires lab tech or chemistry degree plus HPLC experience. Based at DTU Bioengineering, supporting research in chemical ecology applications within a dynamic international team.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8356": {"title": "Projektadministratorer til projektstyring og \u00f8konomi - DTU Campus Service", "description": "Vil du v\u00e6re en del af en operationel bygherre, der med samarbejdet i fokus er med til at udvikle fremtidens b\u00e6redygtige campus?\n\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8359": {"title": "Professor in Computational Solid-State Quantum Physics - DTU Physics", "description": "We are seeking a professor in computational materials physics with strong competences in quantum materials and ambitions to contribute to discovering new materials and methods, and to educating excellent engineers and researchers.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8361": {"title": "Professor of Global Value Chains for Green Technologies - DTU Wind", "description": "Are you looking to fulfill your dreams and ambitions for excellent research, while being embedded in a collaborative and social environment? Then this position is right for you!", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8362": {"title": "DTU Tenure Track Assistant Professor or Associate Professor in Digital Transformation and Sustainable Project Delivery - DTU Engineering Technology", "description": "Are you passionate about transforming how we plan, deliver, and evaluate construction projects in a rapidly changing world? At DTU Engineering Technology, we study how emerging technologies, innovative project practices, and sustainability principles can accelerate the green transition of the built environment.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8366": {"title": "BMS-tekniker - DTU Campus Service", "description": "Vil du v\u00e6re med til at udvikle og drive bygninger, der underst\u00f8tter forskning, uddannelse og innovation i verdensklasse? Som BMS-tekniker p\u00e5 DTU f\u00e5r du en central rolle i arbejdet med bygningsautomation, energistyring og tekniske l\u00f8sninger p\u00e5 et af Danmarks mest sp\u00e6ndende campusomr\u00e5der.\n\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8364": {"title": "Full Professor (chair) in Climate and Environmental Economics - DTU Management", "description": "Join DTU Management as Professor in Climate Economics and strengthen interdisciplinary research on climate impacts, risks, resilience, adaptation, mitigation, well-being, equity, and evidence-based climate policy.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8368": {"title": "PhD scholarship in Coastal Engineering (Wave-Vegetation Interaction) - DTU Construct", "description": "This project will develop new theoretical and numerical models for wave-driven flows over coastal vegetation. The PhD combines fluid mechanics, CFD and nature-based coastal engineering to study wave-induced hydrodynamics and modification to the shallow-water momentum balance in vegetated coastal zones.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8370": {"title": "Student Assistant - DTU Food", "description": "The Research Group for Global Capacity Building (GCB) at DTU National Food Institute is looking for a part-time student assistant to support project management, communications, and training for the Global Pathogen Analysis Platform (GPAP) project Apply now.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8369": {"title": "Postdoc in Two-Phase Turbomachinery for Advanced Organic Rankine Cycle Systems - DTU Construct", "description": "Join DTU Construct as a Postdoc in advanced two-phase turbomachinery for next-generation organic Rankine cycle systems. You will develop numerical models, design a novel two-phase turbine, and lead the design of a dedicated experimental test rig within the international EMPOWER project.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8371": {"title": "Professor in Sustainable Food Processing - DTU Food", "description": "Are you an expert within food production engineering with a keen interest in sustainability? Then perhaps you are our new professor. The Technical University of Denmark (DTU) invites applications for a position as Professor in Sustainable Food Processing and Head of the Research Group for Food Production Engineering. The position is affiliated to the National Food Institute at DTU.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8372": {"title": "Professor in Statistics - DTU Compute", "description": "DTU Compute at the Technical University of Denmark (DTU) invites applications for a professor position in Statistics. We are seeking a highly qualified individual to strengthen our research profile in biostatistics and human health and to contribute to addressing important societal challenges through research, education, and academic leadership.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8353": {"title": "PhD scholarship in Moir\u00e9 and Patterned 2D Materials for Bandgap Engineering - DTU Physics", "description": "Want to design a material's electronic properties, not just measure them? Join DTU Physics for a PhD engineering bandgaps in moir\u00e9 and patterned 2D materials. Ideal for someone who enjoys the cleanroom, pushing the frontiers of materials science and low-temperature transport measurements.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8347": {"title": "PhD scholarship in theoretical chemistry, \u201cTowards quantum-enhanced computational algorithms for discovering sustainable energy materials\u201d - DTU Chemistry", "description": "Three-year full-time PhD scholarship on the development of computationally efficient yet accurate quantum-enhanced algorithms for predicting electronic excited-state properties. The project aims to characterize and screen organic molecules for energy applications and ultimately accelerate the discovery of high-performance, sustainable materials.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8351": {"title": "Project Manager - Development of Wastewater Treatment and Resource Recovery Technologies - DTU Sustain", "description": "DTU Sustain is seeking a Project Manager to support the development of advanced wastewater treatment technologies, resource recovery, and residual-stream valorization from industrial and bio-based wastewater streams.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8355": {"title": "PhD scholarship in Reality Capture for Digital Twinning of Built Structures - DTU Compute", "description": "Use generative AI to create digital 3D models of buildings and the built environment. The aim of this PhD project is to study how recent advances in machine learning can help us create precise building information models.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8357": {"title": "Postdoc in AI-driven design of environment-responsive antibodies and nanobodies - DTU Bioengineering", "description": "Postdoc position in AI-driven design of environment-responsive antibodies and nanobodies at the Antibody Technologies Group, DTU Bioengineering. \nJoin an interdisciplinary team using deep learning and generative models to design proteins that control biological function with high precision.\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8354": {"title": "Postdoc in Entangled Plasmon Spectroscopy - DTU Physics", "description": "Join us at DTU physics, develop the theory of entangled plasmon spectroscopy, and advance quantum technologies. Background in quantum optics, spectroscopy, theoretical chemistry or condensed matter, and strong coding skills required.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8471": {"title": "Laboratory technician for fermentation and microbial biotechnology - DTU Bioengineering", "description": "We offer a position as Laboratory technician within microbial cultivation, microbiology and processes related to microbial precision fermentation. You will be an active participant in projects for both in house researchers and external clients, and support the practical teaching of courses offered by the Fermentation core. Join a dynamic environment with a major goal of implementing and developing methods, and even high-throughput methodologies for speeding up the development of superior microbial cell factories.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8474": {"title": "Work Environment Data & Systems Lead - DTU Campus Service", "description": "Vil du v\u00e6re med til at skabe et sikkert og sundt arbejdsmilj\u00f8 p\u00e5 DTU? DTU s\u00f8ger en analytisk og systemst\u00e6rk Work Environment Data & Systems Lead, der kan oms\u00e6tte data, processer og digitale l\u00f8sninger til v\u00e6rdi for arbejdsmilj\u00f8et. Du bliver en central drivkraft i drift og udvikling af APV, ulykkesh\u00e5ndtering, ledelsesrap-portering og arbejdsmilj\u00f8systemer p\u00e5 tv\u00e6rs af en kompleks organisation. Sammen med et engageret team f\u00e5r du stor indflydelse p\u00e5, hvordan DTU underst\u00f8tter et sikkert og sundt arbejdsmilj\u00f8.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8460": {"title": "Postdoc in Creative Electrosynthesis Reactions - DTU Physics", "description": "Postdoc position at the SurfCat section of DTU Physics in electrosynthesis reactions", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8464": {"title": "Project Manager in the Climate and Energy Policy Division - DTU Management", "description": "We are looking for a skilled and experienced project manager who will help manage a number of research projects within energy systems analyses in the Climate and Energy Policy Division. The activities include organisation of project meetings, reporting on projects, support of dissemination activities, and help preparing research publication and presentations.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8458": {"title": "PhD scholarship - New-Generation Control of Hybrid Wind, Solar and Battery Power Plants - DTU Wind", "description": "Shape the future of hybrid renewable power plants.\nJoin the Renewable Power Plants (RPP) section at DTU Wind and Energy Systems and help shape the next generation of control systems for hybrid wind, solar, and battery power plants. This position is ideal for candidates with a strong interest in power systems and renewable energy integration, who are motivated by developing technical, practical solutions to complex real-world challenges and thrive in a highly international and collaborative research environment.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8459": {"title": "DTU Tenure Track Researcher in Advanced Turbomachinery - DTU Construct", "description": "DTU Construct's Section of Thermal Energy invites applications for a Tenure Track Researcher in Advanced Turbomachinery. The successful candidate will help develop next-generation turbomachinery, thermal-fluid modelling, and sustainable energy technologies for the green transition.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8461": {"title": "Bliv laborantpraktikant p\u00e5 DTU Kemi", "description": "Har du lyst til at blive uddannet laborant p\u00e5 DTU Kemi? DTU Kemi varetager undervisning og forskning inden for alle kemiens hovedomr\u00e5der. Instituttet bidrager aktivt til den internationale kemiske grundforskning, hvor sigtet er at videreudvikle kemiens metoder og begreber, og at forklare og afd\u00e6kke sammenh\u00e6nge. Kemisk forskning g\u00e5r ofte p\u00e5 tv\u00e6rs af de traditionelle hovedomr\u00e5der og ofte med st\u00e6rke relationer til naboomr\u00e5der som f.eks. biokemien.\nForskningsgruppen: Tv\u00e6rfaglig gruppe, hvis forskning er centreret omkring studier af kolesterol i biologiske systemer, her\u00acunder design af kolesterol bindende proteiner og studier af proteiner involveret i humane sygdomme.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8466": {"title": "Industriteknikerl\u00e6rling - DTU Engineering Technology", "description": "\u00d8nsker du en afvekslende hverdag og har lyst til at arbejde p\u00e5 en arbejdsplads, som tilbyder udfordrende og sp\u00e6ndende opgaver for medarbejdere og studerende p\u00e5 Danmarks Tekniske Universitet? S\u00e5 er du m\u00e5ske DTU\u2019s kommende industriteknikerl\u00e6rling?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8468": {"title": "Myndighedschef med ansvar for forskningsbaseret r\u00e5dgivning - DTU F\u00f8devareinstituttet", "description": "Vil du st\u00e5 i spidsen for et af Danmarks st\u00e6rkeste milj\u00f8er inden for forskningsbaseret myndighedsr\u00e5dgivning og v\u00e6re med til at oms\u00e6tte forskningsbaseret viden til beslutningsgrundlag for myndigheder i Danmark og EU?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8467": {"title": "Postdoc in Critical Raw Material Recovery from High-Salinity Brines \u2013 DTU Offshore", "description": "Are you interested in contributing to the green transition through the recovery of critical raw materials from industrial and energy-related water streams? At DTU Offshore, you will have the opportunity to work on scientific and engineering challenges related to resource recovery, water treatment and sustainable process technologies.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8448": {"title": "Postdoc in Dark-field X-Ray Microscopy of Dislocation Structures - DTU Physics", "description": "We are seeking an experimental physicist to study dislocation structures during plastic deformation of metals using dark-field X-ray microscopy and to develop methods for quantitative characterisation of three-dimensional microstructures.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8451": {"title": "Administrativ koordinator til sekretariats- og serviceopgaver - Afd. for \u00d8konomi og Regnskab", "description": "Vil du have en varieret hverdag med administration, koordinering og praktisk service? Vi s\u00f8ger en kollega til Sekretariatet i afdelingen for \u00d8konomi og Regnskab, som er fleksibel, tager ansvar for opgaverne og bidrager til, at hverdagen fungerer godt.\n\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8450": {"title": "PhD scholarship in Soft Robotic Applications - DTU Electro", "description": "Join DTU Electro as a PhD Student developing soft and adaptive robotic systems. Work on variable-stiffness mechanisms, mechatronic design, modelling, and advanced control, combining innovative research with experimental validation on real robotic platforms.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8454": {"title": "Postdoc in Data-Driven Design of Chalcogenide Thin Films for Advanced Photovoltaics - DTU Electro", "description": "Are you an ambitious researcher looking to advance your career at the forefront of sustainable solar energy technologies? At DTU Electro, you will have the opportunity to break new ground by combining thin-film synthesis with artificial intelligence to accelerate the development of next-generation solar cells for indoor and tandem applications.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8453": {"title": "PhD scholarship in the use of SWOT for small-scale ocean processes - DTU Space", "description": "This PhD will focus on assimilating SWOT satellite observations into a high-resolution ocean model with a focus on the Polar Regions.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8452": {"title": "Postdoc in electronic oxide-based quantum devices - DTU Energy", "description": "2-year post doc position in fabrication and low-temperature characterization of oxide-based electronic quantum devices.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8456": {"title": "PhD scholarship in Catalytic CO\u2082 Conversion to Carbon Nanotubes - DTU Physics", "description": "The position is at the SurfCat section at the Department of Physics at the Technical University of Denmark. Here we enjoy a social, open and transparent scientific environment.\n", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8442": {"title": "PhD scholarship in fungal genomics and predictive modelling - DTU Food", "description": "DTU National Food Institute are seeking a PhD-candidate in fungal genomics with a focus on correlating genomes to phenotypes and developing webservices. This will include whole genome sequencing of fungi, culturing and phenotypic characterization and implementing tools in our widely used online webservice.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8444": {"title": "Laborant til forskning inden for allergi - DTU F\u00f8devareinstituttet", "description": "Forskningsgruppen for F\u00f8devareallergi p\u00e5 F\u00f8devareinstituttet p\u00e5 DTU s\u00f8ger en dygtig laborant med erfaring inden for fors\u00f8gsdyr til forskning inden for allergi.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8443": {"title": "Postdoc in Diet\u2013Microbiome Interactions and Food Metagenome Mining - BRIGHT", "description": "Join BRIGHT at DTU to uncover the hidden dietary layer in thousands of gut metagenomes, link foods to microbial taxa, pathways and MAGs, and test the most promising food\u2013microbe interactions in the lab.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8445": {"title": "PhD scholarship (Marie Sk\u0142odowska-Curie) in Molecular Biology and Bioreceptor Engineering for Biosensors - BRIGHT", "description": "Join the EU-funded BUG-ID project at BRIGHT as a PhD student developing biological receptors for infection diagnostics. Apply molecular biology and aptamer selection (SELEX) to develop recognition molecules for graphene-based biosensors in an international research network.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8447": {"title": "PhD scholarship in Atomistic Stabilization in Solid Oxide Electrolysis Cells - DTU Physics", "description": "Are you passionate about using atomistic simulations and machine learning to accelerate the green transition? Do you want to understand, atom by atom, why electrolysers degrade, and design materials that make them last longer? Do you have a background in computational chemistry, physics, materials science or chemical engineering?", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8446": {"title": "Chefkonsulent med ansvar for efter- og videreuddannelse (deltid) \u2013 DTU Construct", "description": "I samarbejde med studielederne for DTU Constructs masteruddannelser f\u00e5r du som chefkonsulent en central rolle med ansvar for den forretningsm\u00e6ssige drift og den fortsatte udvikling af instituttets efter- og videreuddannelsestilbud. Stillingen er p\u00e5 20 timer om ugen.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8439": {"title": "PhD scholarship in fermentation-based production of biochemicals - BRIGHT", "description": "This multi-year initiative consists of joint efforts between multiple groups covering the entire innovation pipeline, from metabolic tools and design, strain engineering, process design, fermentation, downstream processing, multi-omics, techno-economic validation, and business development. We aim to establish new industrial routes for essential chemicals in a low-carbon economy through interdisciplinary collaboration.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8440": {"title": "PhD scholarship in Theoretical Metamaterial Acoustofluidics - DTU Physics", "description": "The PhD scholarship in theoretical metamaterial acoustofluidics involves modeling and weak-form FEM simulation of acoustofluidic devices with metamaterial walls. The aim is to lower friction by optimal design of metamaterial walls and thus enable handling of nanoparticles in an embedded micrchannel.", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8441": {"title": "STADS-ansvarlig med blik for sammenh\u00e6ng, udvikling og governance - Afd. for Uddannelse og Studerende", "description": "Vil du v\u00e6re med til at udvikle og forvalte det digitale fundament under DTU's studieadministration? P\u00e5 DTU er vi i gang med at videreudvikle m\u00e5den, vi arbejder med systemforvaltning, digital underst\u00f8ttelse og sammenh\u00e6ngen mellem processer, data og systemer p\u00e5 uddannelsesomr\u00e5det. ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8434": {"title": "Studentermedhj\u00e6lper til projektet Copyright Nature - DTU Construct", "description": "Vil du v\u00e6re vores nye studentermedhj\u00e6lper p\u00e5 det nystartede 3-\u00e5rige projekt Copyright Nature? Ved hj\u00e6lp af bionik vil vi udvikle et nyt undervisningsmateriale til gymnasiet (STX og HTX) med fokus p\u00e5 den tv\u00e6rfaglige undervisning i de 2 st\u00f8rre projektopgaver i 2. og 3.g.  ", "department": null}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8433": {"title": "Postdoc in Hydrological Extremes Across Scales, Hazards and Impacts for Resilient Water and Infrastructure Systems - DTU Sustain", "description": "Are you ready to continue your scientific career by addressing the urgent need for climate resilient and adaptive infrastructure solutions?  We are looking for a talented and motivated postdoc to help develop methods for risk-based design of resilient water systems and civil infrastructure.", "department": null}}, "rows": {"https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8078": {"school_id": 1669, "posting_url": "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8078", "job_title_in_post": "Postdoc in Probabilistic Methods Sequential Decision-Making - DTU Compute", "position_type": "Research_Fellow", "job_term": "Full-time", "department_or_school": "", "area_key_words": "Probabilistic Methods Sequential Decision-Making", "deadline_of_application": "", "position_start_date": ""}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8024": {"school_id": 1669, "posting_url": "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8024", "job_title_in_post": "PhD in gas photonics - DTU Electro", "position_type": "Unclassified", "job_term": "Full-time", "department_or_school": "", "area_key_words": "ultrafast nonlinear optics using gas-filled", "deadline_of_application": "", "posted_date": "", "position_start_date": ""}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7995": {"school_id": 1669, "posting_url": "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7995", "job_title_in_post": "Postdoc in gas photonics - DTU Electro", "position_type": "Research_Fellow", "job_term": "Full-time", "department_or_school": "", "area_key_words": "ultrafast nonlinear optics using gas-filled", "deadline_of_application": "", "position_start_date": ""}, "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7991": {"school_id": 1669, "posting_url": "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/7991", "job_title_in_post": "Postdoc in software systems integration, modeling, and simulation for sustainable datacenter fleets - DTU Compute", "position_type": "Research_Fellow", 