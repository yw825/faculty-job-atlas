    "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8593": {
      "title": "Postdoc in crystal plasticity simulations of microstructural evolution - DTU Construct",
      "description": "We are seeking a modeller to predict the evolution of grain orientations and mechanical fields during plastic deformation of metals. We have first-of-its kind experimental data to inspire and validate modelling procedures and predictions.",
      "department": null
    },
    "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8594": {
      "title": "PhD scholarship in generative molecular dynamics modelling of ion transport in designed proteins and peptides - BRIGHT",
      "description": "This PhD project is part of a BRIGHT programme developing a general platform for the design of protein- and peptide-based biomaterials, with solid-state battery components as its first testbed. Our goal is to replace fluorinated PFAS polymers with de novo designed proteins and peptides.",
