    "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8597": {
      "title": "Postdoc in microbial production of self-assembling protein materials - BRIGHT",
      "description": "Join BRIGHT as a postdoc developing microbial production of self-assembling protein materials. You will combine genetic engineering, recombinant protein production, purification, fermentation and assembly studies in E. coli and Bacillus subtilis.",
      "department": null
    },
    "https://efzu.fa.em2.oraclecloud.com/hcmUI/CandidateExperience/en/sites/CX_2001/job/8596": {
