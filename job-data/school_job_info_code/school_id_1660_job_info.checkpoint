st": "Project staff member (Teaching and Research Assistant)", "position_type": "Non-academic", "job_term": "Part-time", "department_or_school": "Institute for Sociology and Social Research", "area_key_words": "contemporary economic; societal processes", "deadline_of_application": "October 28, 2026", "position_start_date": ""}, "https://jobs.wu.ac.at/Project-staff-member-pre-doc-eng-j2928.html": {"school_id": 1660, "posting_url": "https://jobs.wu.ac.at/Project-staff-member-pre-doc-eng-j2928.html", "job_title_in_post": "Job opportunity Project staff member (pre-doc)", "position_type": "Unclassified", "job_term": "Part-time", "department_or_school": "Institute for Data, Energy, and Sustainability", "area_key_words": "", "deadline_of_application": "November 11, 2026", "position_start_date": ""}, "https://jobs.wu.ac.at/Research-and-Teaching-Associate-eng-j2924.html": {"school_id": 1660, "posting_url": "https://jobs.wu.ac.at/Research-and-Teaching-Associate-eng-j2924.html", "job_title_in_post": "Research and Teaching Associate", "position_type": "Research_Fellow", "job_term": "Part-time", "department_or_school": "", "area_key_words": "customer analytics together; truly international; Associate Vienna University of Economics", "deadline_of_application": "October 28, 2026", "position_start_date": ""}, "https://jobs.wu.ac.at/Research-and-Teaching-Associate-eng-j2932.html": {"school_id": 1660, "posting_url": "https://jobs.wu.ac.at/Research-and-Teaching-Associate-eng-j2932.html", "job_title_in_post": "Research and Teaching Associate", "position_type": "Unclassified", "job_term": "Part-time", "department_or_school": "Department of Socioeconomics", "area_key_words": "Associate position", "deadline_of_application": "November 04, 2026", "position_start_date": ""}}, "school_id": 1660, "status": "complete", "updated_at": "2026-10-16T19:04:28+00:00", "completed_at": "2026-10-16T19:04:28+00:00", "last_error": ""}